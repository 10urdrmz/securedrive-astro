{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "securedrive-astro",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "securedrive",
			"database_id": "31c4ea55-ac34-41a9-8c2d-3d9b78b9ebb1",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "securedrive-media",
		},
	],
	// Live chat: one room per booking (src/chat-room.ts).
	"durable_objects": {
		"bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }],
	},
	"migrations": [{ "tag": "chat-v1", "new_sqlite_classes": ["ChatRoom"] }],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
