# Copy to .env for local development. On Cloudflare set these with
# `npx wrangler secret put <NAME>` (or as plain vars in wrangler.jsonc).

# Encrypts secrets EmDash stores in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMDASH_ENCRYPTION_KEY=

# Where new transfer / contact / corporate requests are emailed (optional).
INQUIRY_NOTIFY_EMAIL=operasyon@securedrive.org

# First super admin at /ops/kurulum (remove after setup if you like).
SD_SETUP_TOKEN=

# Online card payment (iyzico Checkout Form). Leave empty to hide the option.
# IYZICO_BASE_URL defaults to the sandbox; production is https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
