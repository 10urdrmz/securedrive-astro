---
import { Font } from "astro:assets";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactDock from "../components/ContactDock.astro";
import { LOCALES, LOCALE_META, DEFAULT_LOCALE, localizePath, type Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { SITE } from "../lib/site";
import "../styles/tailwind.css";

interface Props {
	locale: Locale;
	/** Site path without the language prefix, e.g. "filo/mercedes-vito-vip". */
	path: string;
	title?: string;
	description?: string;
	image?: string | null;
	noindex?: boolean;
	/** Set when the page renders an EmDash entry, so its SEO panel and hreflang apply. */
	content?: { collection: string; id: string; slug?: string | null };
	jsonLd?: Record<string, unknown>[];
	/** Hide the home-page style transparent header. */
	overlayHeader?: boolean;
}

const { locale, path, title, description, image, noindex, content, jsonLd = [], overlayHeader = false } = Astro.props;
const t = useTranslations(locale);
const meta = LOCALE_META[locale];

const siteName = t("meta.siteName");
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} | ${t("meta.defaultTitle")}`;
const pageUrl = new URL(localizePath(locale, path), SITE.url).href;
const ogImage = new URL(image || SITE.ogImage, SITE.url).href;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteName,
	description: description || t("meta.defaultDescription"),
	canonical: pageUrl,
	image: ogImage,
	content,
	seo: { ogImage, robots: noindex ? "noindex, follow" : null },
	siteName,
	siteUrl: SITE.url,
});

// Hand-built pages exist in every language at the same path; content entries
// get their hreflang links from EmDash, which only lists real translations.
const alternates = content ? [] : LOCALES.map((l) => ({ hreflang: l, href: new URL(localizePath(l, path), SITE.url).href }));
---

<!doctype html>
<html lang={locale} dir={meta.dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{fullTitle}</title>
		<script is:inline>document.documentElement.classList.add("js");</script>
		<EmDashHead page={pageCtx} />
		{
			alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)
		}
		{!content && <link rel="alternate" hreflang="x-default" href={new URL(localizePath(DEFAULT_LOCALE, path), SITE.url).href} />}
		<meta property="og:locale" content={meta.og} />
		<meta name="theme-color" content="#111316" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-heading" preload />
		{locale === "ar" && <Font cssVariable="--font-arabic" preload />}
		{
			jsonLd.map((data) => (
				<script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
			))
		}
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">{t("nav.skip")}</a>
		<Header locale={locale} path={path} overlay={overlayHeader} />
		<main id="main">
			<slot />
		</main>
		<Footer locale={locale} />
		<ContactDock locale={locale} />
		<EmDashBodyEnd page={pageCtx} />

		<script>
			// Fade sections in as they scroll into view.
			const items = document.querySelectorAll(".reveal");
			if ("IntersectionObserver" in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								io.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: "0px 0px -8% 0px" },
				);
				items.forEach((el) => io.observe(el));
			} else {
				items.forEach((el) => el.classList.add("is-visible"));
			}
		</script>
	</body>
</html>
