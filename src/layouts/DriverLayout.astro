---
/**
 * Shell for the driver app (/surucu): phone-first, large touch targets, installable
 * to the home screen. Server-rendered, no framework JS. Never indexed, never cached.
 */
import type { Driver } from "../server/driver-app";

interface Props {
	title: string;
	driver?: Driver | null;
	/** Show a back link to the job list. */
	back?: boolean;
	/** Reload the page every n seconds (job list), so new jobs show up. */
	refresh?: number;
}

const { title, driver, back = false, refresh } = Astro.props;

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "same-origin");
// EmDash denies geolocation on every page unless the page says otherwise; the driver
// app needs it to share the car's position during a trip.
Astro.response.headers.set("Permissions-Policy", "camera=(), microphone=(), geolocation=(self), payment=()");
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#0a2540" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="SD Sürücü" />
		{refresh && <meta http-equiv="refresh" content={String(refresh)} />}
		<title>{title} · SecureDrive Sürücü</title>
		<link rel="manifest" href="/surucu.webmanifest" />
		<link rel="icon" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	</head>
	<body class="drv">
		<header class="drv-top">
			{
				back ? (
					<a class="drv-back" href="/surucu" aria-label="İşlerim">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m15 18-6-6 6-6" />
						</svg>
						İşlerim
					</a>
				) : (
					<span class="drv-brand">
						SecureDrive <span>Sürücü</span>
					</span>
				)
			}
			{
				driver && (
					<form method="post" action="/surucu/cikis">
						<button type="submit" class="drv-out">
							Çıkış
						</button>
					</form>
				)
			}
		</header>
		<main class="drv-main">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--drv-navy: #0a2540;
		--drv-blue: #144c7f;
		--drv-ink: #101828;
		--drv-muted: #5b6470;
		--drv-line: #e4e7ec;
		--drv-bg: #f2f4f7;
	}
	body.drv {
		margin: 0;
		background: var(--drv-bg);
		color: var(--drv-ink);
		font:
			16px/1.45 system-ui,
			-apple-system,
			"Segoe UI",
			Roboto,
			sans-serif;
		-webkit-text-size-adjust: 100%;
	}
	.drv-top {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 56px;
		padding: env(safe-area-inset-top) 16px 0;
		background: var(--drv-navy);
		color: #fff;
	}
	.drv-brand {
		font-weight: 700;
	}
	.drv-brand span {
		color: #dcc49a;
		font-weight: 500;
	}
	.drv-back {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: #fff;
		font-weight: 600;
		text-decoration: none;
		margin-left: -6px;
	}
	.drv-top form {
		margin: 0;
	}
	.drv-out {
		background: none;
		border: 1px solid rgb(255 255 255 / 0.35);
		color: #fff;
		border-radius: 999px;
		padding: 6px 14px;
		font: inherit;
		font-size: 14px;
	}
	.drv-main {
		max-width: 640px;
		margin: 0 auto;
		padding: 16px 16px calc(32px + env(safe-area-inset-bottom));
	}
	.drv-main h1 {
		font-size: 22px;
		margin: 4px 0 14px;
	}
	.drv-main h2 {
		font-size: 15px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--drv-muted);
		margin: 24px 0 10px;
	}
	.drv-card {
		display: block;
		background: #fff;
		border: 1px solid var(--drv-line);
		border-radius: 14px;
		padding: 16px;
		margin-bottom: 12px;
		color: inherit;
		text-decoration: none;
		box-shadow: 0 1px 2px rgb(16 24 40 / 0.05);
	}
	.drv-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		min-height: 54px;
		padding: 0 18px;
		border: 0;
		border-radius: 12px;
		background: var(--drv-blue);
		color: #fff;
		font: inherit;
		font-size: 17px;
		font-weight: 700;
		text-decoration: none;
		cursor: pointer;
		box-sizing: border-box;
	}
	.drv-btn.green {
		background: #079455;
	}
	.drv-btn.ghost {
		background: #fff;
		color: var(--drv-ink);
		border: 1px solid #d0d5dd;
	}
	.drv-btn.danger {
		background: #fff;
		color: #b42318;
		border: 1px solid #fda29b;
	}
	.drv-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 3px 10px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 600;
		background: #f2f4f7;
		color: #344054;
	}
	.drv-pill.warn {
		background: #fffaeb;
		color: #b54708;
	}
	.drv-pill.info {
		background: #eff8ff;
		color: #175cd3;
	}
	.drv-pill.ok {
		background: #ecfdf3;
		color: #067647;
	}
	.drv-pill.off {
		background: #fef3f2;
		color: #b42318;
	}
	.drv-muted {
		color: var(--drv-muted);
	}
	.drv-notice {
		padding: 12px 14px;
		border-radius: 12px;
		margin-bottom: 14px;
		font-weight: 500;
		background: #ecfdf3;
		color: #05603a;
		border: 1px solid #abefc6;
	}
	.drv-notice.error {
		background: #fef3f2;
		color: #b42318;
		border-color: #fecdca;
	}
	.drv-field {
		display: grid;
		gap: 6px;
		margin-bottom: 14px;
		font-weight: 600;
		font-size: 15px;
	}
	.drv-field input {
		font: inherit;
		font-size: 18px;
		font-weight: 500;
		padding: 14px;
		border: 1px solid #d0d5dd;
		border-radius: 12px;
		background: #fff;
	}
</style>
