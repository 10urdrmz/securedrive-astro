---
/**
 * Shell for the internal operations panel (/ops). Server-rendered, no framework JS;
 * one small script polls /ops/bildirim.json to keep the menu counts and the bell
 * current and to announce new requests and bookings. Never indexed, never cached.
 */
import type { SessionUser } from "../server/auth/rbac";
import { can, ROLE_LABELS } from "../server/auth/rbac";
import { getDb } from "../server/db";
import { opsCounts, opsFeed, type OpsCounts, type OpsFeedItem } from "../server/ops-alerts";
import Icon from "../components/Icon.astro";
import "../styles/tailwind.css";

interface Props {
	title: string;
	user?: SessionUser | null;
	/** Current path, to highlight the menu entry. */
	active?: string;
	/** The same shell serves partner fleets (/partner) with their own menu. */
	panel?: "ops" | "partner";
}

const { title, user, active = Astro.url.pathname, panel = "ops" } = Astro.props;
const partner = panel === "partner";

const watch = !!user && can(user, "bookings.read");
let counts: OpsCounts = { requests: 0, bookings: 0 };
let feed: OpsFeedItem[] = [];
if (user && watch) {
	const db = await getDb(Astro.locals);
	[counts, feed] = await Promise.all([opsCounts(db, user), opsFeed(db, user)]);
}
const ago = (iso: string) => {
	const minutes = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60_000));
	if (minutes < 1) return "şimdi";
	if (minutes < 60) return `${minutes} dk önce`;
	if (minutes < 24 * 60) return `${Math.floor(minutes / 60)} sa önce`;
	return `${Math.floor(minutes / 1440)} gün önce`;
};

type IconName = Parameters<typeof Icon>[0]["name"];
type NavItem = { href: string; label: string; icon: IconName; show: boolean; count?: keyof OpsCounts; hint?: string };
const NAV_ALL: NavItem[] = !user
	? []
	: partner
		? [
				{ href: "/partner", label: "İşler", icon: "calendar", show: true },
				{ href: "/partner/suruculer", label: "Sürücüler", icon: "user", show: true },
				{ href: "/partner/finans", label: "Hakediş", icon: "wallet", show: true },
			]
		: [
			{ href: "/ops", label: "Pano", icon: "dashboard", show: true },
			{ href: "/ops/rezervasyonlar", label: "Rezervasyonlar", icon: "calendar", show: can(user, "bookings.read"), count: "bookings" as const, hint: "sürücü bekleyen" },
			{ href: "/ops/talepler", label: "Fiyat talepleri", icon: "inbox", show: can(user, "bookings.read"), count: "requests" as const, hint: "yeni talep" },
			{ href: "/ops/harita", label: "Canlı harita", icon: "map", show: can(user, "bookings.read") },
			{ href: "/ops/suruculer", label: "Sürücüler", icon: "user", show: can(user, "bookings.read") },
			{ href: "/ops/partnerler", label: "Partner filolar", icon: "building", show: can(user, "bookings.read") },
			{ href: "/ops/hakedis", label: "Hakediş", icon: "wallet", show: can(user, "settlements.manage") },
			{ href: "/ops/yonetim/tarifeler", label: "Tarifeler", icon: "tag", show: can(user, "catalog.read") },
			{ href: "/ops/yonetim/bolgeler", label: "Bölgeler", icon: "pin", show: can(user, "catalog.read") },
			{ href: "/ops/yonetim/araclar", label: "Araç sınıfları", icon: "car", show: can(user, "catalog.read") },
			{ href: "/ops/yonetim/ekstralar", label: "Ekstralar", icon: "gift", show: can(user, "catalog.read") },
			{ href: "/ops/yonetim/ayarlar", label: "Kurallar", icon: "sliders", show: can(user, "catalog.read") },
			{ href: "/ops/yonetim/kullanicilar", label: "Ekip", icon: "users", show: can(user, "users.manage") },
			{ href: "/ops/yonetim/denetim", label: "Denetim kaydı", icon: "file", show: can(user, "audit.read") },
			];
const NAV = NAV_ALL.filter((item) => item.show);

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "same-origin");
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} · SecureDrive {partner ? "Partner" : "Operasyon"}</title>
		<link rel="icon" href="/favicon.svg" />
	</head>
	<body class="ops">
		<header class="ops-top">
			<a class="ops-brand" href={partner ? "/partner" : "/ops"}>SecureDrive <span>{partner ? "Partner" : "Operasyon"}</span></a>
			{
				user && (
					<div class="ops-user">
						{watch && (
							<details class="ops-bell" data-ops-bell>
								<summary aria-label="Bildirimler">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M10.27 21a2 2 0 0 0 3.46 0" />
										<path d="M3.26 15.33A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.67C19.41 13.96 18 12.5 18 8A6 6 0 0 0 6 8c0 4.5-1.41 5.96-2.74 7.33" />
									</svg>
									<span class="ops-count" data-ops-total hidden={counts.requests + counts.bookings === 0}>
										{counts.requests + counts.bookings}
									</span>
								</summary>
								<div class="ops-bell-panel">
									<div class="ops-bell-head">
										<strong>Bildirimler</strong>
										<button type="button" class="ops-link" data-ops-enable hidden>Masaüstü bildirimlerini aç</button>
									</div>
									<ul data-ops-feed>
										{feed.map((item) => (
											<li data-key={item.key} data-at={item.at}>
												<a href={item.href}>
													<span class:list={["ops-dot", item.kind]} aria-hidden="true" />
													<span class="ops-feed-text">
														<strong>{item.title}</strong>
														<span>{item.detail}</span>
													</span>
													<time datetime={item.at}>{ago(item.at)}</time>
												</a>
											</li>
										))}
										{feed.length === 0 && <li class="ops-empty">Henüz bildirim yok.</li>}
									</ul>
								</div>
							</details>
						)}
						<span>
							{user.name} · {user.roles.map((r) => ROLE_LABELS[r] ?? r).join(", ")}
						</span>
						<form method="post" action={partner ? "/partner/cikis" : "/ops/cikis"}>
							<button type="submit" class="ops-link">Çıkış</button>
						</form>
					</div>
				)
			}
		</header>
		<div class:list={["ops-shell", NAV.length === 0 && "no-nav"]}>
			{
				NAV.length > 0 && (
					<nav class="ops-nav" aria-label={partner ? "Partner menüsü" : "Operasyon menüsü"}>
						{NAV.map((item) => (
							<a href={item.href} aria-current={active === item.href || (item.href !== "/ops" && item.href !== "/partner" && active.startsWith(`${item.href}/`)) ? "page" : undefined}>
								<Icon name={item.icon} size={18} class="ops-nav-icon" />
								<span>{item.label}</span>
								{item.count && (
									<span class="ops-count" data-ops-count={item.count} title={item.hint} hidden={counts[item.count] === 0}>
										{counts[item.count]}
									</span>
								)}
							</a>
						))}
					</nav>
				)
			}
			<main class="ops-main">
				<h1>{title}</h1>
				<slot />
			</main>
		</div>
		{watch && <div class="ops-toasts" data-ops-toasts aria-live="polite" />}
		{watch && <script src="/ops-alerts.js" defer is:inline />}
	</body>
</html>

<style is:global>
	@layer legacy {
	body.ops {
		margin: 0;
		background: var(--gray-100);
		color: var(--ink-900);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-size: 15px;
	}
	.ops-top {
		position: relative;
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 20px;
		background: var(--navy-900);
		color: #fff;
	}
	.ops-brand {
		color: #fff;
		font-weight: 700;
		text-decoration: none;
	}
	.ops-brand span {
		color: var(--gold-300);
		font-weight: 500;
	}
	.ops-user {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 14px;
	}
	.ops-user > span {
		opacity: 0.9;
	}
	.ops-user form {
		margin: 0;
	}
	.ops-link {
		background: none;
		border: 0;
		color: var(--gold-300);
		cursor: pointer;
		font: inherit;
		padding: 0;
		text-decoration: underline;
	}
	.ops-shell {
		display: grid;
		grid-template-columns: 200px 1fr;
		min-height: calc(100vh - 48px);
	}
	/* Signed out (login, setup): no menu, so the page gets the whole width. */
	.ops-shell.no-nav {
		grid-template-columns: 1fr;
	}
	.ops-shell.no-nav .ops-main h1 {
		max-width: 380px;
		margin: 40px auto 16px;
	}
	.ops-shell.no-nav .auth-card {
		margin-top: 0;
	}
	.ops-nav {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 16px 8px;
		background: #fff;
		border-right: 1px solid var(--gray-200);
	}
	.ops-nav a {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 9px 12px;
		border-radius: 10px;
		color: var(--gray-600);
		font-weight: 500;
		text-decoration: none;
		transition:
			background 0.15s,
			color 0.15s;
	}
	.ops-nav a > span:first-of-type {
		flex: 1;
	}
	.ops-nav-icon {
		flex-shrink: 0;
		color: var(--gray-500);
	}
	.ops-nav a:hover {
		background: var(--gray-100);
		color: var(--ink-900);
	}
	.ops-nav a[aria-current="page"] {
		background: var(--navy-50);
		color: var(--navy-800);
		font-weight: 600;
		box-shadow: inset 3px 0 0 var(--navy-700);
	}
	.ops-nav a[aria-current="page"] .ops-nav-icon {
		color: var(--navy-700);
	}
	.ops-main {
		padding: 24px 28px 48px;
		min-width: 0;
	}
	.ops-main h1 {
		margin: 0 0 20px;
		font-size: 24px;
	}
	.ops-main h2 {
		margin: 28px 0 12px;
		font-size: 18px;
	}
	@media (max-width: 760px) {
		.ops-shell {
			grid-template-columns: 1fr;
		}
		.ops-nav {
			flex-direction: row;
			overflow-x: auto;
			padding: 8px;
			border-right: 0;
			border-bottom: 1px solid var(--gray-200);
			scrollbar-width: none;
		}
		.ops-nav a {
			flex-shrink: 0;
			white-space: nowrap;
		}
		.ops-nav a[aria-current="page"] {
			box-shadow: inset 0 -3px 0 var(--navy-700);
		}
		.ops-main {
			padding: 16px;
		}
	}

	.card {
		background: #fff;
		border: 1px solid var(--gray-200);
		border-radius: 10px;
		padding: 20px;
		margin-bottom: 20px;
	}
	.muted {
		color: var(--gray-600);
	}
	.notice {
		padding: 10px 14px;
		border-radius: 8px;
		margin-bottom: 16px;
		background: #ecfdf3;
		color: var(--green-600);
		border: 1px solid #abefc6;
	}
	/* Waiting on someone else (a quote the customer has not answered). */
	.notice.warn {
		background: #fffaeb;
		color: #93370d;
		border-color: #fedf89;
	}
	.notice.error {
		background: #fef3f2;
		color: var(--red-600);
		border-color: #fecdca;
	}
	.table-wrap {
		overflow-x: auto;
	}
	table.data {
		width: 100%;
		border-collapse: collapse;
		background: #fff;
	}
	table.data th,
	table.data td {
		text-align: left;
		padding: 8px 10px;
		border-bottom: 1px solid var(--gray-200);
		vertical-align: middle;
	}
	table.data th {
		font-size: 13px;
		color: var(--gray-600);
		font-weight: 600;
		background: var(--gray-100);
	}
	table.data td.num,
	table.data th.num {
		text-align: right;
	}
	.ops-main label {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: 13px;
		font-weight: 600;
		color: var(--ink-800);
	}
	.ops-main label.inline {
		flex-direction: row;
		align-items: center;
		gap: 8px;
		font-weight: 500;
	}
	.ops-main input[type="text"],
	.ops-main input[type="email"],
	.ops-main input[type="password"],
	.ops-main input[type="number"],
	.ops-main input[type="time"],
	.ops-main input[type="date"],
	.ops-main select {
		font: inherit;
		font-weight: 400;
		padding: 7px 10px;
		border: 1px solid var(--gray-300);
		border-radius: 6px;
		background: #fff;
		min-width: 0;
	}
	.ops-main input.money {
		width: 110px;
		text-align: right;
	}
	.form-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 14px;
		align-items: end;
	}
	.actions {
		display: flex;
		gap: 10px;
		align-items: center;
		margin-top: 16px;
		flex-wrap: wrap;
	}
	.btn {
		font: inherit;
		font-weight: 600;
		padding: 8px 16px;
		border-radius: 6px;
		border: 1px solid var(--navy-700);
		background: var(--navy-700);
		color: #fff;
		cursor: pointer;
	}
	.btn.secondary {
		background: #fff;
		color: var(--navy-700);
	}
	.badge {
		display: inline-block;
		padding: 2px 8px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 600;
		background: var(--gray-200);
		color: var(--ink-800);
	}
	.badge.ok {
		background: #ecfdf3;
		color: var(--green-600);
	}
	.badge.off {
		background: #fef3f2;
		color: var(--red-600);
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 14px;
		margin-bottom: 20px;
	}
	.stat {
		background: #fff;
		border: 1px solid var(--gray-200);
		border-radius: 10px;
		padding: 16px;
	}
	.stat strong {
		display: block;
		font-size: 26px;
	}
	.auth-card {
		max-width: 380px;
		margin: 40px auto;
	}
	.auth-card form {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.ops-count {
		display: inline-grid;
		place-items: center;
		min-width: 20px;
		height: 20px;
		padding: 0 6px;
		border-radius: 999px;
		background: #d92d20;
		color: #fff;
		font-size: 12px;
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.ops-count[hidden] {
		display: none;
	}
	.ops-bell {
		position: relative;
	}
	.ops-bell summary {
		position: relative;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		cursor: pointer;
		list-style: none;
		color: #fff;
	}
	.ops-bell summary::-webkit-details-marker {
		display: none;
	}
	.ops-bell summary:hover,
	.ops-bell[open] summary {
		background: rgb(255 255 255 / 0.12);
	}
	.ops-bell summary .ops-count {
		position: absolute;
		top: -2px;
		right: -4px;
		box-shadow: 0 0 0 2px var(--navy-900);
	}
	.ops-bell.ring summary svg {
		animation: ops-ring 0.9s ease-in-out 2;
	}
	@keyframes ops-ring {
		0%, 100% { transform: rotate(0); }
		20% { transform: rotate(14deg); }
		40% { transform: rotate(-12deg); }
		60% { transform: rotate(8deg); }
		80% { transform: rotate(-4deg); }
	}
	.ops-bell-panel {
		position: absolute;
		right: 0;
		top: calc(100% + 8px);
		z-index: 50;
		width: min(380px, calc(100vw - 24px));
		background: #fff;
		color: var(--ink-900);
		border: 1px solid var(--gray-200);
		border-radius: 12px;
		box-shadow: 0 16px 40px -12px rgb(16 24 40 / 0.35);
		overflow: hidden;
	}
	.ops-bell-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--gray-200);
	}
	.ops-bell-head .ops-link {
		color: var(--navy-700);
		font-size: 13px;
	}
	.ops-bell ul {
		list-style: none;
		margin: 0;
		padding: 0;
		max-height: 420px;
		overflow-y: auto;
	}
	.ops-bell li a {
		display: grid;
		grid-template-columns: 10px 1fr auto;
		gap: 10px;
		align-items: start;
		padding: 12px 16px;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--gray-100);
	}
	.ops-bell li a:hover {
		background: var(--gray-100);
	}
	.ops-bell li.unread a {
		background: #eff8ff;
	}
	.ops-feed-text {
		display: grid;
		gap: 2px;
		min-width: 0;
		font-size: 13px;
	}
	.ops-feed-text span {
		color: var(--gray-600);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.ops-bell time {
		font-size: 12px;
		color: var(--gray-600);
		white-space: nowrap;
	}
	.ops-dot {
		width: 10px;
		height: 10px;
		margin-top: 4px;
		border-radius: 999px;
		background: #f79009;
	}
	.ops-dot.booking {
		background: #12b76a;
	}
	.ops-dot.declined {
		background: #f04438;
	}
	.ops-dot.message {
		background: #2e90fa;
	}
	.ops-empty {
		padding: 20px 16px;
		color: var(--gray-600);
		font-size: 14px;
	}
	.ops-toasts {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 60;
		display: grid;
		gap: 10px;
		width: min(360px, calc(100vw - 40px));
	}
	.ops-toast {
		display: grid;
		grid-template-columns: 10px 1fr;
		gap: 12px;
		padding: 14px 16px;
		background: #fff;
		color: var(--ink-900);
		border: 1px solid var(--gray-200);
		border-left: 4px solid #f79009;
		border-radius: 10px;
		box-shadow: 0 16px 40px -12px rgb(16 24 40 / 0.35);
		text-decoration: none;
		font-size: 14px;
		animation: ops-toast-in 0.25s ease-out;
	}
	.ops-toast.booking {
		border-left-color: #12b76a;
	}
	.ops-toast.declined {
		border-left-color: #f04438;
	}
	.ops-toast span {
		color: var(--gray-600);
		font-size: 13px;
	}
	@keyframes ops-toast-in {
		from { transform: translateY(12px); opacity: 0; }
	}
	}
</style>
