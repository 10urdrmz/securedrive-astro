---
/**
 * Shell for the internal operations panel (/ops). Server-rendered, no framework JS;
 * one small script polls /ops/bildirim.json to keep the menu counts and the bell
 * current and to announce new requests and bookings. Never indexed, never cached.
 */
import type { SessionUser } from "../server/auth/rbac";
import { can, ROLE_LABELS } from "../server/auth/rbac";
import { getDb } from "../server/db";
import { opsAlertState, opsCounts, opsFeed, unreadCount, type OpsCounts, type OpsFeedItem } from "../server/ops-alerts";
import Icon from "../components/Icon.astro";
import "../styles/tailwind.css";

interface Props {
	title: string;
	user?: SessionUser | null;
	/** Current path, to highlight the menu entry. */
	active?: string;
	/** The same shell serves partner fleets (/partner) and company accounts (/firma) with their own menus. */
	panel?: "ops" | "partner" | "company" | "agency";
	/** One line under the page title. Page buttons go in the "actions" slot next to it. */
	subtitle?: string;
}

const { title, user, active = Astro.url.pathname, panel = "ops", subtitle } = Astro.props;
const partner = panel === "partner";
const PANEL = {
	ops: { home: "/ops", name: "Operasyon", logout: "/ops/cikis" },
	partner: { home: "/partner", name: "Partner", logout: "/partner/cikis" },
	company: { home: "/firma", name: "Firma", logout: "/firma/cikis" },
	agency: { home: "/acente", name: "Acente", logout: "/acente/cikis" },
}[panel];

const watch = !!user && can(user, "bookings.read");
let counts: OpsCounts = { requests: 0, bookings: 0, applications: 0 };
let feed: OpsFeedItem[] = [];
let readAt = "";
let unread = 0;
if (user && watch) {
	const db = await getDb(Astro.locals);
	const state = await opsAlertState(db, user);
	[counts, feed] = await Promise.all([opsCounts(db, user), opsFeed(db, user, state)]);
	readAt = state.readAt;
	unread = unreadCount(feed, state);
}
const ago = (iso: string) => {
	const minutes = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60_000));
	if (minutes < 1) return "şimdi";
	if (minutes < 60) return `${minutes} dk önce`;
	if (minutes < 24 * 60) return `${Math.floor(minutes / 60)} sa önce`;
	return `${Math.floor(minutes / 1440)} gün önce`;
};

type IconName = Parameters<typeof Icon>[0]["name"];
type NavItem = { href: string; label: string; icon: IconName; show: boolean; count?: keyof OpsCounts; hint?: string; group?: string };
const NAV_ALL: NavItem[] = !user
	? []
	: panel === "agency"
		? [
				{ href: "/acente", label: "Pano", icon: "dashboard", show: true },
				{ href: "/acente/yeni", label: "Misafir transferi", icon: "plus", show: true },
				{ href: "/acente/rezervasyonlar", label: "Rezervasyonlar", icon: "calendar", show: true },
				{ href: "/acente/linkler", label: "Link ve widget", icon: "globe", show: true },
				{ href: "/acente/ekstre", label: "Komisyon ve ekstre", icon: "wallet", show: true },
				{ href: "/acente/ekip", label: "Ekip", icon: "users", show: can(user, "agency.manage") },
			]
		: panel === "company"
		? [
				{ href: "/firma", label: "Pano", icon: "dashboard", show: true },
				{ href: "/firma/yeni", label: "Yeni transfer", icon: "plus", show: true },
				{ href: "/firma/yolculuklar", label: "Yolculuklar", icon: "calendar", show: true },
				{ href: "/firma/ekstre", label: "Ekstre", icon: "file", show: true },
				{ href: "/firma/ekip", label: "Ekip", icon: "users", show: can(user, "company.manage") },
			]
		: partner
		? [
				{ href: "/partner", label: "İşler", icon: "calendar", show: true },
				{ href: "/partner/havuz", label: "İş havuzu", icon: "inbox", show: true },
				{ href: "/partner/suruculer", label: "Sürücüler", icon: "user", show: true },
				{ href: "/partner/araclar", label: "Araçlar", icon: "car", show: true },
				{ href: "/partner/finans", label: "Hakediş", icon: "wallet", show: true },
			]
		: [
			{ href: "/ops", label: "Pano", icon: "dashboard", show: true, group: "Günlük iş" },
			{ href: "/ops/rezervasyonlar", label: "Rezervasyonlar", icon: "calendar", show: can(user, "bookings.read"), count: "bookings" as const, hint: "sürücü bekleyen" },
			{ href: "/ops/talepler", label: "Fiyat talepleri", icon: "inbox", show: can(user, "bookings.read"), count: "requests" as const, hint: "yeni talep" },
			{ href: "/ops/harita", label: "Canlı harita", icon: "map", show: can(user, "bookings.read") },
			{ href: "/ops/suruculer", label: "Sürücüler", icon: "user", show: can(user, "bookings.read"), count: "applications" as const, hint: "yeni başvuru", group: "İş ortakları" },
			{ href: "/ops/partnerler", label: "Partner filolar", icon: "building", show: can(user, "bookings.read") },
			{ href: "/ops/firmalar", label: "Kurumsal firmalar", icon: "card", show: can(user, "bookings.read") },
			{ href: "/ops/acenteler", label: "Acenteler ve oteller", icon: "globe", show: can(user, "bookings.read") },
			{ href: "/ops/hakedis", label: "Hakediş", icon: "wallet", show: can(user, "settlements.manage"), group: "Finans" },
			{ href: "/ops/raporlar", label: "Raporlar", icon: "gauge", show: can(user, "reports.read") },
			{ href: "/ops/yonetim/tarifeler", label: "Tarifeler", icon: "tag", show: can(user, "catalog.read"), group: "Ayarlar" },
			{ href: "/ops/yonetim/bolgeler", label: "Bölgeler", icon: "pin", show: can(user, "catalog.read") },
			{ href: "/ops/yonetim/araclar", label: "Araçlar", icon: "car", show: can(user, "catalog.read") },
			{ href: "/ops/yonetim/ekstralar", label: "Ekstralar", icon: "gift", show: can(user, "catalog.read") },
			{ href: "/ops/yonetim/ayarlar", label: "Kurallar", icon: "sliders", show: can(user, "catalog.read") },
			{ href: "/ops/yonetim/kullanicilar", label: "Ekip", icon: "users", show: can(user, "users.manage") },
			{ href: "/ops/yonetim/denetim", label: "Denetim kaydı", icon: "file", show: can(user, "audit.read") },
			];
const NAV = NAV_ALL.filter((item) => item.show);
// Menu sections: an item without a group stays in the section above it.
const SECTIONS: { title: string; items: NavItem[] }[] = [];
for (const item of NAV) {
	if (item.group || SECTIONS.length === 0) SECTIONS.push({ title: item.group ?? "", items: [] });
	SECTIONS[SECTIONS.length - 1].items.push(item);
}
const isActive = (href: string) => active === href || (href !== PANEL.home && active.startsWith(`${href}/`));
const roleLabel = user ? user.roles.map((r) => ROLE_LABELS[r] ?? r).join(", ") : "";
const initials = user
	? user.name
			.split(/\s+/)
			.filter(Boolean)
			.slice(0, 2)
			.map((w) => w[0]!.toLocaleUpperCase("tr-TR"))
			.join("")
	: "";
// Booking search in the top bar, for ops staff who can read bookings.
const search = panel === "ops" && watch;
const hasActions = Astro.slots.has("actions");

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "same-origin");
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} · SecureDrive {PANEL.name}</title>
		<link rel="icon" href="/favicon.svg" />
	</head>
	<body class:list={["ops", NAV.length === 0 && "ops-solo"]}>
		{NAV.length > 0 && <input type="checkbox" id="ops-menu" class="ops-menu-toggle" aria-hidden="true" tabindex="-1" />}
		<div class="ops-app">
			{
				NAV.length > 0 && (
					<aside class="ops-side">
						<div class="ops-side-head">
							<a class="ops-brand" href={PANEL.home}>
								<span class="ops-logo" aria-hidden="true">SD</span>
								<span>
									SecureDrive <em>{PANEL.name}</em>
								</span>
							</a>
							<label for="ops-menu" class="ops-icon-btn ops-close" aria-label="Menüyü kapat">
								<Icon name="close" size={20} />
							</label>
						</div>
						<nav class="ops-nav" aria-label={`${PANEL.name} menüsü`}>
							{SECTIONS.map((section) => (
								<div class="ops-nav-group">
									{section.title && <p class="ops-nav-title">{section.title}</p>}
									{section.items.map((item) => (
										<a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
											<Icon name={item.icon} size={18} class="ops-nav-icon" />
											<span class="ops-nav-label">{item.label}</span>
											{item.count && (
												<span class="ops-count" data-ops-count={item.count} title={item.hint} hidden={counts[item.count] === 0}>
													{counts[item.count]}
												</span>
											)}
										</a>
									))}
								</div>
							))}
						</nav>
						{user && (
							<div class="ops-side-user">
								<span class="ops-avatar" aria-hidden="true">{initials}</span>
								<span class="ops-who">
									<strong>{user.name}</strong>
									<span>{roleLabel}</span>
								</span>
								<form method="post" action={PANEL.logout}>
									<button type="submit" class="ops-icon-btn" aria-label="Çıkış yap" title="Çıkış yap">
										<Icon name="logout" size={18} />
									</button>
								</form>
							</div>
						)}
					</aside>
				)
			}
			{NAV.length > 0 && <label for="ops-menu" class="ops-scrim" aria-hidden="true" />}
			<div class="ops-body">
				<header class:list={["ops-top", NAV.length > 0 && !search && !watch && "ops-top-min"]}>
					{
						NAV.length > 0 && (
							<label for="ops-menu" class="ops-icon-btn ops-burger" aria-label="Menü">
								<Icon name="menu" size={22} />
							</label>
						)
					}
					<a class="ops-brand ops-top-brand" href={PANEL.home}>
						<span class="ops-logo" aria-hidden="true">SD</span>
						<span>
							SecureDrive <em>{PANEL.name}</em>
						</span>
					</a>
					{
						search && (
							<form class="ops-search" method="get" action="/ops/rezervasyonlar" role="search">
								<Icon name="search" size={16} class="ops-search-icon" />
								<input type="search" name="q" placeholder="Rezervasyon ara: no, ad, telefon" aria-label="Rezervasyon ara" />
							</form>
						)
					}
					{
						user && (
							<div class="ops-user">
								{search && (
									<a class="ops-icon-btn ops-search-link" href="/ops/rezervasyonlar" aria-label="Rezervasyon ara">
										<Icon name="search" size={20} />
									</a>
								)}
								{watch && (
									<details class="ops-bell" data-ops-bell data-read-at={readAt}>
										<summary aria-label="Bildirimler">
											<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M10.27 21a2 2 0 0 0 3.46 0" />
												<path d="M3.26 15.33A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.67C19.41 13.96 18 12.5 18 8A6 6 0 0 0 6 8c0 4.5-1.41 5.96-2.74 7.33" />
											</svg>
											<span class="ops-count" data-ops-total hidden={unread === 0}>
												{unread}
											</span>
										</summary>
										<div class="ops-bell-panel">
											<div class="ops-bell-head">
												<strong>Bildirimler</strong>
												<button type="button" class="ops-link" data-ops-enable hidden>Masaüstü bildirimlerini aç</button>
											</div>
											<form class="ops-bell-actions" method="post" action="/ops/bildirim.json" data-ops-actions hidden={feed.length === 0}>
												<button type="submit" name="action" value="read" class="ops-link" data-ops-read hidden={unread === 0}>
													Tümünü okundu işaretle
												</button>
												<button type="submit" name="action" value="clear" class="ops-link danger">
													Tümünü temizle
												</button>
											</form>
											<ul data-ops-feed>
												{feed.map((item) => (
													<li data-key={item.key} data-at={item.at} class:list={{ unread: item.at > readAt }}>
														<a href={item.href}>
															<span class:list={["ops-dot", item.kind]} aria-hidden="true" />
															<span class="ops-feed-text">
																<strong>{item.title}</strong>
																<span>{item.detail}</span>
															</span>
															<time datetime={item.at}>{ago(item.at)}</time>
														</a>
													</li>
												))}
												{feed.length === 0 && <li class="ops-empty">Henüz bildirim yok.</li>}
											</ul>
										</div>
									</details>
								)}
								{NAV.length === 0 && (
									<form method="post" action={PANEL.logout}>
										<button type="submit" class="ops-icon-btn" aria-label="Çıkış yap" title="Çıkış yap">
											<Icon name="logout" size={18} />
										</button>
									</form>
								)}
							</div>
						)
					}
				</header>
				<main class="ops-main">
					<div class="ops-head">
						<div>
							<h1>{title}</h1>
							{subtitle && <p class="ops-sub">{subtitle}</p>}
						</div>
						{hasActions && (
							<div class="ops-head-actions">
								<slot name="actions" />
							</div>
						)}
					</div>
					<slot />
				</main>
			</div>
		</div>
		{watch && <div class="ops-toasts" data-ops-toasts aria-live="polite" />}
		{watch && <script src="/ops-alerts.js" defer is:inline />}
	</body>
</html>

<style is:global>
	@layer legacy {
	body.ops {
		--ops-bg: #f4f6f9;
		--ops-line: #e4e8ee;
		--ops-soft: #f8fafc;
		--ops-radius: 14px;
		--ops-shadow: 0 1px 2px rgb(16 24 40 / 0.05);
		--ops-side-w: 248px;
		--ops-top-h: 60px;
		margin: 0;
		background: var(--ops-bg);
		color: var(--ink-900);
		font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		font-size: 15px;
		line-height: 1.5;
	}

	/* ---------- shell */
	.ops-menu-toggle {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.ops-app {
		display: grid;
		grid-template-columns: var(--ops-side-w) minmax(0, 1fr);
		min-height: 100vh;
		background: linear-gradient(to right, var(--navy-900) var(--ops-side-w), transparent 0);
	}
	.ops-solo .ops-app {
		grid-template-columns: minmax(0, 1fr);
		background: none;
	}
	.ops-side {
		position: sticky;
		top: 0;
		display: flex;
		flex-direction: column;
		height: 100vh;
		background: var(--navy-900);
		color: #c9d4e2;
		overflow: hidden;
	}
	.ops-side-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--ops-top-h);
		padding: 0 16px 0 18px;
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
		flex-shrink: 0;
	}
	.ops-brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: #fff;
		font-weight: 700;
		font-size: 15px;
		letter-spacing: -0.01em;
		text-decoration: none;
		white-space: nowrap;
	}
	.ops-brand em {
		font-style: normal;
		font-weight: 500;
		color: var(--gold-300);
	}
	.ops-logo {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: linear-gradient(135deg, var(--gold-300), var(--gold-500));
		color: var(--navy-900);
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0;
		flex-shrink: 0;
	}
	.ops-nav {
		flex: 1;
		overflow-y: auto;
		padding: 10px 10px 16px;
		scrollbar-width: thin;
		scrollbar-color: rgb(255 255 255 / 0.15) transparent;
	}
	.ops-nav-group + .ops-nav-group {
		margin-top: 14px;
	}
	.ops-nav-title {
		margin: 0;
		padding: 6px 12px 6px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.4);
	}
	.ops-nav a {
		position: relative;
		display: flex;
		align-items: center;
		gap: 11px;
		padding: 7px 12px;
		margin: 1px 0;
		border-radius: 9px;
		color: #c9d4e2;
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
		transition:
			background 0.15s,
			color 0.15s;
	}
	.ops-nav-label {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.ops-nav-icon {
		flex-shrink: 0;
		color: rgb(255 255 255 / 0.5);
	}
	.ops-nav a:hover {
		background: rgb(255 255 255 / 0.06);
		color: #fff;
	}
	.ops-nav a[aria-current="page"] {
		background: rgb(255 255 255 / 0.1);
		color: #fff;
		font-weight: 600;
	}
	.ops-nav a[aria-current="page"]::before {
		content: "";
		position: absolute;
		left: -10px;
		top: 8px;
		bottom: 8px;
		width: 3px;
		border-radius: 0 3px 3px 0;
		background: var(--gold-300);
	}
	.ops-nav a[aria-current="page"] .ops-nav-icon {
		color: var(--gold-300);
	}
	.ops-side-user {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 12px 12px 16px;
		border-top: 1px solid rgb(255 255 255 / 0.08);
		flex-shrink: 0;
	}
	.ops-side-user form {
		margin: 0;
	}
	.ops-side-user .ops-icon-btn {
		color: rgb(255 255 255 / 0.6);
	}
	.ops-side-user .ops-icon-btn:hover {
		background: rgb(255 255 255 / 0.08);
		color: #fff;
	}
	.ops-avatar {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 999px;
		background: var(--navy-700);
		color: #fff;
		font-size: 13px;
		font-weight: 700;
		flex-shrink: 0;
	}
	.ops-who {
		display: grid;
		flex: 1;
		min-width: 0;
		line-height: 1.3;
	}
	.ops-who strong {
		color: #fff;
		font-size: 13px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.ops-who span {
		color: rgb(255 255 255 / 0.5);
		font-size: 12px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.ops-icon-btn {
		display: inline-grid;
		place-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 0;
		border-radius: 10px;
		background: transparent;
		color: var(--gray-600);
		cursor: pointer;
		flex-shrink: 0;
		transition:
			background 0.15s,
			color 0.15s;
	}
	.ops-icon-btn:hover {
		background: var(--gray-100);
		color: var(--ink-900);
	}
	.ops-close,
	.ops-burger,
	.ops-top-brand,
	.ops-scrim,
	.ops-search-link {
		display: none;
	}
	.ops-body {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.ops-top {
		position: sticky;
		top: 0;
		z-index: 40;
		display: flex;
		align-items: center;
		gap: 12px;
		height: var(--ops-top-h);
		padding: 0 24px;
		background: rgb(255 255 255 / 0.92);
		backdrop-filter: saturate(1.4) blur(8px);
		border-bottom: 1px solid var(--ops-line);
	}
	/* Partner, company and agency panels: nothing for the bar on desktop, the menu has it all. */
	@media (min-width: 1024px) {
		.ops-top-min {
			display: none;
		}
	}
	.ops-top .ops-brand {
		color: var(--navy-900);
	}
	.ops-top .ops-brand em {
		color: var(--gold-500);
	}
	.ops-solo .ops-top-brand {
		display: inline-flex;
	}
	.ops-search {
		position: relative;
		flex: 1;
		max-width: 420px;
		margin: 0;
	}
	.ops-search-icon {
		position: absolute;
		left: 12px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--gray-500);
		pointer-events: none;
	}
	.ops-search input {
		width: 100%;
		height: 38px;
		padding: 0 12px 0 36px;
		border: 1px solid var(--ops-line);
		border-radius: 10px;
		background: var(--ops-soft);
		font: inherit;
		font-size: 14px;
		color: inherit;
		transition:
			border-color 0.15s,
			background 0.15s,
			box-shadow 0.15s;
	}
	.ops-search input:focus {
		outline: none;
		background: #fff;
		border-color: var(--navy-600);
