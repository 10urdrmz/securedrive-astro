---
/**
 * The trip search bar (homepage hero, booking step 1). Without JavaScript it is a plain
 * form with selects and inputs; public/trip-search.js turns it into the searchable
 * pickers: place fields with a suggestion panel, a formatted date and time, and a
 * passenger and luggage popover. Everything the script shows is rendered here, so the
 * scoped styles reach it.
 */
import Icon from "./Icon.astro";
import { LOCALE_META, type Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";

export interface Place {
	id: string;
	name: string;
	airport: boolean;
}

interface Props {
	locale: Locale;
	action: string;
	places: Place[];
	values?: { from?: string; to?: string; date?: string; time?: string; pax?: number; bags?: number };
	submitLabel: string;
	/** "dark" sits on the hero photo; "light" on a grey page. */
	tone?: "dark" | "light";
}

const { locale, action, places, values = {}, submitLabel, tone = "dark" } = Astro.props;
const t = useTranslations(locale);
const today = new Date().toISOString().slice(0, 10);
const airports = places.filter((p) => p.airport);
const districts = places.filter((p) => !p.airport);
const POPULAR = ["besiktas", "sisli", "beyoglu", "fatih", "kadikoy", "sariyer", "atasehir", "bakirkoy"];
const popular = POPULAR.map((id) => districts.find((d) => d.id === id)).filter((d): d is Place => !!d);
const nameOf = (id?: string) => places.find((p) => p.id === id)?.name ?? "";
const pax = values.pax ?? 2;
const bags = values.bags ?? 2;
const date = values.date || today;

// "İstanbul Havalimanı (IST)" → name and code shown on two lines in the panel.
const split = (name: string) => {
	const m = name.match(/^(.*?)\s*\(([A-Z]{3})\)$/);
	return m ? { title: m[1], code: m[2] } : { title: name, code: "" };
};

const fields = [
	{ key: "from", label: t("quick.from"), first: "airports" as const },
	{ key: "to", label: t("quick.to"), first: "districts" as const },
];
---

<form
	class:list={["ts", `ts--${tone}`]}
	action={action}
	method="get"
	data-trip-search
	data-intl={LOCALE_META[locale].intl}
	data-pax-label={t("quick.paxCount")}
	data-bags-label={t("quick.bagCount")}
	data-time-empty={t("quick.pickTime")}
>
	<div class="ts-route">
		{
			fields.map((f, i) => (
				<>
					<div class:list={["ts-cell", "ts-place", `ts-cell--${f.key}`]} data-place>
						<label class="ts-label" for={`ts-${f.key}-q`}>
							{f.label}
						</label>
						<input
							class="ts-input ts-only-js"
							id={`ts-${f.key}-q`}
							type="text"
							role="combobox"
							aria-expanded="false"
							aria-controls={`ts-${f.key}-list`}
							aria-autocomplete="list"
							autocomplete="off"
							spellcheck="false"
							placeholder={t("quick.searchPlace")}
							value={nameOf(values[f.key as "from" | "to"])}
						/>
						<select class="ts-select ts-no-js" name={f.key} aria-label={f.label} required>
							<option value="">{t("form.choose")}</option>
							{(f.first === "airports" ? [airports, districts] : [districts, airports]).map((group) => (
								<optgroup label={group === airports ? t("quick.airports") : t("quick.districts")}>
									{group.map((p) => (
										<option value={p.id} selected={values[f.key as "from" | "to"] === p.id}>
											{p.name}
										</option>
									))}
								</optgroup>
							))}
						</select>
						<div class="ts-panel" id={`ts-${f.key}-list`} role="listbox" aria-label={f.label} hidden>
							<p class="ts-group" data-group="airports">{t("quick.airports")}</p>
							<ul class="ts-options">
								{airports.map((p) => {
									const { title, code } = split(p.name);
									return (
										<li class="ts-option" role="option" aria-selected="false" data-value={p.id} data-name={p.name} data-search={`${p.name} ${code}`}>
											<span class="ts-option-icon" aria-hidden="true">
												<Icon name="plane" size={18} />
											</span>
											<span class="ts-option-text">
												<strong>{title}</strong>
												<small>{t("quick.istanbulAirport")}</small>
											</span>
											{code && <span class="ts-code">{code}</span>}
										</li>
									);
								})}
							</ul>
							{popular.length > 0 && (
								<div data-when-empty>
									<p class="ts-group">{t("quick.popular")}</p>
									<div class="ts-chips">
										{popular.map((p) => (
											<button type="button" class="ts-chip ts-option" tabindex="-1" data-value={p.id} data-name={p.name} data-search={p.name}>
												{p.name}
											</button>
										))}
									</div>
								</div>
							)}
							<p class="ts-group" data-group="districts">{t("quick.districts")}</p>
							<ul class="ts-options">
								{districts.map((p) => (
									<li class="ts-option" role="option" aria-selected="false" data-value={p.id} data-name={p.name} data-search={p.name}>
										<span class="ts-option-icon" aria-hidden="true">
											<Icon name="pin" size={18} />
										</span>
										<span class="ts-option-text">
											<strong>{p.name}</strong>
											<small>{t("quick.istanbulDistrict")}</small>
										</span>
									</li>
								))}
							</ul>
							<p class="ts-empty" hidden>{t("quick.noMatch")}</p>
						</div>
					</div>
					{i === 0 && (
						<button type="button" class="ts-swap" data-swap aria-label={t("quick.swap")} title={t("quick.swap")}>
							<Icon name="swap" size={18} />
						</button>
					)}
				</>
			))
		}
		<label class="ts-cell ts-cell--date ts-picker" data-picker="date">
			<span class="ts-label">{t("quick.date")}</span>
			<span class="ts-value ts-only-js" data-display></span>
			<input class="ts-native-input" name="date" type="date" min={today} value={date} required />
			<span class="ts-cell-icon ts-only-js" aria-hidden="true"><Icon name="calendar" size={20} /></span>
		</label>
		<label class="ts-cell ts-cell--time ts-picker" data-picker="time">
			<span class="ts-label">{t("quick.time")}</span>
			<span class="ts-value ts-only-js" data-display></span>
			<input class="ts-native-input" name="time" type="time" value={values.time ?? ""} required />
			<span class="ts-cell-icon ts-only-js" aria-hidden="true"><Icon name="clock" size={20} /></span>
		</label>
	</div>

	<div class="ts-cell ts-people" data-people>
		<button type="button" class="ts-people-btn ts-only-js" aria-expanded="false" aria-controls="ts-people-pop">
			<span class="ts-label">{t("quick.paxBags")}</span>
			<span class="ts-value" data-people-summary>
				{t("quick.paxCount", { n: pax })}, {t("quick.bagCount", { n: bags })}
			</span>
		</button>
		<div class="ts-pop" id="ts-people-pop">
			{
				[
					{ name: "pax", label: t("quick.passengers"), hint: t("quick.paxHint"), min: 1, value: pax, icon: "users" },
					{ name: "bags", label: t("form.luggage"), hint: t("quick.bagsHint"), min: 0, value: bags, icon: "luggage" },
				].map((row) => (
					<div class="ts-stepper">
						<span class="ts-stepper-icon" aria-hidden="true">
							<Icon name={row.icon as "users"} size={20} />
						</span>
						<label class="ts-stepper-text" for={`ts-${row.name}`}>
							<strong>{row.label}</strong>
							<small>{row.hint}</small>
						</label>
						<button type="button" class="ts-step ts-only-js" data-step="-1" data-for={`ts-${row.name}`} aria-label={`${row.label} −`}>
							−
						</button>
						<input id={`ts-${row.name}`} class="ts-count" name={row.name} type="number" min={row.min} max="60" value={row.value} inputmode="numeric" required />
						<button type="button" class="ts-step ts-only-js" data-step="1" data-for={`ts-${row.name}`} aria-label={`${row.label} +`}>
							+
						</button>
					</div>
				))
			}
			<button type="button" class="btn btn--primary btn--block ts-only-js" data-people-done>
				{t("quick.done")}
			</button>
		</div>
	</div>

	<button type="submit" class="btn btn--primary ts-submit">
		{submitLabel}
		<Icon name="arrow" size={18} class="flip-rtl" />
	</button>
</form>

<script is:inline src="/trip-search.js" defer></script>

<style>
	.ts {
		--ts-radius: 14px;
		--ts-accent: var(--navy-700, #1e4f86);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(180px, 210px) auto;
		gap: var(--space-3);
		align-items: stretch;
		color: var(--ink-900);
	}

	.ts-route {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) 0 minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.85fr);
		background: #fff;
		border-radius: var(--ts-radius);
		box-shadow: var(--shadow-lg);
	}

	/* The booking page column is narrower than the hero: route on its own row. */
	.ts--light {
		grid-template-columns: minmax(0, 1fr) auto;
	}

	.ts--light .ts-route {
		grid-column: 1 / -1;
	}

	.ts--light .ts-route,
	.ts--light .ts-people {
		border: 1px solid var(--color-border);
		box-shadow: 0 6px 20px -12px rgb(16 24 40 / 0.18);
	}

	.ts-cell {
		position: relative;
		display: grid;
		align-content: center;
		gap: 2px;
		min-width: 0;
		min-height: 76px;
		margin: 0;
		padding: var(--space-3) var(--space-5);
		border: 2px solid transparent;
		border-radius: var(--ts-radius);
		cursor: pointer;
	}

	/* Hairlines between cells of the route group. */
	.ts-route > .ts-cell + .ts-cell::before,
	.ts-route > .ts-swap + .ts-cell::before {
		content: "";
		position: absolute;
		inset-inline-start: -2px;
		top: 22%;
		bottom: 22%;
		width: 1px;
		background: var(--color-border);
	}

	.ts-cell:focus-within,
	.ts-cell.is-open {
		border-color: var(--ts-accent);
		background: #fff;
		z-index: 3;
	}

	.ts-cell:focus-within::before,
	.ts-cell.is-open::before,
	.ts-cell:focus-within + .ts-cell::before {
		opacity: 0;
	}

	.ts-cell.is-invalid {
		border-color: var(--red-600, #dc2626);
	}

	.ts-label {
		font-size: var(--text-sm);
		color: var(--color-muted);
		line-height: 1.2;
		white-space: nowrap;
		cursor: inherit;
	}

	.ts-value,
	.ts-input {
		font-size: var(--text-lg);
		font-weight: 700;
		line-height: 1.3;
		color: var(--ink-900);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.ts-value.is-empty {
		color: var(--gray-400, #9ca3af);
		font-size: var(--text-base);
		font-weight: 500;
	}

	.ts-input {
		width: 100%;
		min-width: 0;
		min-height: 0;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		outline: none;
	}

	.ts-input::placeholder {
		color: var(--gray-400, #9ca3af);
		font-size: var(--text-base);
		font-weight: 500;
	}

	.ts-input:focus {
		outline: none;
		box-shadow: none;
	}

	/* Without the script: native controls; with it: the custom ones. */
	.ts-only-js {
		display: none;
	}

	:global(.ts.is-enhanced) .ts-only-js {
		display: revert;
	}

	:global(.ts.is-enhanced) .ts-input.ts-only-js,
	:global(.ts.is-enhanced) .ts-value.ts-only-js {
		display: block;
	}

	:global(.ts.is-enhanced) .ts-no-js {
		display: none;
	}

	.ts-select,
	.ts-native-input,
	.ts-count {
		min-height: 0;
		padding: 2px 0;
		border: 0;
		border-radius: 0;
		background-color: transparent;
		box-shadow: none;
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--ink-900);
	}

	/* The real date and time inputs stay in place, invisible, so a tap opens the native picker. */
	:global(.ts.is-enhanced) .ts-picker:not(.is-native) .ts-native-input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		cursor: pointer;
	}

	:global(.ts.is-enhanced) .ts-picker.is-native .ts-value {
		display: none;
	}

	.ts-picker {
		padding-inline-end: 2.75rem;
	}

	/* Room for the swap button on the shared edge. */
	.ts-cell--from {
		padding-inline-end: 1.75rem;
	}

	.ts-cell--to {
		padding-inline-start: 1.75rem;
	}

	.ts-cell-icon {
		position: absolute;
		inset-inline-end: var(--space-4);
		top: 50%;
		translate: 0 -50%;
		color: var(--gray-500, #6b7280);
		pointer-events: none;
	}

	:global(.ts.is-enhanced) .ts-cell-icon.ts-only-js {
		display: grid;
	}

	.ts-swap {
		position: relative;
		z-index: 4;
		align-self: center;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		translate: -50% 0;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		background: #fff;
		color: var(--ink-900);
		box-shadow: 0 1px 3px rgb(16 24 40 / 0.08);
		rotate: 90deg;
		cursor: pointer;
		transition: transform 0.2s var(--ease, ease);
	}

	:global([dir="rtl"]) .ts-swap {
		translate: 50% 0;
	}

	.ts-swap:hover {
		transform: rotate(180deg);
	}

	.ts-swap:focus-visible {
		outline: 2px solid var(--ts-accent);
		outline-offset: 2px;
	}

	/* Suggestion panel under a place field. */
	.ts-panel {
		position: absolute;
		top: calc(100% + 10px);
		inset-inline-start: -2px;
		z-index: 20;
		width: min(440px, calc(100vw - 2rem));
		max-height: min(420px, 60vh);
		overflow-y: auto;
		padding: var(--space-4) var(--space-3);
		background: #fff;
		border-radius: var(--ts-radius);
		box-shadow: 0 18px 50px -12px rgb(16 24 40 / 0.35);
		cursor: default;
	}

	.ts-panel[hidden] {
		display: none;
	}

	.ts-group {
		margin: var(--space-2) var(--space-3) var(--space-2);
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.ts-group:first-child {
		margin-top: 0;
	}

	.ts-options {
		margin: 0 0 var(--space-2);
		padding: 0;
		list-style: none;
	}

	.ts-option {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border-radius: 10px;
		cursor: pointer;
	}

	.ts-option[hidden] {
		display: none;
	}

	.ts-option:hover,
	.ts-option.is-active {
		background: var(--gray-100, #f3f4f6);
	}

	.ts-option[aria-selected="true"] strong {
		color: var(--ts-accent);
	}

	.ts-option-icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: var(--gray-100, #f3f4f6);
		color: var(--ink-900);
	}

	.ts-option-text {
		display: grid;
		min-width: 0;
		flex: 1;
	}

	.ts-option-text strong {
		font-size: var(--text-base);
		font-weight: 700;
	}

	.ts-option-text small {
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.ts-code {
		flex-shrink: 0;
		padding: 2px 8px;
		border-radius: 6px;
		background: var(--gray-100, #f3f4f6);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.ts-chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0 var(--space-3) var(--space-4);
	}

	.ts-chip {
		display: inline-flex;
		padding: 8px 16px;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: #fff;
		font: inherit;
		font-size: var(--text-base);
		color: var(--ink-900);
	}

	.ts-chip:hover,
	.ts-chip.is-active {
		border-color: var(--ts-accent);
		background: #fff;
	}

	.ts-empty {
		margin: var(--space-2) var(--space-3);
		color: var(--color-muted);
	}

	/* Passengers and luggage. */
	.ts-people {
		background: #fff;
		box-shadow: var(--shadow-lg);
		padding: 0;
		cursor: default;
	}

	.ts-people-btn {
		display: grid;
		align-content: center;
		gap: 2px;
		width: 100%;
		height: 100%;
		padding: var(--space-3) var(--space-5);
		border: 0;
		background: transparent;
		text-align: start;
		font: inherit;
		color: inherit;
		cursor: pointer;
	}

	:global(.ts.is-enhanced) .ts-people-btn.ts-only-js {
		display: grid;
	}

	.ts-people-btn:focus-visible {
		outline: none;
	}

	.ts-pop {
		display: grid;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-5);
	}

	:global(.ts.is-enhanced) .ts-pop {
		position: absolute;
		top: calc(100% + 10px);
		inset-inline-end: -2px;
		z-index: 20;
		width: min(340px, calc(100vw - 2rem));
		padding: var(--space-5);
		background: #fff;
		border-radius: var(--ts-radius);
		box-shadow: 0 18px 50px -12px rgb(16 24 40 / 0.35);
	}

	:global(.ts.is-enhanced) .ts-people:not(.is-open) .ts-pop {
		display: none;
	}

	.ts-stepper {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.ts-stepper-icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: var(--gray-100, #f3f4f6);
	}

	.ts-stepper-text {
		display: grid;
		flex: 1;
		min-width: 0;
		margin: 0;
	}

	.ts-stepper-text small {
		font-size: var(--text-xs);
		color: var(--color-muted);
	}

	.ts-step {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: #fff;
		font-size: 18px;
		line-height: 1;
		color: var(--ink-900);
		cursor: pointer;
	}

	.ts-step:hover:not(:disabled) {
		border-color: var(--ts-accent);
	}

	.ts-step:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.ts-count {
		width: 3.5rem;
		text-align: center;
		font-size: var(--text-lg);
		font-weight: 700;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 4px 0;
	}

	:global(.ts.is-enhanced) .ts-count {
		width: 2.25rem;
		border: 0;
		padding: 0;
		-moz-appearance: textfield;
	}

	:global(.ts.is-enhanced) .ts-count::-webkit-inner-spin-button,
	:global(.ts.is-enhanced) .ts-count::-webkit-outer-spin-button {
		-webkit-appearance: none;
		margin: 0;
	}

	.ts-submit {
		min-height: 76px;
		padding-inline: var(--space-6);
		border-radius: var(--ts-radius);
		font-size: var(--text-lg);
		white-space: nowrap;
	}

	/* Tablets: the route group takes the first row. */
	@media (max-width: 1260px) {
		.ts {
			grid-template-columns: minmax(0, 1fr) auto;
		}

		.ts-route {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 860px) {
		.ts-route {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.ts-cell--from,
		.ts-cell--to {
			grid-column: 1 / -1;
			padding-inline: var(--space-5) 4rem;
		}

		.ts-swap {
			position: absolute;
			inset-inline-end: var(--space-5);
			top: 76px;
			translate: 0 -50%;
			rotate: 0deg;
		}

		:global([dir="rtl"]) .ts-swap {
			translate: 0 -50%;
		}

		.ts-route > .ts-cell + .ts-cell::before,
		.ts-route > .ts-swap + .ts-cell::before {
			inset-inline: var(--space-5);
			top: -1px;
			bottom: auto;
			width: auto;
			height: 1px;
		}

		.ts-route > .ts-cell--time::before {
			inset-inline: 0 !important;
			top: 22% !important;
			bottom: 22% !important;
