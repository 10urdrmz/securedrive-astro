---
/** A company's trips as a table; each code opens the live trip page (status, driver, chat). */
import { STATUS_LABELS, type BookingStatus } from "../server/bookings";
import type { CompanyTrip } from "../server/companies";
import { formatMoney } from "../server/ops";
import { isoToIstanbul } from "../server/pricing";

interface Props {
	trips: CompanyTrip[];
	highlight?: string | null;
	/** Agencies see who pays instead of a cost centre. */
	agency?: boolean;
}
const { trips, highlight = null, agency = false } = Astro.props;
/** A guest who booked on our site through the agency's link: theirs is the trip page, not the agency's. */
const ownBooking = (t: CompanyTrip) => t.source !== "web";
const shortName = (name: string) => {
	const [first, ...rest] = name.trim().split(/\s+/);
	return rest.length ? `${first} ${rest[rest.length - 1][0]}.` : first;
};
const PAYER: Record<string, string> = { account: "Cari hesap", cash: "Misafir · nakit", card_in_vehicle: "Misafir · kart", online: "Misafir · online" };
const when = (iso: string) => {
	const { date, time } = isoToIstanbul(iso);
	return `${date.split("-").reverse().join(".")} ${time}`;
};
---

<div class="table-wrap">
	<table class="data">
		<thead>
			<tr>
				<th>Alış</th>
				<th>Kod</th>
				<th>Yolcu</th>
				<th>Güzergâh</th>
				<th>{agency ? "Ödeme" : "Masraf merkezi"}</th>
				<th>Durum</th>
				<th class="num">Tutar</th>
			</tr>
		</thead>
		<tbody>
			{
				trips.map((t) => (
					<tr class:list={[highlight === t.code && "hl"]}>
						<td style="white-space:nowrap">{when(t.pickup_at)}</td>
						<td>
							{ownBooking(t) ? (
								<a href={`/rezervasyon/${t.code}?t=${t.tracking_token}`} target="_blank" rel="noopener">
									{t.code}
								</a>
							) : (
								t.code
							)}
						</td>
						<td>
							{ownBooking(t) ? t.contact_name : shortName(t.contact_name)}
							<div class="muted">
								{!ownBooking(t) && "Linkinizden · "}
								{t.pax} kişi{t.flight_no && ` · ${t.flight_no}`}
								{t.booked_by && ` · ${t.booked_by} ayırdı`}
							</div>
						</td>
						<td>
							{t.from_name} → {t.to_name}
							<div class="muted">{t.class_name}</div>
						</td>
						<td>{agency ? (PAYER[t.payment_method] ?? t.payment_method) : (t.cost_center ?? "—")}</td>
						<td>
							<span class:list={["badge", t.status === "completed" && "ok", t.status === "cancelled" && "off"]}>{STATUS_LABELS[t.status as BookingStatus] ?? t.status}</span>
						</td>
						<td class="num" style="white-space:nowrap">{formatMoney(t.price_minor)} ₺</td>
					</tr>
				))
			}
			{
				trips.length === 0 && (
					<tr>
						<td colspan="7" class="muted">
							Yolculuk yok.
						</td>
					</tr>
				)
			}
		</tbody>
	</table>
</div>

<style>
	tr.hl td {
		background: #f0f6fc;
	}
</style>
