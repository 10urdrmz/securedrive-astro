---
import Icon from "../Icon.astro";
import { pagePath, type Locale } from "../../i18n/locales";
import { useTranslations } from "../../i18n/ui";
import { SITE, telHref, whatsappHref } from "../../lib/site";

interface Props {
	locale: Locale;
	title?: string;
	lead?: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const title = Astro.props.title ?? t("routes.custom");
---

<section class="cta-band">
	<div class="container cta-inner">
		<div>
			<h2>{title}</h2>
			{Astro.props.lead && <p>{Astro.props.lead}</p>}
		</div>
		<div class="cta-actions">
			<a href={pagePath(locale, "transfer")} class="btn btn--light">{t("hero.ctaPrimary")}</a>
			<a href={telHref} class="btn btn--ghost-light"><Icon name="phone" size={18} /><span dir="ltr">{SITE.phoneDisplay}</span></a>
			<a href={whatsappHref()} target="_blank" rel="noopener" class="btn btn--ghost-light"><Icon name="whatsapp" size={18} />WhatsApp</a>
		</div>
	</div>
</section>

<style>
	.cta-band {
		background:
			radial-gradient(900px 300px at 10% 0%, rgb(255 255 255 / 0.12), transparent 70%),
			linear-gradient(120deg, var(--navy-800), var(--navy-700));
		color: #fff;
		padding-block: clamp(2.5rem, 2rem + 3vw, 4rem);
	}

	.cta-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-8);
		flex-wrap: wrap;
	}

	h2 {
		font-size: var(--text-2xl);
		max-width: 28ch;
	}

	p {
		margin-top: var(--space-2);
		color: #c9d8e8;
		max-width: 60ch;
	}

	.cta-actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
</style>
