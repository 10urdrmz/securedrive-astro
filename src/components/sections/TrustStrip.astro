---
import Icon from "../Icon.astro";
import type { Locale } from "../../i18n/locales";
import { useTranslations } from "../../i18n/ui";

interface Props {
	locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const items = [
	{ icon: "shield", title: t("trust.license"), text: t("trust.licenseText") },
	{ icon: "plane", title: t("trust.flight"), text: t("trust.flightText") },
	{ icon: "wallet", title: t("trust.price"), text: t("trust.priceText") },
	{ icon: "headset", title: t("trust.support"), text: t("trust.supportText") },
] as const;
---

<ul class="trust">
	{
		items.map((item) => (
			<li>
				<span class="icon-box"><Icon name={item.icon} size={24} /></span>
				<div>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</div>
			</li>
		))
	}
</ul>

<style>
	.trust {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
		gap: var(--space-6);
	}

	li {
		display: flex;
		gap: var(--space-4);
		align-items: flex-start;
	}

	h3 {
		font-size: var(--text-base);
		margin-bottom: var(--space-1);
	}

	p {
		font-size: var(--text-sm);
		color: var(--color-muted);
	}
</style>
