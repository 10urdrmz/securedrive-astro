---
import Icon from "./Icon.astro";
import { LOCALES, LOCALE_META, accountPath, localizePath, lookupPath, pagePath, type Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { SITE, telHref, whatsappHref } from "../lib/site";

interface Props {
	locale: Locale;
	path: string;
	overlay?: boolean;
}

const { locale, path, overlay = false } = Astro.props;
const t = useTranslations(locale);
const current = path.split("/")[0];

const links = [
	{ key: "services", label: t("nav.services") },
	{ key: "fleet", label: t("nav.fleet") },
	{ key: "routes", label: t("nav.routes") },
	{ key: "corporate", label: t("nav.corporate") },
	{ key: "about", label: t("nav.about") },
	{ key: "contact", label: t("nav.contact") },
] as const;

// The header is dark-on-light on inner pages and light-on-dark over the home hero
// ("overlay") or while the mobile menu is open. `data-solid` (set on scroll) gives
// the overlay header its own background.
const navLink = [
	"block px-3 py-2 rounded-full text-sm font-medium whitespace-nowrap opacity-80 transition-opacity hover:opacity-100",
	"aria-[current=page]:opacity-100 aria-[current=page]:bg-navy-50 aria-[current=page]:text-navy-700",
	"group-data-[overlay]:aria-[current=page]:bg-white/10 group-data-[overlay]:aria-[current=page]:text-white",
].join(" ");
const stripLink = "inline-flex items-center gap-1.5 opacity-80 transition-opacity hover:opacity-100";
---

<header
	class:list={[
		"group top-0 z-50 border-0 border-b border-solid transition-colors duration-300",
		overlay
			? "fixed inset-x-0 bg-transparent border-transparent text-white data-[solid]:bg-ink-900/90 data-[solid]:backdrop-blur-md data-[solid]:border-white/10"
			: "sticky bg-white/90 backdrop-blur-md border-gray-200 text-ink-900 data-[open]:bg-ink-900 data-[open]:text-white data-[open]:border-white/10",
	]}
	data-header
	data-overlay={overlay ? "" : undefined}
>
	{/* Utility strip: contact, language and account. On smaller screens these live in the menu. */}
	<div class="hidden nav:block bg-ink-900 text-white text-[0.8125rem] border-0 border-b border-solid border-white/10 group-data-[overlay]:bg-transparent">
		<div class="container flex items-center justify-between gap-6 h-9">
			<div class="flex items-center gap-5">
				<a href={telHref} class:list={[stripLink, "font-semibold opacity-100"]}>
					<Icon name="phone" size={14} />
					<span dir="ltr">{SITE.phoneDisplay}</span>
				</a>
				<a href={whatsappHref()} class={stripLink} target="_blank" rel="noopener">
					<Icon name="whatsapp" size={14} />
					WhatsApp
				</a>
				<span class="inline-flex items-center gap-1.5 text-gold-300">
					<Icon name="headset" size={14} />
					{t("trust.support")}
				</span>
			</div>
			<div class="flex items-center gap-5">
				<a href={lookupPath(locale)} class={stripLink}>
					<Icon name="search" size={14} />
					{t("lookup.nav")}
				</a>
				<details class="lang relative">
					<summary class:list={[stripLink, "cursor-pointer list-none [&::-webkit-details-marker]:hidden"]} aria-label={t("nav.language")}>
						<Icon name="globe" size={14} />
						<span>{LOCALE_META[locale].label}</span>
						<Icon name="chevron" size={12} />
					</summary>
					<ul class="absolute end-0 top-full z-10 mt-2 min-w-40 list-none p-2 bg-white text-ink-900 border border-solid border-gray-200 rounded-xl shadow-lg">
						{
							LOCALES.map((l) => (
								<li>
									<a
										href={localizePath(l, path)}
										hreflang={l}
										lang={l}
										aria-current={l === locale ? "true" : undefined}
										class="block px-3 py-2 rounded-lg text-sm hover:bg-gray-100 aria-[current=true]:font-bold aria-[current=true]:text-navy-700"
									>
										{LOCALE_META[l].label}
									</a>
								</li>
							))
						}
					</ul>
				</details>
				{/* One address for everyone: it shows the account when signed in and the sign-in page otherwise, so cached pages stay identical for all visitors. */}
				<a href={accountPath(locale)} class={stripLink}>
					<Icon name="user" size={14} />
					{t("nav.account")}
				</a>
			</div>
		</div>
	</div>

	<div class="container flex items-center gap-6 h-18">
		<a href={pagePath(locale, "home")} class="flex shrink-0 items-center gap-2" aria-label={SITE.name}>
			<img src="/logo.png" alt="" width="160" height="38" class="h-[26px] w-auto sm:h-[30px] group-data-[overlay]:hidden group-data-[open]:hidden" />
			<img src="/logo-light.png" alt="" width="160" height="38" class="hidden h-[26px] w-auto sm:h-[30px] group-data-[overlay]:block group-data-[open]:block" />
			<span class="px-1.5 py-0.5 border border-solid border-gold-500 rounded text-gold-500 text-[0.625rem] font-bold tracking-[0.14em] rtl:tracking-normal">VIP</span>
		</a>

		<nav class="hidden nav:block ms-auto" aria-label={t("nav.menu")}>
			<ul class="flex items-center gap-1 list-none p-0">
				{
					links.map((link) => {
						const href = pagePath(locale, link.key);
						const active = current === href.split("/").filter(Boolean).at(-1);
						return (
							<li>
								<a href={href} class={navLink} aria-current={active ? "page" : undefined}>
									{link.label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</nav>

		<div class="flex items-center gap-2 ms-auto nav:ms-0">
			<a href={pagePath(locale, "transfer")} class="btn btn--primary btn--sm max-sm:hidden">{t("nav.book")}</a>
			<a href={accountPath(locale)} class="nav:hidden grid place-items-center size-11 rounded-full" aria-label={t("nav.account")}>
				<Icon name="user" size={20} />
			</a>
			<button
				type="button"
				class="nav:hidden grid place-items-center size-11 border-0 bg-transparent rounded-lg cursor-pointer"
				aria-expanded="false"
				aria-controls="mobile-nav"
				data-menu-toggle
			>
				<Icon name="menu" size={22} />
				<span class="visually-hidden">{t("nav.menu")}</span>
			</button>
		</div>
	</div>

</header>

{/* Outside the header on purpose: its backdrop blur would otherwise confine this fixed panel to the bar. */}
<div id="mobile-nav" class="fixed inset-x-0 bottom-0 top-(--header-h) z-40 overflow-y-auto bg-ink-900 text-white pt-4 pb-12 nav:hidden" hidden>
	<nav class="container" aria-label={t("nav.menu")}>
		<ul class="list-none p-0">
			{
				[...links, { key: "faq", label: t("nav.faq") }, { key: "how", label: t("nav.how") }].map((link) => (
					<li>
						<a
							href={pagePath(locale, link.key as (typeof links)[number]["key"])}
							class="block py-4 border-0 border-b border-solid border-white/10 font-display text-2xl font-semibold"
						>
							{link.label}
						</a>
					</li>
				))
			}
			<li>
				<a href={lookupPath(locale)} class="flex items-center gap-3 py-4 border-0 border-b border-solid border-white/10 font-display text-2xl font-semibold">
					<Icon name="search" size={22} />
					{t("lookup.nav")}
				</a>
			</li>
			<li>
				<a href={accountPath(locale)} class="flex items-center gap-3 py-4 border-0 border-b border-solid border-white/10 font-display text-2xl font-semibold">
					<Icon name="user" size={22} />
					{t("nav.account")}
				</a>
			</li>
		</ul>
		<div class="flex flex-wrap gap-2 my-6">
			{
				LOCALES.map((l) => (
					<a
						href={localizePath(l, path)}
						hreflang={l}
						lang={l}
						aria-current={l === locale ? "true" : undefined}
						class="px-4 py-2 border border-solid border-white/20 rounded-full text-sm font-semibold aria-[current=true]:bg-white aria-[current=true]:text-ink-900"
					>
						{LOCALE_META[l].label}
					</a>
				))
			}
		</div>
		<div class="grid gap-3">
			<a href={pagePath(locale, "transfer")} class="btn btn--primary btn--block">{t("nav.book")}</a>
			<a href={telHref} class="btn btn--ghost-light btn--block"><Icon name="phone" size={18} /><span dir="ltr">{SITE.phoneDisplay}</span></a>
			<a href={whatsappHref()} class="btn btn--ghost-light btn--block" target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />WhatsApp</a>
		</div>
	</nav>
</div>


<script>
	const header = document.querySelector<HTMLElement>("[data-header]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const panel = document.getElementById("mobile-nav");

	toggle?.addEventListener("click", () => {
		const open = toggle.getAttribute("aria-expanded") === "true";
		toggle.setAttribute("aria-expanded", String(!open));
		if (panel) panel.hidden = open;
		header?.toggleAttribute("data-open", !open);
		document.body.style.overflow = open ? "" : "hidden";
		refresh();
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") toggle.click();
	});

	// Close the language menu when clicking elsewhere.
	document.addEventListener("click", (event) => {
		document.querySelectorAll<HTMLDetailsElement>("details.lang[open]").forEach((d) => {
			if (!d.contains(event.target as Node)) d.open = false;
		});
	});

	// The overlay header turns solid once the page scrolls or the menu opens.
	function refresh() {
		if (!header?.hasAttribute("data-overlay")) return;
		header.toggleAttribute("data-solid", window.scrollY > 24 || header.hasAttribute("data-open"));
	}
	refresh();
	window.addEventListener("scroll", refresh, { passive: true });
</script>
