---
import Icon from "./Icon.astro";
import { localizePath, pagePath, type Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { SITE, telHref, whatsappHref } from "../lib/site";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const LEGAL_LABELS: Record<Locale, [string, string, string, string]> = {
	tr: ["KVKK Aydınlatma Metni", "Gizlilik ve Çerezler", "Mesafeli Satış Sözleşmesi", "İptal ve İade"],
	en: ["Personal Data Notice", "Privacy and Cookies", "Distance Sales Agreement", "Cancellation and Refunds"],
	ar: ["إشعار البيانات الشخصية", "الخصوصية وملفات تعريف الارتباط", "اتفاقية البيع عن بُعد", "الإلغاء والاسترداد"],
	ru: ["Обработка персональных данных", "Конфиденциальность и cookie", "Договор дистанционной продажи", "Отмена и возврат"],
};
const legalSlugs = ["kvkk", "gizlilik-politikasi", "mesafeli-satis-sozlesmesi", "iptal-ve-iade"];
const legal = legalSlugs.map((slug, i) => ({ href: localizePath(locale, slug), label: LEGAL_LABELS[locale][i] }));

const explore = [
	{ href: pagePath(locale, "services"), label: t("nav.services") },
	{ href: pagePath(locale, "fleet"), label: t("nav.fleet") },
	{ href: pagePath(locale, "routes"), label: t("nav.routes") },
	{ href: pagePath(locale, "how"), label: t("nav.how") },
	{ href: pagePath(locale, "transfer"), label: t("nav.book") },
];
const company = [
	{ href: pagePath(locale, "about"), label: t("nav.about") },
	{ href: pagePath(locale, "corporate"), label: t("nav.corporate") },
	{ href: pagePath(locale, "faq"), label: t("nav.faq") },
	{ href: pagePath(locale, "blog"), label: t("nav.blog") },
	{ href: pagePath(locale, "contact"), label: t("nav.contact") },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<img src="/logo-light.png" alt={SITE.name} width="160" height="38" loading="lazy" />
			<p>{t("footer.tagline")}</p>
			<ul class="licenses" aria-label={t("footer.licenses")}>
				<li><Icon name="shield" size={16} /> D2: {SITE.licenses.d2}</li>
				<li><Icon name="award" size={16} /> TÜRSAB: {SITE.licenses.tursab}</li>
			</ul>
		</div>

		<nav aria-label={t("footer.explore")}>
			<h2>{t("footer.explore")}</h2>
			<ul>{explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
		</nav>

		<nav aria-label={t("footer.company")}>
			<h2>{t("footer.company")}</h2>
			<ul>{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
		</nav>

		<div>
			<h2>{t("footer.contact")}</h2>
			<ul class="contact-list">
				<li>
					<a href={telHref}><Icon name="phone" size={16} /><span dir="ltr">{SITE.phoneDisplay}</span></a>
				</li>
				<li>
					<a href={whatsappHref()} rel="noopener" target="_blank"><Icon name="whatsapp" size={16} />WhatsApp</a>
				</li>
				<li>
					<a href={`mailto:${SITE.email}`}><Icon name="mail" size={16} />{SITE.email}</a>
				</li>
				<li class="muted"><Icon name="pin" size={16} />{t("contact.desksText")}</li>
			</ul>
		</div>
	</div>

	<div class="container footer-bottom">
		<p>© {year} {SITE.legalName}. {t("footer.rights")}</p>
		<nav aria-label={t("footer.legal")}>
			<ul>{legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink-950);
		color: #c3cad3;
		padding-top: var(--space-16);
		font-size: var(--text-sm);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
		gap: var(--space-10);
		padding-bottom: var(--space-12);
	}

	.footer-brand img {
		height: 30px;
		width: auto;
		margin-bottom: var(--space-4);
	}

	.footer-brand p {
		max-width: 34ch;
		color: #8f9aa6;
	}

	h2 {
		font-family: var(--font-sans);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #fff;
		margin-bottom: var(--space-4);
	}

	:global([dir="rtl"]) h2 {
		letter-spacing: 0;
	}

	ul {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--space-3);
	}

	a:hover {
		color: #fff;
	}

	.licenses {
		margin-top: var(--space-6);
		gap: var(--space-2);
		color: #8f9aa6;
	}

	.licenses li,
	.contact-list :is(a, li) {
		display: flex;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.licenses :global(svg),
	.contact-list :global(svg) {
		flex-shrink: 0;
		margin-top: 0.15em;
		color: var(--gold-300);
	}

	.muted {
		color: #8f9aa6;
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-4);
		flex-wrap: wrap;
		padding-block: var(--space-6) calc(var(--space-6) + env(safe-area-inset-bottom));
		border-top: 1px solid rgb(255 255 255 / 0.08);
		color: #7c8794;
	}

	.footer-bottom ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}

		.site-footer {
			padding-bottom: 72px;
		}
	}
</style>
