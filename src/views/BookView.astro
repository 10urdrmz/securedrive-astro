---
/**
 * Booking request, the GetTransfer way: step 1 is the trip, step 2 who travels and
 * what they need. Sending it opens the request to partner fleets and drivers; their
 * prices arrive as offers on the booking page (TripView), where the customer picks
 * one. Personal and never cached; see lib/booking-page.ts.
 */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Notice from "../components/Notice.astro";
import TripSearch from "../components/TripSearch.astro";
import VehiclePicker from "../components/VehiclePicker.astro";
import { BOOK_SLUG, LOCALE_META, accountPath, bookPath, localizePath } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import type { WizardPage } from "../lib/booking-page";
import { formatTry } from "../lib/format";
import { NATIONALITIES, nationalityName } from "../lib/nationalities";
import { SITE, telHref, whatsappHref } from "../lib/site";

type Props = WizardPage;

const page = Astro.props;
const { locale } = page;
const t = useTranslations(locale);
const intl = LOCALE_META[locale].intl;
const money = (minor: number) => formatTry(minor / 100, locale);
const card = "bg-white border border-solid border-gray-200 rounded-2xl shadow-[0_6px_20px_-12px_rgb(16_24_40/0.18)]";
const trip = page.trip;
const tripQuery = new URLSearchParams(
	Object.entries(trip)
		.filter(([, v]) => v !== undefined && v !== "")
		.map(([k, v]) => [k, String(v)]),
).toString();
const steps = [t("book.step1"), t("book.step2"), t("book.step3")];
const airports = page.zones.filter((z) => z.kind === "airport");
const districts = page.zones.filter((z) => z.kind !== "airport");
const zoneName = (id?: string) => page.zones.find((z) => z.id === id)?.name ?? "";
const promises = ["book.why1", "book.why2", "book.why3"] as const;
const whenShort = trip.date && trip.time
	? `${new Intl.DateTimeFormat(intl, { day: "numeric", month: "short", weekday: "short", timeZone: "UTC" }).format(new Date(`${trip.date}T00:00:00Z`))} · ${trip.time}`
	: "";
const paxCount = Math.min(Math.max(trip.pax ?? 1, 1), 60);
const travellers = Array.from({ length: paxCount }, (_, i) => i);
const chosenVehicle = page.vehicles.find((v) => v.key === trip.class);
---

<Base locale={locale} path={BOOK_SLUG} title={t("book.title")} description={t("book.lead")} noindex={Astro.url.search.length > 0}>
	<section class="bg-[radial-gradient(900px_320px_at_85%_-20%,rgb(29_95_155/0.45),transparent_70%),linear-gradient(180deg,var(--color-ink-900),var(--color-ink-800))] text-white">
		<div class="container py-10 sm:py-14">
			<h1 class="font-display text-3xl sm:text-4xl font-bold">{t("book.title")}</h1>
			<p class="mt-3 max-w-2xl text-white/70">{t("book.lead")}</p>
			<ol class="mt-6 flex flex-wrap gap-2 list-none p-0">
				{
					steps.map((label, i) => (
						<li
							class:list={[
								"inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-semibold",
								i + 1 === page.step ? "bg-white text-navy-800" : i + 1 < page.step ? "bg-white/20" : "bg-white/5 text-white/60",
							]}
							aria-current={i + 1 === page.step ? "step" : undefined}
						>
							{i + 1 < page.step ? <Icon name="tick" size={16} /> : <span class="tabular-nums">{i + 1}</span>}
							{label}
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="bg-gray-100 py-8 sm:py-12 min-h-[50vh]">
		<div class="container grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-8 items-start">
			<div class="grid gap-6 min-w-0">
				{page.error && <Notice tone="danger">{t(page.error)}</Notice>}

				{/* Step 1: the trip. In step 2 it folds into a one-line summary that opens to edit. */}
				{page.step === 1 ? (
					<div class="grid gap-2">
						<TripSearch
						id="trip-search"
						locale={locale}
						action={bookPath(locale)}
						tone="light"
						places={[...airports.map((z) => ({ id: z.id, name: z.name, airport: true })), ...districts.map((z) => ({ id: z.id, name: z.name, airport: false }))]}
						values={trip}
						submitLabel={t("book.next")}
					/>
					<small class="text-sm text-gray-600">{t("book.timeHint")}</small>
					{page.vehicles.length > 0 && (
						<div class:list={[card, "mt-4 p-5 sm:p-6"]}>
							<VehiclePicker locale={locale} vehicles={page.vehicles} selected={trip.class} form="trip-search" />
						</div>
					)}
					</div>
				) : (
					<details class="bk-trip" open={!!page.error && !page.values.name}>
						<summary>
							<span class="bk-trip-route">
								<Icon name="route" size={18} />
								<strong>{zoneName(trip.from)}</strong>
								<Icon name="arrow" size={14} class="flip-rtl" />
								<strong>{zoneName(trip.to)}</strong>
							</span>
							<span class="bk-trip-meta">
								<span><Icon name="calendar" size={16} />{whenShort}</span>
								<span><Icon name="users" size={16} />{t("book.capacity", { pax: trip.pax ?? 1, bags: trip.bags ?? 0 })}</span>
								{chosenVehicle && <span><Icon name="car" size={16} />{chosenVehicle.name}</span>}
							</span>
							<span class="bk-trip-edit">{t("book.editTrip")}</span>
						</summary>
						<div class="bk-trip-body">
							<TripSearch
						locale={locale}
						action={bookPath(locale)}
						tone="light"
						places={[...airports.map((z) => ({ id: z.id, name: z.name, airport: true })), ...districts.map((z) => ({ id: z.id, name: z.name, airport: false }))]}
						values={trip}
						keep={{ class: trip.class }}
						submitLabel={t("book.update")}
					/>
					<small class="text-sm text-gray-600">{t("book.timeHint")}</small>
						</div>
					</details>
				)}

				{/* Step 2: travellers, trip details, extras, payment. Sending it asks carriers for prices. */}
				{
					page.step === 2 && (
						<form id="bilgiler" class:list={[card, "bk-form"]} method="post" action={`${bookPath(locale)}?${tripQuery}#bilgiler`}>
							{page.vehicles.length > 0 && (
								<section class="bk-section">
									<VehiclePicker locale={locale} vehicles={page.vehicles} selected={page.values.class} pax={paxCount} bags={trip.bags ?? 0} compact />
								</section>
							)}
							<section class="bk-section">
								<h2>{t("book.travellers")}</h2>
								<div class="bk-grid bk-grid--3">
									<div class="field">
										<label for="bk-p0-name">{t("form.name")}</label>
										<input id="bk-p0-name" name="name" required minlength="2" maxlength="80" autocomplete="name" value={page.values.name} />
									</div>
									<div class="field">
										<label for="bk-phone">{t("form.phone")}</label>
										<input id="bk-phone" name="phone" type="tel" required maxlength="24" autocomplete="tel" dir="ltr" placeholder="+90 5xx xxx xx xx" value={page.values.phone} />
									</div>
									<div class="field">
										<label for="bk-email">{t("form.emailOptional")}</label>
										<input id="bk-email" name="email" type="email" maxlength="120" autocomplete="email" dir="ltr" value={page.values.email} />
									</div>
								</div>
								{paxCount > 1 && (
									<div class="bk-others field">
										<p class="bk-hint">{t("book.othersHint", { n: paxCount - 1 })}</p>
										<div class="bk-grid">
											{travellers.slice(1).map((i) => (
												<label class="bk-name-row" for={`bk-p${i}-name`}>
													<span class="bk-badge" aria-hidden="true">{i + 1}</span>
													<input
														id={`bk-p${i}-name`}
														name={`p${i}_name`}
														required
														minlength="2"
														maxlength="80"
														autocomplete="off"
														placeholder={t("book.travellerNamePh", { n: i + 1 })}
														aria-label={t("book.travellerNamePh", { n: i + 1 })}
														value={page.values[`p${i}_name`] ?? ""}
													/>
												</label>
											))}
										</div>
									</div>
								)}
								<details class="bk-more" open={travellers.some((i) => page.values[`p${i}_doc`])}>
									<summary><Icon name="plus" size={16} />{t("book.addIdDetails")}</summary>
									<div class="bk-id-list field">
										{travellers.map((i) => (
											<div class="bk-id-row">
												<span class="bk-id-who">{i === 0 ? page.values.name || t("book.travellerN", { n: 1 }) : t("book.travellerN", { n: i + 1 })}</span>
												<select name={`p${i}_nat`} aria-label={`${t("book.travellerN", { n: i + 1 })} · ${t("form.nationality")}`}>
													{NATIONALITIES.map((code) => (
														<option value={code} selected={(page.values[`p${i}_nat`] || page.values.p0_nat || "TR") === code}>
															{nationalityName(code, intl, t("form.nationalityOther"))}
														</option>
													))}
												</select>
												<input
													name={`p${i}_doc`}
													maxlength="20"
													autocomplete="off"
													dir="ltr"
													placeholder={t("form.idDocShort")}
													aria-label={`${t("book.travellerN", { n: i + 1 })} · ${t("form.idDocShort")}`}
													value={page.values[`p${i}_doc`] ?? ""}
												/>
											</div>
										))}
									</div>
								</details>
							</section>

							<section class="bk-section">
								<h2>{t("book.tripDetails")}</h2>
								<div class="bk-grid">
									<div class="field">
										<label for="bk-flight">{t("form.flight")}</label>
										<input id="bk-flight" name="flight" maxlength="12" autocomplete="off" dir="ltr" placeholder="TK 1984" value={page.values.flight} />
									</div>
									<div class="field">
										<label for="bk-sign">{t("book.signName")}</label>
										<input id="bk-sign" name="sign" maxlength="60" value={page.values.sign} />
									</div>
									<div class="field bk-span-2">
										<label for="bk-address">{page.addressOnPickup ? t("book.pickupAddress") : t("book.dropoffAddress")}</label>
										<input id="bk-address" name="address" maxlength="200" autocomplete="street-address" value={page.values.address} />
									</div>
								</div>
								<details class="bk-more" open={!!page.values.notes}>
									<summary><Icon name="plus" size={16} />{t("book.addNote")}</summary>
									<div class="field"><textarea id="bk-notes" name="notes" rows="3" maxlength="1000" aria-label={t("form.notes")}>{page.values.notes}</textarea></div>
								</details>
							</section>

							{page.extras && page.extras.length > 0 && (
								<section class="bk-section">
									<h2>{t("book.extras")}</h2>
									<div class="bk-extras">
										{page.extras.map((extra) => (
											<label class="bk-extra field" for={`bk-extra-${extra.key}`}>
												<span class="bk-extra-text">
													<strong>{extra.name}</strong>
													<small>{extra.price_minor ? money(extra.price_minor) : t("book.free")}</small>
												</span>
												<select id={`bk-extra-${extra.key}`} name={`extra_${extra.key}`}>
													{Array.from({ length: extra.max_qty + 1 }, (_, n) => (
														<option value={n} selected={String(n) === (page.values[`extra_${extra.key}`] ?? "0")}>{n}</option>
													))}
												</select>
											</label>
										))}
									</div>
								</section>
							)}

							<section class="bk-section">
								<h2>{t("book.payment")}</h2>
								<div class="bk-pay" role="radiogroup" aria-label={t("book.payment")}>
									{(["cash", "card_in_vehicle"] as const).map((method) => (
										<label class="bk-pay-option">
											<input type="radio" name="payment" value={method} checked={(page.values.payment || "cash") === method} />
											<Icon name={method === "cash" ? "wallet" : "card"} size={18} />
											<span>{t(`book.pay.${method}`)}</span>
										</label>
									))}
								</div>
							</section>

							<section class="bk-section bk-send">
								<div class="hp-field" aria-hidden="true">
									<label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
								</div>
								<label class="checkbox">
									<input type="checkbox" name="terms" required />
									<span>
										<a href={localizePath(locale, "mesafeli-satis-sozlesmesi")} target="_blank">{t("book.termsLink")}</a> ·{" "}
										<a href={localizePath(locale, "iptal-ve-iade")} target="_blank">{t("book.cancelLink")}</a> — {t("book.terms")}
									</span>
								</label>
								<button type="submit" class="btn btn--primary btn--block bk-submit">
									{t("book.sendRequest")}
									<Icon name="arrow" size={18} class="flip-rtl" />
								</button>
								<p class="bk-hint bk-center">
									{t("book.requestHint")}
									{!page.member && (
										<>
											{" "}
											<a class="underline" href={accountPath(locale, "giris")}>{t("account.loginButton")}</a>
										</>
									)}
								</p>
							</section>
						</form>
					)
				}
			</div>

			<aside class="grid gap-6 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]">
				<div class:list={[card, "grid gap-3 p-6"]}>
					<h2 class="font-display text-lg font-bold m-0">{t("book.howTitle")}</h2>
					<ul class="grid gap-3 list-none p-0 m-0 text-sm text-gray-700">
						{
							promises.map((k) => (
								<li class="flex gap-2">
									<Icon name="check" size={18} class="shrink-0 text-emerald-600" />
									<span>{t(k)}</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class:list={[card, "grid gap-3 p-6"]}>
					<p class="font-semibold">{t("common.callUs")}</p>
					<a href={telHref} class="btn btn--ghost btn--block" dir="ltr"><Icon name="phone" size={18} />{SITE.phoneDisplay}</a>
					<a href={whatsappHref()} class="btn btn--ghost btn--block" target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />WhatsApp</a>
				</div>
			</aside>
		</div>
	</section>
</Base>

<style>
	.bk-trip {
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: 16px;
	}

	.bk-trip summary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-5);
		padding: var(--space-4) var(--space-5);
		cursor: pointer;
		list-style: none;
	}

	.bk-trip summary::-webkit-details-marker {
		display: none;
	}

	.bk-trip-route,
	.bk-trip-meta,
	.bk-trip-meta span {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.bk-trip-route {
		color: var(--ink-900);
		min-width: 0;
	}

	.bk-trip-meta {
		gap: var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.bk-trip-edit {
		margin-inline-start: auto;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--navy-700, #1e4f86);
	}

	.bk-trip[open] .bk-trip-edit {
		visibility: hidden;
	}

	.bk-trip-body {
		padding: 0 var(--space-4) var(--space-4);
	}

	.bk-form {
		display: grid;
	}

	.bk-section {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-6);
	}

	.bk-section + .bk-section {
		border-top: 1px solid var(--color-border);
	}

	@media (min-width: 640px) {
		.bk-section {
			padding: var(--space-6) var(--space-8);
		}
	}

	.bk-section h2 {
		margin: 0;
		font-size: var(--text-base);
		font-weight: 700;
	}

	.bk-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-3) var(--space-4);
	}

	.bk-grid--3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.bk-grid .field {
		margin: 0;
	}

	.bk-span-2 {
		grid-column: 1 / -1;
	}

	@media (max-width: 760px) {
		.bk-grid--3 {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 560px) {
		.bk-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.bk-hint {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	.bk-center {
		text-align: center;
	}

	.bk-others {
		display: grid;
		gap: var(--space-2);
	}

	.bk-name-row {
		position: relative;
		display: block;
		margin: 0;
	}

	.bk-name-row input {
		width: 100%;
		font-size: var(--text-base);
		font-weight: 400;
		padding-inline-start: 2.75rem;
	}

	.bk-badge {
		position: absolute;
		inset-inline-start: 10px;
		top: 50%;
		translate: 0 -50%;
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: var(--gray-100, #f3f4f6);
		font-size: var(--text-xs);
		font-weight: 700;
		color: var(--gray-600, #4b5563);
		pointer-events: none;
	}

	.bk-more summary {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--navy-700, #1e4f86);
		cursor: pointer;
		list-style: none;
	}

	.bk-more summary::-webkit-details-marker {
		display: none;
	}

	.bk-more[open] summary {
		margin-bottom: var(--space-3);
	}

	.bk-more textarea {
		width: 100%;
	}

	.bk-id-list {
		display: grid;
		gap: var(--space-2);
	}

	.bk-id-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: var(--space-3);
	}

	.bk-id-who {
		font-size: var(--text-sm);
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (max-width: 560px) {
		.bk-id-row {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.bk-id-who {
			grid-column: 1 / -1;
		}
	}

	.bk-extras {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: var(--space-2);
	}

	.bk-extra {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		margin: 0;
		padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		cursor: pointer;
	}

	:global([dir="rtl"]) .bk-extra {
		padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
	}

	.bk-extra:has(option:checked:not([value="0"])) {
		border-color: var(--navy-700, #1e4f86);
		background: #f4f8fd;
	}

	.bk-extra-text {
		display: grid;
		min-width: 0;
		font-size: var(--text-sm);
		line-height: 1.3;
	}

	.bk-extra-text small {
		color: var(--color-muted);
	}

	.bk-extra select {
		width: auto;
		min-width: 4.5rem;
		min-height: 40px;
		padding-block: 6px;
	}

	.bk-pay {
		display: inline-grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: 4px;
		padding: 4px;
		border-radius: 12px;
		background: var(--gray-100, #f3f4f6);
	}

	@media (max-width: 420px) {
		.bk-pay {
			grid-auto-flow: row;
		}
	}

	.bk-pay-option {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		margin: 0;
		padding: 10px var(--space-4);
		border-radius: 9px;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--gray-600, #4b5563);
		cursor: pointer;
		white-space: nowrap;
	}

	.bk-pay-option input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.bk-pay-option:has(input:checked) {
		background: #fff;
		color: var(--ink-900);
		box-shadow: 0 1px 3px rgb(16 24 40 / 0.12);
	}

	.bk-pay-option:has(input:focus-visible) {
		outline: 2px solid var(--navy-700, #1e4f86);
		outline-offset: 1px;
	}

	.bk-send {
		background: var(--gray-50, #f9fafb);
		border-radius: 0 0 16px 16px;
	}

	.bk-submit {
		min-height: 54px;
		font-size: var(--text-lg);
	}
</style>
