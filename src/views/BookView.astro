---
/**
 * Online booking: the three-step wizard (trip → vehicle → details) and the page of
 * one booking. Both are personal and never cached; see lib/booking-page.ts.
 */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { BOOK_SLUG, LOCALE_META, accountPath, bookPath, localizePath, pagePath } from "../i18n/locales";
import { useTranslations, type UiKey } from "../i18n/ui";
import type { BookPage } from "../lib/booking-page";
import { formatApprox, formatTry } from "../lib/format";
import { SITE, telHref, whatsappHref } from "../lib/site";
import { isoToIstanbul } from "../server/pricing";

type Props = BookPage;

const page = Astro.props;
const { locale } = page;
const t = useTranslations(locale);
const intl = LOCALE_META[locale].intl;
const money = (minor: number) => formatTry(minor / 100, locale);
const card = "bg-white border border-solid border-gray-200 rounded-2xl shadow-[0_6px_20px_-12px_rgb(16_24_40/0.18)]";
const today = new Date().toISOString().slice(0, 10);

/** Price lines are stored in Turkish; other languages label them by kind. */
const lineLabel = (line: { kind: string; label: string; qty?: number }) => {
	if (locale === "tr" || line.kind === "extra") return line.qty && line.qty > 1 ? `${line.label} × ${line.qty}` : line.label;
	return t(`book.line.${line.kind}` as UiKey);
};
const when = (iso: string) => {
	const { date, time } = isoToIstanbul(iso);
	const day = new Intl.DateTimeFormat(intl, { dateStyle: "full", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
	return `${day} · ${time}`;
};

// Wizard: the query string of the trip so far, to build each step's links.
const tripQuery = (extra: Record<string, string> = {}) => {
	if (page.view !== "wizard") return "";
	const entries = Object.entries({ ...page.trip, ...extra }).filter(([, v]) => v !== undefined && v !== "") as [string, string][];
	return new URLSearchParams(entries.map(([k, v]) => [k, String(v)])).toString();
};
const steps = [t("book.step1"), t("book.step2"), t("book.step3")];

const title = page.view === "detail" ? t("book.detailTitle", { code: page.booking.code }) : t("book.title");
const path = page.view === "detail" ? `${BOOK_SLUG}/${page.booking.code}` : BOOK_SLUG;
const airports = page.view === "wizard" ? page.zones.filter((z) => z.kind === "airport") : [];
const districts = page.view === "wizard" ? page.zones.filter((z) => z.kind !== "airport") : [];
const addressLabel = page.view === "wizard" && page.quote?.from.kind !== "airport" ? t("book.pickupAddress") : t("book.dropoffAddress");
---

<Base locale={locale} path={path} title={title} description={t("book.lead")} noindex={page.view === "detail" || Astro.url.search.length > 0}>
	<section class="bg-[radial-gradient(900px_320px_at_85%_-20%,rgb(29_95_155/0.45),transparent_70%),linear-gradient(180deg,var(--color-ink-900),var(--color-ink-800))] text-white">
		<div class="container py-10 sm:py-14">
			{
				page.view === "detail" ? (
					<>
						<p class="text-sm font-semibold uppercase tracking-[0.14em] text-gold-300 rtl:tracking-normal">{t("book.reservation")}</p>
						<div class="mt-3 flex flex-wrap items-center gap-4">
							<h1 class="font-display text-3xl sm:text-4xl font-bold tabular-nums" dir="ltr">{page.booking.code}</h1>
							<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/15">
								<span class="size-1.5 rounded-full bg-current" />
								{t(`book.status.${page.booking.status}` as UiKey)}
							</span>
						</div>
						<p class="mt-3 max-w-2xl text-white/70">{t("book.detailLead")}</p>
					</>
				) : (
					<>
						<h1 class="font-display text-3xl sm:text-4xl font-bold">{t("book.title")}</h1>
						<p class="mt-3 max-w-2xl text-white/70">{t("book.lead")}</p>
						<ol class="mt-6 flex flex-wrap gap-2 list-none p-0">
							{steps.map((label, i) => (
								<li
									class:list={[
										"inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-semibold",
										i + 1 === page.step ? "bg-white text-navy-800" : i + 1 < page.step ? "bg-white/20" : "bg-white/5 text-white/60",
									]}
									aria-current={i + 1 === page.step ? "step" : undefined}
								>
									<span class="tabular-nums">{i + 1}</span>
									{label}
								</li>
							))}
						</ol>
					</>
				)
			}
		</div>
	</section>

	<section class="bg-gray-100 py-8 sm:py-12 min-h-[50vh]">
		<div class="container grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-8 items-start">
			<div class="grid gap-6 min-w-0">
				{page.error && <p class="form-status" data-state="error" role="alert">{t(page.error)}</p>}

				{
					page.view === "wizard" && (
						<>
							{/* Step 1: the trip. Always shown, so it can be changed at any step. */}
							<form class:list={[card, "form p-6 sm:p-8"]} method="get" action={bookPath(locale)}>
								<div class="form-row">
									<div class="field">
										<label for="bk-from">{t("quick.from")}</label>
										<select id="bk-from" name="from" required>
											<option value="" disabled selected={!page.trip.from}>{t("form.choose")}</option>
											<optgroup label={t("book.airports")}>
												{airports.map((z) => <option value={z.id} selected={page.trip.from === z.id}>{z.name}</option>)}
											</optgroup>
											<optgroup label={t("book.districts")}>
												{districts.map((z) => <option value={z.id} selected={page.trip.from === z.id}>{z.name}</option>)}
											</optgroup>
										</select>
									</div>
									<div class="field">
										<label for="bk-to">{t("quick.to")}</label>
										<select id="bk-to" name="to" required>
											<option value="" disabled selected={!page.trip.to}>{t("form.choose")}</option>
											<optgroup label={t("book.districts")}>
												{districts.map((z) => <option value={z.id} selected={page.trip.to === z.id}>{z.name}</option>)}
											</optgroup>
											<optgroup label={t("book.airports")}>
												{airports.map((z) => <option value={z.id} selected={page.trip.to === z.id}>{z.name}</option>)}
											</optgroup>
										</select>
									</div>
								</div>
								<div class="form-row">
									<div class="field">
										<label for="bk-date">{t("quick.date")}</label>
										<input id="bk-date" name="date" type="date" required min={today} value={page.trip.date} />
									</div>
									<div class="field">
										<label for="bk-time">{t("quick.time")}</label>
										<input id="bk-time" name="time" type="time" required value={page.trip.time} />
									</div>
									<div class="field">
										<label for="bk-pax">{t("quick.passengers")}</label>
										<input id="bk-pax" name="pax" type="number" min="1" max="60" inputmode="numeric" required value={page.trip.pax} />
									</div>
									<div class="field">
										<label for="bk-bags">{t("form.luggage")}</label>
										<input id="bk-bags" name="bags" type="number" min="0" max="60" inputmode="numeric" required value={page.trip.bags} />
									</div>
								</div>
								<button type="submit" class="btn btn--primary justify-self-start">
									{page.step === 1 ? t("book.showPrices") : t("book.update")}
								</button>
								<small class="text-sm text-gray-600">{t("book.timeHint")}</small>
							</form>

							{/* Step 2: vehicle classes with their fixed price. */}
							{
								page.step === 2 && page.quote && (
									<div class="grid gap-4">
										<h2 class="font-display text-xl font-bold">{t("book.chooseVehicle")}</h2>
										{page.quote.options.length === 0 && (
											<div class:list={[card, "grid gap-4 p-6 sm:p-8"]}>
												<p class="text-gray-700">{t("book.noPrice")}</p>
												<a
													class="btn btn--primary justify-self-start"
													href={`${pagePath(locale, "transfer")}?${new URLSearchParams({ date: page.trip.date ?? "", time: page.trip.time ?? "", passengers: String(page.trip.pax ?? "") })}`}
												>
													{t("book.requestQuote")}
												</a>
											</div>
										)}
										{page.quote.options.map((option) => (
											<div class:list={[card, "grid gap-4 p-5 sm:p-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center", !option.fits && "opacity-60"]}>
												<div class="grid gap-1">
													<h3 class="font-display text-lg font-bold">{option.name}</h3>
													<p class="text-sm text-gray-600">{t("book.capacity", { pax: option.paxMax, bags: option.bagsMax })}</p>
													{!option.fits && <p class="text-sm font-semibold text-[#b42318]">{t("book.tooSmall")}</p>}
												</div>
												<div class="flex items-center justify-between gap-4 sm:flex-col sm:items-end">
													<div class="text-end">
														<div class="font-display text-2xl font-bold text-navy-800 tabular-nums">{money(option.total_minor)}</div>
														<small class="text-xs text-gray-500">≈ {formatApprox(option.total_minor / 100, locale)} · {t("book.perVehicle")}</small>
													</div>
													{option.fits && (
														<a class="btn btn--primary btn--sm" href={`${bookPath(locale)}?${tripQuery({ class: option.classKey })}`}>
															{t("book.select")}
															<Icon name="arrow" size={16} class="flip-rtl" />
														</a>
													)}
												</div>
											</div>
										))}
									</div>
								)
							}

							{/* Step 3: passenger, extras, payment. */}
							{
								page.step === 3 && page.quote && page.option && (
									<form class:list={[card, "form p-6 sm:p-8"]} method="post" action={`${bookPath(locale)}?${tripQuery({ class: page.option.classKey })}`}>
										<p class="fieldset-title">{t("book.passenger")}</p>
										<div class="form-row">
											<div class="field">
												<label for="bk-name">{t("form.name")}</label>
												<input id="bk-name" name="name" required minlength="2" maxlength="80" autocomplete="name" value={page.values.name} />
											</div>
											<div class="field">
												<label for="bk-phone">{t("form.phone")}</label>
												<input id="bk-phone" name="phone" type="tel" required maxlength="24" autocomplete="tel" dir="ltr" placeholder="+90 5xx xxx xx xx" value={page.values.phone} />
											</div>
										</div>
										<div class="form-row">
											<div class="field">
												<label for="bk-email">{t("form.emailOptional")}</label>
												<input id="bk-email" name="email" type="email" maxlength="120" autocomplete="email" dir="ltr" value={page.values.email} />
											</div>
											<div class="field">
												<label for="bk-flight">{t("form.flight")}</label>
												<input id="bk-flight" name="flight" maxlength="12" autocomplete="off" dir="ltr" placeholder="TK 1984" value={page.values.flight} />
											</div>
										</div>
										<div class="form-row">
											<div class="field">
												<label for="bk-address">{addressLabel}</label>
												<input id="bk-address" name="address" maxlength="200" autocomplete="street-address" value={page.values.address} />
											</div>
											<div class="field">
												<label for="bk-sign">{t("book.signName")}</label>
												<input id="bk-sign" name="sign" maxlength="60" value={page.values.sign} />
											</div>
										</div>
										{page.quote.extras.length > 0 && (
											<>
												<p class="fieldset-title">{t("book.extras")}</p>
												<div class="form-row">
													{page.quote.extras.map((extra) => (
														<div class="field">
															<label for={`bk-extra-${extra.key}`}>
																{extra.name} · {extra.price_minor ? money(extra.price_minor) : t("book.free")}
															</label>
															<select id={`bk-extra-${extra.key}`} name={`extra_${extra.key}`}>
																{Array.from({ length: extra.max_qty + 1 }, (_, n) => (
																	<option value={n} selected={String(n) === (page.values[`extra_${extra.key}`] ?? "0")}>{n}</option>
																))}
															</select>
														</div>
													))}
												</div>
											</>
										)}
										<div class="field">
											<label for="bk-notes">{t("form.notes")}</label>
											<textarea id="bk-notes" name="notes" rows="3" maxlength="1000">{page.values.notes}</textarea>
										</div>
										<p class="fieldset-title">{t("book.payment")}</p>
										<div class="grid gap-2">
											{(["cash", "card_in_vehicle"] as const).map((method) => (
												<label class="checkbox">
													<input type="radio" name="payment" value={method} checked={(page.values.payment || "cash") === method} />
													<span>{t(`book.pay.${method}`)}</span>
												</label>
											))}
											<small class="text-sm text-gray-600">{t("book.onlineSoon")}</small>
										</div>
										<div class="hp-field" aria-hidden="true">
											<label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
										</div>
										<label class="checkbox">
											<input type="checkbox" name="terms" required />
											<span>
												<a href={localizePath(locale, "mesafeli-satis-sozlesmesi")} target="_blank">{t("book.termsLink")}</a> · <a href={localizePath(locale, "iptal-ve-iade")} target="_blank">{t("book.cancelLink")}</a> — {t("book.terms")}
											</span>
										</label>
										{!page.member && (
											<p class="text-sm text-gray-600">
												<a class="underline" href={accountPath(locale, "giris")}>{t("account.loginButton")}</a> · {t("book.loginHint")}
											</p>
										)}
										<button type="submit" class="btn btn--primary btn--block">
											{t("book.confirm")} · {money(page.option.total_minor)}
										</button>
									</form>
								)
							}
						</>
					)
				}

				{
					page.view === "detail" && (
						<>
							{page.notice && (
								<p class="form-status" data-state="success" role="status">
									{page.notice === "created" ? t("book.created", { code: page.booking.code }) : t("book.cancelled")}
								</p>
							)}
							<div class:list={[card, "grid gap-5 p-6 sm:p-8"]}>
								<ol class="grid gap-3 list-none p-0">
									<li class="flex items-center gap-3 font-semibold">
										<span class="size-3 shrink-0 rounded-full border-2 border-solid border-navy-700 bg-white" />
										{page.fromName}
										{page.booking.pickup_address && <span class="font-normal text-gray-600">· {page.booking.pickup_address}</span>}
									</li>
									<li class="flex items-center gap-3 font-semibold">
										<span class="size-3 shrink-0 rounded-full bg-navy-700" />
										{page.toName}
										{page.booking.dropoff_address && <span class="font-normal text-gray-600">· {page.booking.dropoff_address}</span>}
									</li>
								</ol>
								<dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2 text-sm">
									<div><dt class="text-gray-500">{t("book.pickupTime")}</dt><dd class="font-semibold">{when(page.booking.pickup_at)}</dd></div>
									<div><dt class="text-gray-500">{t("form.vehicle")}</dt><dd class="font-semibold">{page.className}</dd></div>
									<div><dt class="text-gray-500">{t("quick.passengers")} / {t("form.luggage")}</dt><dd class="font-semibold">{page.booking.pax} / {page.booking.bags}</dd></div>
									{page.booking.flight_no && <div><dt class="text-gray-500">{t("form.flight")}</dt><dd class="font-semibold" dir="ltr">{page.booking.flight_no}</dd></div>}
									<div><dt class="text-gray-500">{t("form.name")}</dt><dd class="font-semibold">{page.booking.contact_name}</dd></div>
									{page.booking.sign_name && <div><dt class="text-gray-500">{t("book.signName")}</dt><dd class="font-semibold">{page.booking.sign_name}</dd></div>}
								</dl>
							</div>

							<div class:list={[card, "grid gap-3 p-6 sm:p-8"]}>
								<h2 class="font-display text-lg font-bold">{t("book.driver")}</h2>
								{page.driver && page.booking.status !== "cancelled" ? (
									<p>
										<strong>{page.driver.name}</strong>
										{page.driver.vehicle && <> · {page.driver.vehicle}</>}
										{page.driver.plate && <> · <span dir="ltr">{page.driver.plate}</span></>}
										<br />
										<a class="underline" href={`tel:${page.driver.phone.replace(/[^\d+]/g, "")}`} dir="ltr">{page.driver.phone}</a>
									</p>
								) : (
									<p class="text-gray-600">{t("book.driverPending")}</p>
								)}
							</div>

							{["pending_payment", "confirmed", "assigned"].includes(page.booking.status) && (
								<div class:list={[card, "grid gap-3 p-6 sm:p-8"]}>
									<h2 class="font-display text-lg font-bold">{t("book.cancel")}</h2>
									{page.canCancel ? (
										<form method="post" class="grid gap-3">
											<input type="hidden" name="intent" value="cancel" />
											<p class="text-sm text-gray-600">{t("book.cancelFree", { h: page.freeCancelHours })}</p>
											<button type="submit" class="btn btn--ghost justify-self-start">{t("book.cancel")}</button>
										</form>
									) : (
										<p class="text-sm text-gray-600">{t("book.cancelClosed")}</p>
									)}
								</div>
							)}
						</>
					)
				}
			</div>

			<aside class="grid gap-6 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]">
				{
					((page.view === "wizard" && page.option) || page.view === "detail") && (
						<div class:list={[card, "grid gap-3 p-6"]}>
							<h2 class="font-display text-lg font-bold">{t("book.summary")}</h2>
							{page.view === "wizard" && page.quote && (
								<p class="text-sm text-gray-600">
									{page.quote.from.name} → {page.quote.to.name}
									<br />
									{when(page.quote.pickupAt)}
								</p>
							)}
							<ul class="grid gap-2 list-none p-0 text-sm">
								{(page.view === "wizard" ? page.option!.lines : page.lines).map((line) => (
									<li class="flex justify-between gap-3">
										<span>{lineLabel(line)}</span>
										<span class="tabular-nums">{line.amount_minor ? money(line.amount_minor) : t("book.free")}</span>
									</li>
								))}
							</ul>
							<div class="flex justify-between gap-3 pt-3 border-0 border-t border-solid border-gray-200 font-bold">
								<span>{t("book.total")}</span>
								<span class="tabular-nums">{money(page.view === "wizard" ? page.option!.total_minor : page.booking.price_minor)}</span>
							</div>
							{page.view === "detail" && (
								<p class="text-sm text-gray-600">
									{t(`book.pay.${page.booking.payment_method}` as UiKey)} · {t(`book.paymentStatus.${page.booking.payment_status}` as UiKey)}
								</p>
							)}
						</div>
					)
				}
				<div class:list={[card, "grid gap-3 p-6"]}>
					<p class="font-semibold">{t("common.callUs")}</p>
					<a href={telHref} class="btn btn--ghost btn--block" dir="ltr"><Icon name="phone" size={18} />{SITE.phoneDisplay}</a>
					<a href={whatsappHref()} class="btn btn--ghost btn--block" target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />WhatsApp</a>
				</div>
			</aside>
		</div>
	</section>
</Base>
