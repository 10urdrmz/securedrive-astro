---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import TrustStrip from "../components/sections/TrustStrip.astro";
import ServiceCard from "../components/sections/ServiceCard.astro";
import VehicleCard from "../components/sections/VehicleCard.astro";
import RouteCard from "../components/sections/RouteCard.astro";
import HowSteps from "../components/sections/HowSteps.astro";
import FaqList from "../components/sections/FaqList.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import { bookPath, pagePath, type Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { byOrder, getLocalized, getLocalizedEntry, slugOf } from "../lib/content";
import { airportName } from "../lib/routes";
import { businessJsonLd, faqJsonLd } from "../lib/schema";
import { ISTANBUL_DISTRICTS } from "../server/db/catalog";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const [home, services, vehicles, routes, faqs] = await Promise.all([
	getLocalizedEntry(Astro, "pages", "home", locale),
	getLocalized(Astro, "services", locale),
	getLocalized(Astro, "vehicles", locale),
	getLocalized(Astro, "routes", locale),
	getLocalized(Astro, "faqs", locale),
]);

const headline = home?.data.headline || t("hero.title");
const subtitle = home?.data.summary || t("hero.subtitle");
const homeServices = services.sort(byOrder).slice(0, 6);
const featuredRoutes = routes.filter((r) => r.data.featured).slice(0, 6);
const featuredFaqs = faqs
	.filter((f) => f.data.featured)
	.sort(byOrder)
	.map((f) => ({ question: f.data.question, answer: f.data.answer }));
const today = new Date().toISOString().slice(0, 10);
---

<Base
	locale={locale}
	path=""
	description={subtitle}
	overlayHeader
	jsonLd={[businessJsonLd(locale, t("meta.defaultDescription")), ...(featuredFaqs.length ? [faqJsonLd(featuredFaqs)] : [])]}
>
	<section class="hero">
		<img
			class="hero-bg"
			src="/images/fleet/vito-vip.webp"
			srcset="/images/fleet/vito-vip-sm.webp 688w, /images/fleet/vito-vip.webp 1376w"
			sizes="100vw"
			alt=""
			width="1376"
			height="768"
			fetchpriority="high"
		/>
		<div class="container hero-inner">
			<div class="hero-copy">
				<p class="eyebrow">{t("hero.eyebrow")}</p>
				<h1>{headline}</h1>
				<p class="hero-lead">{subtitle}</p>
			</div>

			<form class="quick" action={bookPath(locale)} method="get">
				<div class="quick-head">
					<h2>{t("quick.title")}</h2>
					<span class="live-pill">
						<span class="live-dot" aria-hidden="true"></span>
						{t("quick.live")}
					</span>
					<p class="quick-lead">{t("quick.lead")}</p>
				</div>
				<div class="quick-bar">
					<div class="field cell cell--from">
						<label for="q-from">{t("quick.from")}</label>
						<select id="q-from" name="from" required>
							<option value="">{t("form.choose")}</option>
							<optgroup label={t("quick.airports")}>
								{(["IST", "SAW"] as const).map((code) => <option value={code.toLowerCase()}>{airportName(code, locale)}</option>)}
							</optgroup>
							<optgroup label={t("quick.districts")}>
								{ISTANBUL_DISTRICTS.filter((d) => d.serviceable).map((d) => <option value={d.id}>{d.name}</option>)}
							</optgroup>
						</select>
					</div>
					<button type="button" class="swap" data-swap aria-label={t("quick.swap")} title={t("quick.swap")}>
						<Icon name="swap" size={18} />
					</button>
					<div class="field cell cell--to">
						<label for="q-to">{t("quick.to")}</label>
						<select id="q-to" name="to" required>
							<option value="">{t("form.choose")}</option>
							<optgroup label={t("quick.districts")}>
								{ISTANBUL_DISTRICTS.filter((d) => d.serviceable).map((d) => <option value={d.id}>{d.name}</option>)}
							</optgroup>
							<optgroup label={t("quick.airports")}>
								{(["IST", "SAW"] as const).map((code) => <option value={code.toLowerCase()}>{airportName(code, locale)}</option>)}
							</optgroup>
						</select>
					</div>
					<div class="field cell cell--date">
						<label for="q-date">{t("quick.date")}</label>
						<input id="q-date" name="date" type="date" min={today} value={today} required />
					</div>
					<div class="field cell cell--time">
						<label for="q-time">{t("quick.time")}</label>
						<input id="q-time" name="time" type="time" required />
					</div>
					<div class="field cell cell--pax">
						<label for="q-pax">{t("quick.passengers")}</label>
						<input id="q-pax" name="pax" type="number" min="1" max="60" value="2" inputmode="numeric" required />
					</div>
					<div class="field cell cell--bags">
						<label for="q-bags">{t("form.luggage")}</label>
						<input id="q-bags" name="bags" type="number" min="0" max="60" value="2" inputmode="numeric" required />
					</div>
					<button type="submit" class="btn btn--primary quick-submit">
						{t("quick.submit")}
						<Icon name="arrow" size={18} class="flip-rtl" />
					</button>
				</div>
				<ul class="perks">
					{[t("perk.freeCancel"), t("perk.verified"), t("perk.wait60"), t("perk.firmPrice")].map((perk) => (
						<li>
							<span class="perk-tick" aria-hidden="true"><Icon name="tick" size={12} /></span>
							{perk}
						</li>
					))}
				</ul>
			</form>
		</div>
	</section>

	<section class="section trust-section">
		<div class="container">
			<TrustStrip locale={locale} />
		</div>
	</section>

	<section class="section section--surface" aria-labelledby="services-title">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">SecureDrive</p>
					<h2 class="section-title" id="services-title">{t("section.services")}</h2>
					<p class="section-lead">{t("section.servicesLead")}</p>
				</div>
				<a href={pagePath(locale, "services")} class="link-arrow">{t("common.viewAll")} <Icon name="arrow" size={16} class="flip-rtl" /></a>
			</div>
			<div class="grid grid--3">
				{
					homeServices.map((s) => (
						<ServiceCard
							maxFeatures={3}
							href={pagePath(locale, "services", slugOf(s))}
							title={s.data.title}
							summary={s.data.summary}
							badge={s.data.badge}
							icon={s.data.icon}
							features={s.data.features}
						/>
					))
				}
				{
					homeServices.length % 3 !== 0 && (
						<a href={pagePath(locale, "services")} class="card all-services">
							<span class="all-services-title">{t("home.allServices")}</span>
							<span class="all-services-text">{t("home.allServicesText")}</span>
							<span class="all-services-arrow" aria-hidden="true"><Icon name="arrow" size={20} class="flip-rtl" /></span>
						</a>
					)
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="fleet-title">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Mercedes-Benz</p>
					<h2 class="section-title" id="fleet-title">{t("section.fleet")}</h2>
					<p class="section-lead">{t("section.fleetLead")}</p>
				</div>
				<a href={pagePath(locale, "fleet")} class="link-arrow">{t("common.viewAll")} <Icon name="arrow" size={16} class="flip-rtl" /></a>
			</div>
			<div class="grid grid--2">
				{
					vehicles.sort(byOrder).map((v) => (
						<VehicleCard
							locale={locale}
							href={pagePath(locale, "fleet", slugOf(v))}
							name={v.data.name}
							classLabel={v.data.class_label}
							summary={v.data.summary}
							seats={v.data.seats}
							luggage={v.data.luggage}
							image={v.data.image}
							fallback={v.data.fallback_image}
						/>
					))
				}
			</div>
		</div>
	</section>

	{
		featuredRoutes.length > 0 && (
			<section class="section section--surface" aria-labelledby="routes-title">
				<div class="container">
					<div class="section-head">
						<div>
							<p class="eyebrow">IST · SAW</p>
							<h2 class="section-title" id="routes-title">{t("section.routes")}</h2>
							<p class="section-lead">{t("section.routesLead")}</p>
						</div>
						<a href={pagePath(locale, "routes")} class="link-arrow">{t("common.viewAll")} <Icon name="arrow" size={16} class="flip-rtl" /></a>
					</div>
					<div class="grid grid--3">
						{featuredRoutes.map((r) => (
							<RouteCard
								locale={locale}
								href={pagePath(locale, "routes", slugOf(r))}
								origin={r.data.origin}
								destination={r.data.destination}
								distanceKm={r.data.distance_km}
								durationMin={r.data.duration_min}
								badge={r.data.badge}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section section--dark" aria-labelledby="how-title">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">{t("nav.how")}</p>
					<h2 class="section-title" id="how-title">{t("section.howLead")}</h2>
				</div>
			</div>
			<HowSteps locale={locale} />
		</div>
	</section>

	<section class="section corporate" aria-labelledby="corp-title">
		<div class="container corporate-inner">
			<div class="corporate-media reveal">
				<img src="/images/fleet/sprinter-vip-sm.webp" alt="" width="688" height="384" loading="lazy" />
			</div>
			<div class="reveal">
				<p class="eyebrow">B2B</p>
				<h2 class="section-title" id="corp-title">{t("section.corporate")}</h2>
				<p class="section-lead">{t("section.corporateLead")}</p>
				<a href={pagePath(locale, "corporate")} class="btn btn--primary corporate-cta">{t("corporate.formTitle")}</a>
			</div>
		</div>
	</section>

	{
		featuredFaqs.length > 0 && (
			<section class="section section--surface" aria-labelledby="faq-title">
				<div class="container faq-layout">
					<div>
						<p class="eyebrow">{t("nav.faq")}</p>
						<h2 class="section-title" id="faq-title">{t("section.faq")}</h2>
						<p class="section-lead">{t("section.faqLead")}</p>
						<a href={pagePath(locale, "faq")} class="link-arrow faq-more">{t("common.viewAll")} <Icon name="arrow" size={16} class="flip-rtl" /></a>
					</div>
					<FaqList items={featuredFaqs} />
				</div>
			</section>
		)
	}

	<CtaBand locale={locale} />
	<script is:inline>
		// Swap pickup and destination; both lists carry airports and districts.
		document.querySelector("[data-swap]")?.addEventListener("click", () => {
			const from = document.getElementById("q-from");
			const to = document.getElementById("q-to");
			if (!from || !to) return;
			[from.value, to.value] = [to.value, from.value];
		});
	</script>
</Base>

<style>
	.hero {
		position: relative;
		min-height: min(100svh, 920px);
		display: flex;
		align-items: center;
		color: #fff;
		background: var(--ink-950);
		overflow: hidden;
		padding-block: calc(var(--header-h) + var(--space-12)) var(--space-16);
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 35% 60%;
		opacity: 0.75;
	}

	.hero::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgb(11 13 16 / 0.92) 0%, rgb(11 13 16 / 0.7) 45%, rgb(11 13 16 / 0.35) 100%),
			linear-gradient(0deg, rgb(11 13 16 / 0.85) 0%, transparent 35%);
	}

	:global([dir="rtl"]) .hero::after {
		background:
			linear-gradient(270deg, rgb(11 13 16 / 0.92) 0%, rgb(11 13 16 / 0.7) 45%, rgb(11 13 16 / 0.35) 100%),
			linear-gradient(0deg, rgb(11 13 16 / 0.85) 0%, transparent 35%);
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		display: grid;
		gap: var(--space-10, 2.5rem);
	}

	.hero h1 {
		font-size: var(--text-4xl);
		max-width: 18ch;
	}

	.hero-lead {
		margin-top: var(--space-5);
		font-size: var(--text-lg);
		color: #c9d1da;
		max-width: 60ch;
	}

	/* Horizontal search: one white bar, fields split by hairlines. */
	.quick {
		display: grid;
		gap: var(--space-4);
	}

	.quick-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-3);
	}

	.quick h2 {
		font-size: var(--text-lg);
		margin: 0;
		color: #fff;
	}

	.quick-lead {
		flex-basis: 100%;
		margin: 0;
		font-size: var(--text-sm);
		color: #c9d1da;
	}

	.live-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		flex-shrink: 0;
		padding: 2px 10px;
		border-radius: 999px;
		background: rgb(16 185 129 / 0.16);
		color: #6ee7b7;
		font-size: var(--text-xs);
		font-weight: 600;
		white-space: nowrap;
	}

	.live-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #10b981;
		animation: live-pulse 1.6s ease-in-out infinite;
	}

	@keyframes live-pulse {
		50% {
			opacity: 0.35;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.live-dot {
			animation: none;
		}
	}

	.quick-bar {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) auto minmax(0, 1.4fr) minmax(0, 1.05fr) minmax(0, 0.8fr) minmax(0, 0.55fr) minmax(0, 0.55fr) auto;
		align-items: stretch;
		padding: var(--space-2);
		background: #fff;
		color: var(--ink-900);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
	}

	.cell {
		display: grid;
		align-content: center;
		gap: 2px;
		min-width: 0;
		margin: 0;
		padding: var(--space-2) var(--space-4);
		border-inline-start: 1px solid var(--color-border);
	}

	.cell--from,
	.cell--to {
		border-inline-start: 0;
	}

	.cell label {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--color-muted);
	}

	.cell select,
	.cell input {
		width: 100%;
		min-width: 0;
		min-height: 0;
		padding: 2px 0;
		border: 0;
		border-radius: 0;
		background-color: transparent;
		box-shadow: none;
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--ink-900);
	}

	.cell select {
		padding-inline-end: 1.25rem;
		background-position: right 0 center;
	}

	:global([dir="rtl"]) .cell select {
		background-position: left 0 center;
	}

	.cell select:focus,
	.cell input:focus {
		outline: none;
		box-shadow: none;
	}

	.cell:focus-within {
		border-radius: var(--radius-md, 10px);
		background: var(--gray-50, #f6f7f9);
	}

	.swap {
		align-self: center;
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		background: #fff;
		color: var(--navy-700, #1e4f86);
		cursor: pointer;
		rotate: 90deg;
		transition: transform 0.2s var(--ease, ease);
	}

	.swap:hover {
		transform: rotate(180deg);
	}

	.swap:focus-visible {
		outline: 2px solid var(--navy-700, #1e4f86);
		outline-offset: 2px;
	}

	.quick-submit {
		margin-inline-start: var(--space-2);
		white-space: nowrap;
		border-radius: calc(var(--radius-lg) - 4px);
	}

	.perks {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-6);
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-sm);
		color: #dbe2ea;
	}

	.perks li {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.perk-tick {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: rgb(16 185 129 / 0.18);
		color: #6ee7b7;
	}

	/* Mid widths: route on the first row, trip details on the second, the button below. */
	@media (max-width: 1100px) {
		.quick-bar {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			row-gap: var(--space-2);
		}

		.cell--from {
			grid-column: 1 / 3;
			grid-row: 1;
			padding-inline-end: 2.5rem;
		}

		.cell--to {
			grid-column: 3 / 5;
			grid-row: 1;
			padding-inline-start: 2.5rem;
		}

		.swap {
			grid-column: 2 / 4;
			grid-row: 1;
			justify-self: center;
			z-index: 1;
		}

		.cell--date,
		.cell--time,
		.cell--pax,
		.cell--bags {
			grid-row: 2;
			border-top: 1px solid var(--color-border);
		}

		.cell--date {
			border-inline-start: 0;
		}

		.quick-submit {
			grid-column: 1 / -1;
			grid-row: 3;
			margin: 0;
			justify-content: center;
		}
	}

	.all-services {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: var(--space-3);
		min-height: 220px;
		padding: var(--space-8);
		color: #fff;
		text-decoration: none;
		background:
			linear-gradient(160deg, rgb(11 13 16 / 0.35), rgb(11 13 16 / 0.92)),
			url("/images/fleet/vito-vip-studio-sm.webp") center / cover,
			var(--ink-900);
		border: 0;
	}

	.all-services-title {
		font-size: var(--text-xl);
		font-weight: 700;
	}

	.all-services-text {
		color: #c9d1da;
		font-size: var(--text-sm);
		max-width: 36ch;
	}

	.all-services-arrow {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: #fff;
		color: var(--ink-900);
		transition: transform 0.2s var(--ease, ease);
	}

	.all-services:hover .all-services-arrow {
		transform: translateX(4px);
	}

	.trust-section {
		padding-block: var(--space-12);
		border-bottom: 1px solid var(--color-border);
	}

	.corporate-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 1rem + 4vw, 5rem);
		align-items: center;
	}

	.corporate-media img {
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		width: 100%;
	}

	.corporate-cta {
		margin-top: var(--space-8);
	}

	.faq-layout {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(2rem, 1rem + 4vw, 5rem);
		align-items: start;
	}

	.faq-more {
		margin-top: var(--space-6);
	}

	@media (max-width: 900px) {
		.hero-inner,
		.corporate-inner,
		.faq-layout {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: auto;
			padding-block: calc(var(--header-h) + var(--space-8)) var(--space-10, 2.5rem);
		}

		.hero-lead {
			font-size: var(--text-base);
		}

		/* Phones: one field per row; the swap button sits between pickup and destination. */
		.quick-bar {
			grid-template-columns: 1fr 1fr;
			padding: var(--space-3);
		}

		.cell,
		.cell--from,
		.cell--to,
		.cell--date,
		.cell--time,
		.cell--pax,
		.cell--bags {
			grid-column: auto;
			grid-row: auto;
			padding-inline: var(--space-4);
			border-inline-start: 0;
			border-top: 1px solid var(--color-border);
		}

		.cell--from {
			grid-column: 1 / -1;
			border-top: 0;
		}

		.swap {
			grid-column: 1 / -1;
			grid-row: auto;
			justify-self: end;
			margin-block: -17px;
			position: relative;
			rotate: 0deg;
		}

		.cell--to {
			grid-column: 1 / -1;
		}

		.quick-submit {
			grid-column: 1 / -1;
			grid-row: auto;
			margin-top: var(--space-2);
			justify-content: center;
		}
	}

</style>
