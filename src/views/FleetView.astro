---
import Base from "../layouts/Base.astro";
import PageHero from "../components/sections/PageHero.astro";
import VehicleCard from "../components/sections/VehicleCard.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import { pagePath, PAGE_SLUGS, type Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { byOrder, getLocalized, slugOf } from "../lib/content";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const vehicles = (await getLocalized(Astro, "vehicles", locale)).sort(byOrder);
---

<Base locale={locale} path={PAGE_SLUGS.fleet} title={t("section.fleet")} description={t("section.fleetLead")}>
	<PageHero locale={locale} title={t("section.fleet")} lead={t("section.fleetLead")} eyebrow="Mercedes-Benz" />

	<section class="section">
		<div class="container">
			{vehicles.length === 0 && <p>{t("common.empty")}</p>}
			<div class="grid grid--2">
				{
					vehicles.map((v) => (
						<VehicleCard
							locale={locale}
							href={pagePath(locale, "fleet", slugOf(v))}
							name={v.data.name}
							classLabel={v.data.class_label}
							summary={v.data.summary}
							seats={v.data.seats}
							luggage={v.data.luggage}
							image={v.data.image}
							fallback={v.data.fallback_image}
						/>
					))
				}
			</div>
		</div>
	</section>

	<CtaBand locale={locale} />
</Base>
