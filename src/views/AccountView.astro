---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/sections/PageHero.astro";
import StatusBadge from "../components/account/StatusBadge.astro";
import { ACCOUNT_SLUG, LOCALE_META, accountPath, localizePath, bookPath, lookupPath, trackPath, type AccountAction } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import type { AccountPage } from "../lib/account-page";
import { PASSWORD_MAX, PASSWORD_MIN } from "../lib/members";
import { presentRequest } from "../lib/requests-view";
import { formatTry } from "../lib/format";
import { isoToIstanbul } from "../server/pricing";
import type { UiKey } from "../i18n/ui";

type Props = AccountPage;

const { view, locale, member, requests, bookings, error, errorForm, notice, values } = Astro.props;
const t = useTranslations(locale);

const ACTIONS: Record<AccountPage["view"], AccountAction> = {
	account: "",
	profile: "profil",
	security: "guvenlik",
	login: "giris",
	register: "uye-ol",
};
const action = ACTIONS[view];
const path = [ACCOUNT_SLUG, action].filter(Boolean).join("/");
const guest = view === "login" || view === "register";
const title = view === "login" ? t("account.loginTitle") : view === "register" ? t("account.registerTitle") : t("account.title");
const lead = view === "login" ? t("account.loginLead") : view === "register" ? t("account.registerLead") : undefined;

const since = member ? new Date(member.created_at).toLocaleDateString(LOCALE_META[locale].intl, { dateStyle: "long" }) : "";
const profile = { name: member?.name, email: member?.email, phone: member?.phone ?? "", ...(errorForm === "profile" ? values : {}) };
const password = { minlength: PASSWORD_MIN, maxlength: PASSWORD_MAX, required: true } as const;

const trips = requests.map((request) => presentRequest(request, locale));
const openRequests = trips.filter((trip) => trip.status !== "booked" && trip.status !== "closed");

// Online bookings split into what is still ahead and what is done; the nearest one is featured.
const FINAL = ["completed", "cancelled", "no_show"];
const ahead = bookings.filter((b) => !FINAL.includes(b.status)).sort((a, b) => a.pickupAt.localeCompare(b.pickupAt));
const past = bookings.filter((b) => FINAL.includes(b.status));
const [next, ...upcoming] = ahead;
const stats = [
	{ label: t("account.stats.upcoming"), value: ahead.length, icon: "calendar" },
	{ label: t("account.stats.completed"), value: past.filter((b) => b.status === "completed").length, icon: "check" },
	{ label: t("account.stats.requests"), value: openRequests.length, icon: "route" },
] as const;

const intl = LOCALE_META[locale].intl;
const parts = (iso: string) => {
	const date = new Date(iso);
	const f = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(intl, { timeZone: "Europe/Istanbul", ...o }).format(date);
	return { day: f({ day: "numeric" }), month: f({ month: "short" }), weekday: f({ weekday: "short" }), time: isoToIstanbul(iso).time, long: f({ weekday: "long", day: "numeric", month: "long" }) };
};
/** Status colours: waiting on the passenger amber, on its way green, done grey. */
const tone = (status: string) =>
	["quoted", "bidding", "pending_payment"].includes(status)
		? "bg-[#fffaeb] text-[#b54708]"
		: ["driver_en_route", "driver_arrived", "on_board"].includes(status)
			? "bg-[#ecfdf3] text-[#05603a]"
			: status === "completed"
				? "bg-gray-100 text-gray-700"
				: ["cancelled", "no_show"].includes(status)
					? "bg-gray-100 text-gray-500"
					: "bg-navy-50 text-navy-700";
const needsAction = (status: string) => status === "quoted" || status === "bidding" || status === "pending_payment";
const tabs = [
	{ view: "account", action: "", label: t("account.nav.trips"), icon: "route" },
	{ view: "profile", action: "profil", label: t("account.nav.profile"), icon: "user" },
	{ view: "security", action: "guvenlik", label: t("account.nav.security"), icon: "shield" },
] as const;
const initials = (member?.name ?? "")
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((word) => word[0]!.toLocaleUpperCase(LOCALE_META[locale].intl))
	.join("");

const card = "bg-white border border-solid border-gray-200 rounded-2xl shadow-[0_6px_20px_-12px_rgb(16_24_40/0.18)]";
---

<Base locale={locale} path={path} title={title} description={lead} noindex>
	{guest && <PageHero locale={locale} title={title} lead={lead} />}

	{
		guest && (
			<section class="section">
				<div class="container guest">
				{
					view === "login" && (
						<div class="panel">
							<form class="form" method="post" action={accountPath(locale, "giris")}>
								{error && <p class="form-status" data-state="error" role="alert">{t(error)}</p>}
								{values.next && <input type="hidden" name="next" value={values.next} />}
								<div class="field">
									<label for="login-identifier">{t("account.identifier")}</label>
									<input id="login-identifier" name="identifier" required autocomplete="username" autocapitalize="none" spellcheck="false" dir="ltr" value={values.identifier} />
								</div>
								<div class="field">
									<label for="login-password">{t("account.password")}</label>
									<input id="login-password" name="password" type="password" required autocomplete="current-password" maxlength={PASSWORD_MAX} dir="ltr" />
								</div>
								<button type="submit" class="btn btn--primary btn--block">{t("account.loginButton")}</button>
							</form>
							<p class="switch">
								{t("account.noAccount")} <a href={accountPath(locale, "uye-ol")}>{t("account.registerTitle")}</a>
							</p>
						</div>
					)
				}

				{
					view === "register" && (
						<div class="panel">
							<form class="form" method="post" action={accountPath(locale, "uye-ol")}>
								{error && <p class="form-status" data-state="error" role="alert">{t(error)}</p>}
								<div class="form-row">
									<div class="field">
										<label for="reg-name">{t("form.name")}</label>
										<input id="reg-name" name="name" required minlength="2" maxlength="80" autocomplete="name" value={values.name} />
									</div>
									<div class="field">
										<label for="reg-username">{t("account.username")}</label>
										<input id="reg-username" name="username" required minlength="3" maxlength="24" pattern="[A-Za-z0-9][A-Za-z0-9._\-]+[A-Za-z0-9]" autocomplete="username" autocapitalize="none" spellcheck="false" dir="ltr" aria-describedby="reg-username-hint" value={values.username} />
										<small id="reg-username-hint">{t("account.usernameHint")}</small>
									</div>
								</div>
								<div class="form-row">
									<div class="field">
										<label for="reg-email">{t("form.email")}</label>
										<input id="reg-email" name="email" type="email" required maxlength="120" autocomplete="email" dir="ltr" value={values.email} />
									</div>
									<div class="field">
										<label for="reg-phone">{t("form.phone")}</label>
										<input id="reg-phone" name="phone" type="tel" maxlength="24" autocomplete="tel" dir="ltr" placeholder="+90 5xx xxx xx xx" value={values.phone} />
									</div>
								</div>
								<div class="form-row">
									<div class="field">
										<label for="reg-password">{t("account.password")}</label>
										<input id="reg-password" name="password" type="password" autocomplete="new-password" dir="ltr" aria-describedby="reg-password-hint" {...password} />
										<small id="reg-password-hint">{t("account.passwordHint", { n: PASSWORD_MIN })}</small>
									</div>
									<div class="field">
										<label for="reg-password-repeat">{t("account.passwordRepeat")}</label>
										<input id="reg-password-repeat" name="password_repeat" type="password" autocomplete="new-password" dir="ltr" {...password} />
									</div>
								</div>
								<div class="hp-field" aria-hidden="true">
									<label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
								</div>
								<label class="checkbox">
									<input type="checkbox" name="consent" required />
									<span>{t("account.consent")} <a href={localizePath(locale, "kvkk")} target="_blank">{t("form.consentLink")}</a></span>
								</label>
								<button type="submit" class="btn btn--primary btn--block">{t("account.registerButton")}</button>
							</form>
							<p class="switch">
								{t("account.haveAccount")} <a href={accountPath(locale, "giris")}>{t("account.loginButton")}</a>
							</p>
						</div>
					)
				}
				</div>
			</section>
		)
	}

	{
		!guest && member && (
			<>
				<section class="bg-[radial-gradient(900px_320px_at_85%_-20%,rgb(29_95_155/0.45),transparent_70%),linear-gradient(180deg,var(--color-ink-900),var(--color-ink-800))] text-white">
					<div class="container flex items-center gap-4 py-6 sm:py-8">
						<span class="grid place-items-center size-12 sm:size-14 shrink-0 rounded-full bg-white/10 border border-solid border-white/20 font-display text-lg font-bold">
							{initials}
						</span>
						<div class="flex-1 min-w-0">
							<h1 class="font-display text-xl sm:text-2xl font-bold leading-tight truncate">{t("account.hello", { name: member.name })}</h1>
							<p class="mt-0.5 text-sm text-white/65 truncate">
								<span dir="ltr">@{member.username}</span> · {t("account.memberSince")} {since}
							</p>
						</div>
						<a href={bookPath(locale)} class="btn btn--light hidden sm:inline-flex">
							{t("nav.book")}
							<Icon name="arrow" size={18} class="flip-rtl" />
						</a>
						<form method="post" action={accountPath(locale)} class="shrink-0">
							<input type="hidden" name="intent" value="logout" />
							<button
								type="submit"
								aria-label={t("account.logout")}
								class="inline-flex items-center gap-2 p-2.5 sm:px-3.5 sm:py-2 border border-solid border-white/25 rounded-full bg-transparent text-white/85 text-sm font-semibold cursor-pointer hover:bg-white/10"
							>
								<Icon name="logout" size={16} class="flip-rtl" />
								<span class="hidden sm:inline">{t("account.logout")}</span>
							</button>
						</form>
					</div>
				</section>

				<section class="bg-gray-100 pt-4 pb-24 sm:py-10 min-h-[50vh]">
					<div class="container grid grid-cols-[minmax(0,1fr)] gap-5 lg:grid-cols-[230px_minmax(0,1fr)] lg:gap-8 items-start">
						<nav class:list={[card, "min-w-0 p-1.5 lg:p-2 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]"]} aria-label={t("account.title")}>
							<ul class="grid grid-cols-3 lg:grid-cols-1 gap-1 list-none p-0">
								{
									tabs.map((tab) => (
										<li class="min-w-0">
											<a
												href={accountPath(locale, tab.action)}
												aria-current={tab.view === view ? "page" : undefined}
												class="flex flex-col lg:flex-row items-center justify-center lg:justify-start gap-1 lg:gap-3 px-2 lg:px-4 py-2.5 lg:py-3 rounded-xl text-xs lg:text-sm font-semibold text-gray-600 text-center transition-colors hover:bg-gray-100 aria-[current=page]:bg-navy-700 aria-[current=page]:text-white"
											>
												<Icon name={tab.icon} size={18} />
												<span class="truncate max-w-full">{tab.label}</span>
											</a>
										</li>
									))
								}
							</ul>
						</nav>

						<div class="grid gap-5 sm:gap-6 min-w-0">
							{notice && <p class="form-status" data-state="success" role="status">{t(`account.notice.${notice}`)}</p>}

							{
								view === "account" && (
									<>
										{next && (() => {
											const d = parts(next.pickupAt);
											return (
												<a
													href={bookPath(locale, next.code, next.token)}
													class="group block rounded-2xl overflow-hidden bg-navy-800 text-white no-underline shadow-[0_18px_40px_-20px_rgb(10_37_64/0.6)]"
												>
													<div class="flex items-center justify-between gap-3 px-5 sm:px-6 pt-5">
														<span class="text-xs font-semibold uppercase tracking-wider text-white/60">{t("account.next")}</span>
														<span class:list={["inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap", tone(next.status)]}>
															<span class="size-1.5 rounded-full bg-current" />
															{t(`book.status.${next.status}` as UiKey)}
														</span>
													</div>
													<div class="grid gap-5 px-5 sm:px-6 py-5 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-center">
														<div class="flex items-baseline gap-3">
															<span class="font-display text-4xl font-bold tabular-nums" dir="ltr">{d.time}</span>
															<span class="text-white/75 font-semibold">{d.long}</span>
														</div>
														<ol class="grid gap-2.5 list-none p-0 sm:ps-6 sm:border-0 sm:border-s sm:border-solid sm:border-white/15">
															<li class="flex items-center gap-3 font-semibold">
																<span class="size-2.5 shrink-0 rounded-full border-2 border-solid border-white" />
																{next.fromName}
															</li>
															<li class="flex items-center gap-3 font-semibold">
																<span class="size-2.5 shrink-0 rounded-full bg-gold-300" />
																{next.toName}
															</li>
														</ol>
														<span class="btn btn--light justify-self-start sm:justify-self-end">
															{t("account.openTrip")}
															<Icon name="arrow" size={18} class="flip-rtl" />
														</span>
													</div>
													<div class="flex flex-wrap items-center justify-between gap-2 px-5 sm:px-6 py-3 bg-black/20 text-sm text-white/70">
														<span dir="ltr" class="font-semibold tabular-nums">{next.code}</span>
														{needsAction(next.status) ? (
															<span class="font-semibold text-gold-300">{t("account.actionNeeded")}</span>
														) : (
															<span>{formatTry(next.price_minor / 100, locale)}</span>
														)}
													</div>
												</a>
											);
										})()}

										{(bookings.length > 0 || trips.length > 0) && (
											<ul class="grid grid-cols-3 gap-2 sm:gap-4 list-none p-0">
												{stats.map((stat) => (
													<li class:list={[card, "flex items-center gap-3 px-3 py-3 sm:px-5 sm:py-4"]}>
														<span class="hidden sm:grid place-items-center size-10 shrink-0 rounded-xl bg-navy-50 text-navy-700">
															<Icon name={stat.icon} size={20} />
														</span>
														<span class="grid">
															<span class="font-display text-xl sm:text-2xl font-bold text-navy-800 tabular-nums leading-tight">{stat.value}</span>
															<span class="text-xs sm:text-sm text-gray-600 leading-snug">{stat.label}</span>
														</span>
													</li>
												))}
											</ul>
										)}

										{bookings.length === 0 && trips.length === 0 && (
											<div class:list={[card, "grid justify-items-center gap-4 px-6 py-12 text-center"]}>
												<span class="grid place-items-center size-14 rounded-full bg-navy-50 text-navy-700">
													<Icon name="route" size={26} />
												</span>
												<p class="max-w-md text-gray-600">{t("account.tripsEmpty")}</p>
												<a href={bookPath(locale)} class="btn btn--primary">
													{t("nav.book")}
												</a>
											</div>
										)}

										{[
											{ title: t("account.upcoming"), list: upcoming },
											{ title: t("account.past"), list: past },
										].map(
											(group) =>
												group.list.length > 0 && (
													<section class="grid gap-3">
														<h2 class="font-display text-lg font-bold">{group.title}</h2>
														<ul class="grid gap-2.5 list-none p-0">
															{group.list.map((b) => {
																const d = parts(b.pickupAt);
																const done = FINAL.includes(b.status);
																return (
																	<li>
																		<a
																			href={bookPath(locale, b.code, b.token)}
																			class:list={[card, "flex items-center gap-4 px-4 py-3.5 sm:px-5 no-underline text-inherit transition-shadow hover:shadow-[0_14px_32px_-16px_rgb(10_37_64/0.35)]", done && "opacity-90"]}
																		>
																			<span class:list={["flex flex-col items-center gap-0.5 w-14 shrink-0 py-2 rounded-xl text-center leading-none", done ? "bg-gray-100 text-gray-600" : "bg-navy-50 text-navy-800"]}>
																				<span class="text-[11px] font-semibold uppercase">{d.month}</span>
																				<span class="font-display text-xl font-bold tabular-nums">{d.day}</span>
																				<span class="text-[11px]">{d.weekday}</span>
																			</span>
																			<span class="grid gap-1 flex-1 min-w-0">
																				<span class="font-semibold line-clamp-2">
																					{b.fromName} <span class="text-gray-400 flip-rtl inline-block">→</span> {b.toName}
																				</span>
																				<span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-600">
																					<span dir="ltr" class="tabular-nums">{d.time}</span>
																					<span class:list={["inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold", tone(b.status)]}>
																						{t(`book.status.${b.status}` as UiKey)}
																					</span>
																					{b.price_minor > 0 && <span class="hidden sm:inline tabular-nums">{formatTry(b.price_minor / 100, locale)}</span>}
																				</span>
																			</span>
																			<Icon name="chevron" size={18} class="shrink-0 text-gray-400 -rotate-90 rtl:rotate-90" />
																		</a>
																	</li>
																);
															})}
														</ul>
													</section>
												),
										)}

										{trips.length > 0 && (
											<section class="grid gap-3">
												<h2 class="font-display text-lg font-bold">{t("account.requests")}</h2>
												<ul class="grid gap-2.5 list-none p-0">
													{trips.map((trip) => (
														<li>
															<a
																href={trackPath(locale, trip.id)}
																class:list={[card, "grid gap-2 px-4 py-3.5 sm:px-5 no-underline text-inherit transition-shadow hover:shadow-[0_14px_32px_-16px_rgb(10_37_64/0.35)]"]}
															>
																<span class="flex flex-wrap items-center justify-between gap-2">
																	<span class="font-semibold">
																		{trip.from} <span class="text-gray-400 flip-rtl inline-block">→</span> {trip.to}
																	</span>
																	<StatusBadge locale={locale} status={trip.status} />
																</span>
																<span class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-600">
																	<span dir="ltr" class="font-semibold tabular-nums text-navy-800">{trip.reference}</span>
																	{trip.day && <span>{[trip.day, trip.time].filter(Boolean).join(" · ")}</span>}
																	{trip.passengers && <span>{t("account.passengersCount", { n: trip.passengers })}</span>}
																	{trip.flight && <span dir="ltr">{trip.flight}</span>}
																	{trip.returnTrip && <span>{t("account.requestReturn")}</span>}
																</span>
															</a>
														</li>
													))}
												</ul>
											</section>
										)}

										<p class="text-sm text-gray-600 text-center">
											{t("account.findBooking")}{" "}
											<a href={lookupPath(locale)} class="font-semibold text-navy-700 underline">
												{t("account.findBookingLink")}
											</a>
										</p>
									</>
								)
							}

							{
								view === "profile" && (
									<div class:list={[card, "p-5 sm:p-8"]}>
										<h2 class="font-display text-xl font-bold">{t("account.profile")}</h2>
										<p class="mt-2 mb-6 text-sm text-gray-600">{t("account.profileHint")}</p>
										<form class="form" method="post" action={accountPath(locale, "profil")}>
											<input type="hidden" name="intent" value="profile" />
											{error && errorForm === "profile" && <p class="form-status" data-state="error" role="alert">{t(error)}</p>}
											<div class="form-row">
												<div class="field">
													<label for="acc-name">{t("form.name")}</label>
													<input id="acc-name" name="name" required minlength="2" maxlength="80" autocomplete="name" value={profile.name} />
												</div>
												<div class="field">
													<label for="acc-username">{t("account.username")}</label>
													<input id="acc-username" value={member.username} dir="ltr" disabled />
												</div>
											</div>
											<div class="form-row">
												<div class="field">
													<label for="acc-email">{t("form.email")}</label>
													<input id="acc-email" name="email" type="email" required maxlength="120" autocomplete="email" dir="ltr" value={profile.email} />
												</div>
												<div class="field">
													<label for="acc-phone">{t("form.phone")}</label>
													<input id="acc-phone" name="phone" type="tel" maxlength="24" autocomplete="tel" dir="ltr" placeholder="+90 5xx xxx xx xx" value={profile.phone} />
												</div>
											</div>
											<button type="submit" class="btn btn--primary sm:justify-self-start">{t("account.save")}</button>
										</form>
									</div>
								)
							}

							{
								view === "security" && (
									<div class:list={[card, "p-5 sm:p-8"]}>
										<h2 class="font-display text-xl font-bold">{t("account.changePassword")}</h2>
										<p class="mt-2 mb-6 text-sm text-gray-600">{t("account.security")}</p>
										<form class="form" method="post" action={accountPath(locale, "guvenlik")}>
											<input type="hidden" name="intent" value="password" />
											{error && errorForm === "password" && <p class="form-status" data-state="error" role="alert">{t(error)}</p>}
											<div class="field">
												<label for="acc-current">{t("account.currentPassword")}</label>
												<input id="acc-current" name="current_password" type="password" required autocomplete="current-password" maxlength={PASSWORD_MAX} dir="ltr" />
											</div>
											<div class="form-row">
												<div class="field">
													<label for="acc-password">{t("account.newPassword")}</label>
													<input id="acc-password" name="password" type="password" autocomplete="new-password" dir="ltr" aria-describedby="acc-password-hint" {...password} />
													<small id="acc-password-hint">{t("account.passwordHint", { n: PASSWORD_MIN })}</small>
												</div>
												<div class="field">
													<label for="acc-password-repeat">{t("account.passwordRepeat")}</label>
													<input id="acc-password-repeat" name="password_repeat" type="password" autocomplete="new-password" dir="ltr" {...password} />
												</div>
											</div>
											<button type="submit" class="btn btn--primary sm:justify-self-start">{t("account.changePassword")}</button>
										</form>
									</div>
								)
							}
						</div>
					</div>
				</section>
			</>
		)
	}
</Base>

