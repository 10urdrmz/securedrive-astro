---
import Base from "../layouts/Base.astro";
import PageHero from "../components/sections/PageHero.astro";
import FaqList from "../components/sections/FaqList.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import { PAGE_SLUGS, type Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { byOrder, getLocalized } from "../lib/content";
import { faqJsonLd } from "../lib/schema";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const faqs = (await getLocalized(Astro, "faqs", locale)).sort(byOrder);
const items = faqs.map((f) => ({ question: f.data.question, answer: f.data.answer, category: f.data.category || "" }));
const categories = [...new Set(items.map((i) => i.category))];
---

<Base
	locale={locale}
	path={PAGE_SLUGS.faq}
	title={t("section.faq")}
	description={t("section.faqLead")}
	jsonLd={items.length ? [faqJsonLd(items)] : []}
>
	<PageHero locale={locale} title={t("section.faq")} lead={t("section.faqLead")} />

	<section class="section">
		<div class="container faq">
			{items.length === 0 && <p>{t("common.empty")}</p>}
			{
				categories.map((c) => (
					<div class="faq-group">
						{c && categories.length > 1 && <h2 class="group-title">{c}</h2>}
						<FaqList items={items.filter((i) => i.category === c)} />
					</div>
				))
			}
		</div>
	</section>

	<CtaBand locale={locale} />
</Base>

<style>
	.faq {
		max-width: 860px;
	}

	.faq-group + .faq-group {
		margin-top: var(--space-12);
	}

	.group-title {
		font-size: var(--text-xl);
		margin-bottom: var(--space-5);
	}
</style>
