---
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/sections/PageHero.astro";
import RouteCard from "../components/sections/RouteCard.astro";
import TrustStrip from "../components/sections/TrustStrip.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import { bookPath, pagePath, PAGE_SLUGS, type Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { getLocalized, slugOf } from "../lib/content";
import { routeTitle, zoneIdOf } from "../lib/routes";
import { breadcrumbJsonLd } from "../lib/schema";
import { SITE } from "../lib/site";

interface Props {
	locale: Locale;
	entry: any;
}

const { locale, entry } = Astro.props;
const t = useTranslations(locale);
const slug = slugOf(entry);
const d = entry.data;
const title = routeTitle(d, locale);
const sideLabel = d.side === "Avrupa" ? t("routes.side.avrupa") : d.side === "Anadolu" ? t("routes.side.anadolu") : null;

// Prices come as carrier offers (offers.ts); the page opens a request for this route.
const fromZone = zoneIdOf(d.origin);
const toZone = zoneIdOf(d.destination);
const today = new Date().toISOString().slice(0, 10);
const description = `${title}: ${t("routes.requestText")} ${t("trust.flightText")}`;

const nearby = (await getLocalized(Astro, "routes", locale))
	.filter((r) => r.data.origin === d.origin && slugOf(r) !== slug)
	.sort((a, b) => Math.abs((a.data.distance_km ?? 0) - (d.distance_km ?? 0)) - Math.abs((b.data.distance_km ?? 0) - (d.distance_km ?? 0)))
	.slice(0, 3);

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "Service",
		name: title,
		serviceType: "Airport transfer",
		provider: { "@id": `${SITE.url}/#business` },
		areaServed: { "@type": "Place", name: `${d.destination}, İstanbul` },
	},
	breadcrumbJsonLd([
		{ name: t("common.home"), path: pagePath(locale, "home") || "/" },
		{ name: t("nav.routes"), path: pagePath(locale, "routes") },
		{ name: title, path: pagePath(locale, "routes", slug) },
	]),
];
---

<Base
	locale={locale}
	path={`${PAGE_SLUGS.routes}/${slug}`}
	title={title}
	description={description}
	content={{ collection: "routes", id: d.id, slug }}
	jsonLd={jsonLd}
>
	<PageHero locale={locale} title={title} eyebrow={d.origin} crumbs={[{ href: pagePath(locale, "routes"), label: t("nav.routes") }]}>
		<ul class="route-facts">
			{d.duration_min && <li><Icon name="clock" size={18} />{t("common.minutes", { n: d.duration_min })}</li>}
			{d.distance_km && <li><Icon name="route" size={18} />{t("common.km", { n: d.distance_km })}</li>}
			{sideLabel && <li><Icon name="pin" size={18} />{sideLabel}</li>}
		</ul>
	</PageHero>

	<section class="section">
		<div class="container">
			<div class="card request-card">
				<div class="card-body">
					<h2 class="card-title">{t("routes.requestTitle")}</h2>
					<p class="muted">{t("routes.requestText")}</p>
					<form class="request-form" action={bookPath(locale)} method="get">
						{fromZone && <input type="hidden" name="from" value={fromZone} />}
						{toZone && <input type="hidden" name="to" value={toZone} />}
						<div class="field">
							<label for="rq-date">{t("quick.date")}</label>
							<input id="rq-date" name="date" type="date" min={today} required />
						</div>
						<div class="field">
							<label for="rq-time">{t("quick.time")}</label>
							<input id="rq-time" name="time" type="time" required />
						</div>
						<div class="field">
							<label for="rq-pax">{t("quick.passengers")}</label>
							<input id="rq-pax" name="pax" type="number" min="1" max="60" value="2" inputmode="numeric" required />
						</div>
						<div class="field">
							<label for="rq-bags">{t("form.luggage")}</label>
							<input id="rq-bags" name="bags" type="number" min="0" max="60" value="2" inputmode="numeric" required />
						</div>
						<button type="submit" class="btn btn--primary">
							{t("routes.requestCta")}
							<Icon name="arrow" size={18} class="flip-rtl" />
						</button>
					</form>
				</div>
			</div>
			<p class="price-note">{t("routes.priceNote")}</p>
			{d.content && <article class="prose route-content"><PortableText value={d.content} /></article>}
		</div>
	</section>

	<section class="section section--surface">
		<div class="container">
			<TrustStrip locale={locale} />
		</div>
	</section>

	{
		nearby.length > 0 && (
			<section class="section">
				<div class="container">
					<div class="section-head">
						<h2 class="section-title">{t("routes.sameOrigin")}</h2>
						<a href={pagePath(locale, "routes")} class="link-arrow">
							{t("common.viewAll")} <Icon name="arrow" size={16} class="flip-rtl" />
						</a>
					</div>
					<div class="grid grid--3">
						{nearby.map((r) => (
							<RouteCard
								locale={locale}
								href={pagePath(locale, "routes", slugOf(r))}
								origin={r.data.origin}
								destination={r.data.destination}
								distanceKm={r.data.distance_km}
								durationMin={r.data.duration_min}
								badge={r.data.badge}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<CtaBand locale={locale} />
</Base>

<style>
	.route-facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-6);
		margin-top: var(--space-6);
		padding: 0;
		list-style: none;
		color: #c9d1da;
	}

	.route-facts li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.request-card {
		margin-bottom: var(--space-6);
	}
	.request-form {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: var(--space-3);
		align-items: end;
		margin-top: var(--space-4);
	}
	.price-note {
		margin-top: var(--space-8);
		color: var(--color-muted);
		font-size: var(--text-sm);
		max-width: 70ch;
	}

	.route-content {
		margin-top: var(--space-10);
	}
</style>
