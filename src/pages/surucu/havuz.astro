---
/**
 * The job pool for independent drivers: customer requests from the site to send a
 * price for (offers.ts), then fixed-payout jobs to take and auctions to bid on, for
 * the class they drive. A won job lands in "İşlerim", already accepted.
 */
import DriverLayout from "../../layouts/DriverLayout.astro";
import { getDb } from "../../server/db";
import { sessionDriver, when } from "../../server/driver-app";
import { formatMoney, parseMoney, readForm, text } from "../../server/ops";
import { getOpenPoolByCode, openPoolFor, placeBid, takeFixed, withdrawBid } from "../../server/pool";
import { getOpenRequest, openRequestsFor, placeOffer, withdrawOffer } from "../../server/offers";

const db = await getDb(Astro.locals);
const driver = await sessionDriver(db, Astro.cookies);
if (!driver) return Astro.redirect("/surucu/giris");
if (driver.kind !== "independent" || driver.org_id) return Astro.redirect("/surucu");
const bidder = { kind: "driver" as const, id: driver.id };

let notice = "";
let error = "";
const form = await readForm(Astro);
if (form) {
	const intent = text(form, "intent", 20);
	const code = text(form, "code", 20).toUpperCase();
	try {
		if (intent === "offer" || intent === "offer_withdraw") {
			const request = await getOpenRequest(db, code);
			if (!request) throw new Error("Bu talep artık açık değil.");
			if (intent === "offer") {
				const amount = parseMoney(text(form, "amount", 20));
				if (!amount) throw new Error("Kazancınızı yazın. Örnek: 1.650");
				await placeOffer(db, request, bidder, { classKey: driver.class_key ?? "", amountMinor: amount, vehicle: text(form, "vehicle", 80) || null, note: null });
				notice = `${formatMoney(amount)} ₺ teklifiniz müşteriye iletildi. Müşteri seçerse iş İşlerim'e düşer.`;
			} else {
				await withdrawOffer(db, request, bidder);
				notice = "Teklifiniz geri çekildi.";
			}
		} else {
		const job = await getOpenPoolByCode(db, code);
		if (!job) throw new Error("Bu iş artık havuzda değil.");
		if (intent === "take") {
			await takeFixed(db, job, bidder, { kind: "driver", userId: null });
			return Astro.redirect(`/surucu/is/${code}`, 303);
		} else if (intent === "bid") {
			const amount = parseMoney(text(form, "amount", 20));
			if (!amount) throw new Error("Teklif tutarını yazın. Örnek: 1.650");
			await placeBid(db, job, bidder, amount, null);
			notice = `${formatMoney(amount)} ₺ teklifiniz kaydedildi. Süre bitince en düşük teklif kazanır.`;
		} else if (intent === "withdraw") {
			await withdrawBid(db, job, bidder);
			notice = "Teklifiniz geri çekildi.";
		}
		}
	} catch (e) {
		error = e instanceof Error ? e.message : "İşlem yapılamadı.";
	}
}

const jobs = await openPoolFor(db, bidder, driver.class_key);
const myClass = driver.class_key
	? await db.selectFrom("sd_vehicle_classes").select(["name", "pax_max", "bags_max"]).where("key", "=", driver.class_key).executeTakeFirst()
	: undefined;
const requests = myClass ? await openRequestsFor(db, bidder, { paxMax: myClass.pax_max, bagsMax: myClass.bags_max }) : [];
const left = (iso: string) => {
	const minutes = Math.max(0, Math.round((Date.parse(iso) - Date.now()) / 60_000));
	return minutes >= 120 ? `${Math.floor(minutes / 60)} saat` : `${minutes} dk`;
};
---

<DriverLayout title="İş havuzu" driver={driver} back refresh={form ? undefined : 60}>
	<h1>İş havuzu</h1>
	<p class="drv-muted">
		<strong>Sabit</strong> işleri ilk alan alır. <strong>İhalede</strong> tavanın altında teklif verin; süre bitince en düşük teklif kazanır. Kazandığınız
		iş İşlerim'e düşer.
	</p>
	{notice && <p class="drv-notice">{notice}</p>}
	{error && <p class="drv-notice error" role="alert">{error}</p>}
	<h2 class="sec">Müşteri talepleri</h2>
	<p class="drv-muted">
		Müşteri yolculuğunu yazdı, fiyat bekliyor. <strong>Kazancınızı</strong> yazın; müşteri teklifleri karşılaştırıp birini seçer. Müşterinin adını, telefonunu
		ve diğer teklifleri görmezsiniz.
	</p>
	{
		requests.length === 0 && (
			<div class="drv-card" style="text-align:center;padding:20px 16px">
				<span class="drv-muted">Aracınıza uygun açık talep yok.</span>
			</div>
		)
	}
	{
		requests.map((r) => {
			const w = when(r.pickup_at);
			const active = r.my_status === "active";
			return (
				<div class="drv-card pool">
					<div class="top">
						<div class="whenx">
							<strong>{w.time}</strong>
							<span>{w.day}</span>
						</div>
						<span class:list={["drv-pill", active ? "ok" : "warn"]}>{active ? "Teklif verdiniz" : "Talep"}</span>
					</div>
					<div class="route">{r.from_name} → {r.to_name}</div>
					<div class="drv-muted meta">
						{r.pax} kişi · {r.bags} bavul{r.flight_no && ` · ${r.flight_no}`} · {r.offers} teklif
					</div>
					{r.extras && <div class="drv-muted meta">Ekstralar: {r.extras}</div>}
					{r.notes && <div class="drv-muted meta">Not: {r.notes}</div>}
					<form method="post">
						<input type="hidden" name="code" value={r.code} />
						<label class="drv-field">
							Kazancınız (₺){active && ` · şu an ${formatMoney(r.my_amount ?? 0)} ₺`}
							<input type="text" name="amount" inputmode="decimal" required placeholder="1.650" />
						</label>
						<label class="drv-field">
							Aracınız (model, renk)
							<input type="text" name="vehicle" maxlength="80" value={r.my_vehicle ?? ""} />
						</label>
						<button class="drv-btn" type="submit" name="intent" value="offer">
							{active ? "Teklifi güncelle" : `Teklif ver · ${myClass!.name}`}
						</button>
						{active && (
							<button class="drv-btn ghost" type="submit" name="intent" value="offer_withdraw" formnovalidate style="margin-top:8px">
								Teklifi geri çek
							</button>
						)}
					</form>
				</div>
			);
		})
	}
	<h2 class="sec">Operasyon havuzu</h2>
	{
		jobs.length === 0 && (
			<div class="drv-card" style="text-align:center;padding:32px 16px">
				<strong>Şu an havuzda iş yok.</strong>
				<p class="drv-muted" style="margin:6px 0 0">Sayfa dakikada bir yenilenir.</p>
			</div>
		)
	}
	{
		jobs.map((j) => {
			const w = when(j.pickup_at);
			const active = j.my_bid_status === "active";
			return (
				<div class="drv-card pool">
					<div class="top">
						<div class="whenx">
							<strong>{w.time}</strong>
							<span>{w.day}</span>
						</div>
						<span class="drv-pill warn">{j.mode === "auction" ? "İhale" : "Sabit"}</span>
					</div>
					<div class="route">{j.from_name} → {j.to_name}</div>
					<div class="drv-muted meta">
						{j.class_name} · {j.pax} kişi · {j.bags} bavul{j.flight_no && ` · ${j.flight_no}`}
					</div>
					{j.note && <div class="drv-muted meta">Not: {j.note}</div>}
					<div class="money">
						<strong>{formatMoney(j.payout_minor)} ₺</strong>
						<span class="drv-muted">
							{j.mode === "auction" ? "tavan" : "kazancınız"} · {left(j.deadline_at)} kaldı
							{j.mode === "auction" && ` · ${j.bids} teklif`}
						</span>
					</div>
					{j.mode === "fixed" ? (
						<form method="post">
							<input type="hidden" name="code" value={j.code} />
							<button class="drv-btn green" type="submit" name="intent" value="take">
								İşi al
							</button>
						</form>
					) : (
						<form method="post">
							<input type="hidden" name="code" value={j.code} />
							<label class="drv-field">
								Teklifiniz (₺){active && ` · şu an ${formatMoney(j.my_bid)} ₺`}
								<input type="text" name="amount" inputmode="decimal" required placeholder={formatMoney(j.payout_minor)} />
							</label>
							<button class="drv-btn" type="submit" name="intent" value="bid">
								{active ? "Teklifi güncelle" : "Teklif ver"}
							</button>
							{active && (
								<button class="drv-btn ghost" type="submit" name="intent" value="withdraw" formnovalidate style="margin-top:8px">
									Teklifi geri çek
								</button>
							)}
						</form>
					)}
				</div>
			);
		})
	}
</DriverLayout>

<style>
	.sec {
		font-size: 18px;
		margin: 20px 0 4px;
	}
	.pool {
		display: grid;
		gap: 8px;
	}
	.top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.whenx {
		display: flex;
		align-items: baseline;
		gap: 8px;
	}
	.whenx strong {
		font-size: 24px;
		font-variant-numeric: tabular-nums;
	}
	.whenx span {
		color: var(--drv-muted);
		font-weight: 600;
	}
	.route {
		font-weight: 600;
	}
	.meta {
		font-size: 14px;
	}
	.money {
		display: flex;
		align-items: baseline;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 4px;
	}
	.money strong {
		font-size: 22px;
	}
</style>
