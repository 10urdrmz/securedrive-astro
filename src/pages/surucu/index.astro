---
/** The driver's jobs: the one in progress first, then upcoming, then the last few days. */
import DriverLayout from "../../layouts/DriverLayout.astro";
import { getDb } from "../../server/db";
import { driverJobs, jobBadge, sessionDriver, when, type DriverJob } from "../../server/driver-app";
import { unreadCounts } from "../../server/messages";
import { openPoolFor } from "../../server/pool";
import { openRequestsFor } from "../../server/offers";

const db = await getDb(Astro.locals);
const driver = await sessionDriver(db, Astro.cookies);
if (!driver) return Astro.redirect("/surucu/giris");

const { open, done } = await driverJobs(db, driver.id);
const active = open.filter((j) => ["driver_en_route", "driver_arrived", "on_board"].includes(j.booking.status));
const upcoming = open.filter((j) => !active.includes(j));
const waiting = upcoming.filter((j) => !j.response).length;
const independent = driver.kind === "independent" && !driver.org_id;
const poolCount =
	(independent ? (await openPoolFor(db, { kind: "driver", id: driver.id }, driver.class_key)).length : 0) +
	(await openRequestsFor(db, driver.org_id ? { kind: "partner", id: driver.org_id } : { kind: "driver", id: driver.id })).filter((r) => !r.my_status).length;
const unread = await unreadCounts(db, open.map((j) => j.booking.id), "driver");
const today = upcoming.filter((j) => when(j.booking.pickup_at).day === "Bugün").length + active.length;
const hero = active[0];
const later = [...active.slice(1), ...upcoming];
// Upcoming jobs grouped by day: "Bugün", "Yarın", then the weekday.
const days: { day: string; jobs: DriverJob[] }[] = [];
for (const job of later) {
	const { day } = when(job.booking.pickup_at);
	const group = days.find((d) => d.day === day);
	if (group) group.jobs.push(job);
	else days.push({ day, jobs: [job] });
}
const minutesTo = (iso: string) => Math.round((Date.parse(iso) - Date.now()) / 60_000);
const countdown = (iso: string) => {
	const m = minutesTo(iso);
	if (m <= 0) return null;
	return m < 60 ? `${m} dk sonra` : m < 24 * 60 ? `${Math.floor(m / 60)} sa ${m % 60 ? `${m % 60} dk ` : ""}sonra` : null;
};
---

<DriverLayout title="İşlerim" driver={driver} refresh={30} tab="jobs" badges={{ jobs: waiting, pool: poolCount }}>
	<div class="hello">
		<h1>Merhaba, {driver.name.split(" ")[0]}</h1>
		<span class="drv-muted">{new Intl.DateTimeFormat("tr-TR", { weekday: "long", day: "numeric", month: "long", timeZone: "Europe/Istanbul" }).format(new Date())}</span>
	</div>

	<div class="stats">
		<div class="stat">
			<strong>{today}</strong>
			<span>Bugünkü iş</span>
		</div>
		<div class:list={["stat", waiting > 0 && "warn"]}>
			<strong>{waiting}</strong>
			<span>Onay bekleyen</span>
		</div>
		<a class:list={["stat", poolCount > 0 && "hot"]} href="/surucu/havuz">
			<strong>{poolCount}</strong>
			<span>Havuzda açık ›</span>
		</a>
	</div>

	{
		hero && (
			<a class="hero" href={`/surucu/is/${hero.booking.code}`}>
				<div class="hero-top">
					<span class="hero-live">
						<span aria-hidden="true" />
						{jobBadge(hero).label}
					</span>
					<span>{when(hero.booking.pickup_at).time}</span>
				</div>
				<div class="hero-route">
					<span>{hero.fromName}</span>
					<span>{hero.toName}</span>
				</div>
				<div class="hero-meta">
					{hero.booking.pax} kişi · {hero.booking.bags} bavul{hero.booking.flight_no && ` · ${hero.booking.flight_no}`}
					{(unread.get(hero.booking.id) ?? 0) > 0 && <span class="hero-unread">{unread.get(hero.booking.id)} yeni mesaj</span>}
				</div>
				<span class="hero-cta">Yolculuğa devam et ›</span>
			</a>
		)
	}

	{
		days.map((group) => (
			<section>
				<h2>{group.day}</h2>
				{group.jobs.map((job) => {
					const w = when(job.booking.pickup_at);
					const badge = jobBadge(job);
					const soon = countdown(job.booking.pickup_at);
					const asks = !job.response && job.booking.status === "assigned";
					const messages = unread.get(job.booking.id) ?? 0;
					return (
						<a class:list={["drv-card", "job", asks && "asks"]} href={`/surucu/is/${job.booking.code}`}>
							<div class="job-time">
								<strong>{w.time}</strong>
								{soon && <span>{soon}</span>}
							</div>
							<div class="job-body">
								<div class="job-route">
									<span class="dot" aria-hidden="true" />
									{job.fromName}
								</div>
								<div class="job-route">
									<span class="dot to" aria-hidden="true" />
									{job.toName}
								</div>
								<div class="job-tags">
									<span class:list={["drv-pill", badge.tone]}>{badge.label}</span>
									{messages > 0 && <span class="job-unread">{messages} mesaj</span>}
									<span class="drv-muted">
										{job.booking.pax} kişi · {job.booking.bags} bavul · {job.className}
										{job.booking.flight_no && <> · {job.booking.flight_no}</>}
									</span>
								</div>
							</div>
							<span class="job-go" aria-hidden="true">›</span>
						</a>
					);
				})}
			</section>
		))
	}

	{
		open.length === 0 && (
			<div class="drv-card empty">
				<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
				</svg>
				<strong>Şu an planlı işiniz yok</strong>
				<p class="drv-muted">{independent ? "Havuzdan aldığınız ya da kazandığınız işler burada görünür." : "Size iş atandığında burada görünür."} Liste kendiliğinden güncellenir.</p>
				<a class="drv-btn" href="/surucu/havuz">
					İş havuzuna bak{poolCount > 0 && ` (${poolCount})`}
				</a>
			</div>
		)
	}

	{
		done.length > 0 && (
			<details class="done">
				<summary>Son günler ({done.length})</summary>
				{done.map((job) => {
					const w = when(job.booking.pickup_at);
					const badge = jobBadge(job);
					return (
						<a class="done-row" href={`/surucu/is/${job.booking.code}`}>
							<span class="done-when">
								{w.day} {w.time}
							</span>
							<span class="done-route">
								{job.fromName} → {job.toName}
							</span>
							<span class:list={["drv-pill", badge.tone]}>{badge.label}</span>
						</a>
					);
				})}
			</details>
		)
	}
</DriverLayout>

<style>
	.hello {
		display: grid;
		gap: 2px;
		margin-bottom: 14px;
	}
	.hello h1 {
		margin: 0 !important;
	}
	.hello span {
		font-size: 14px;
		text-transform: capitalize;
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
		margin-bottom: 14px;
	}
	.stat {
		display: grid;
		gap: 2px;
		padding: 12px;
		border-radius: 14px;
		background: #fff;
		border: 1px solid var(--drv-line);
		color: inherit;
		text-decoration: none;
	}
	.stat strong {
		font-size: 26px;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}
	.stat span {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--drv-muted);
	}
	.stat.warn {
		background: #fffaeb;
		border-color: #fedf89;
	}
	.stat.warn strong {
		color: #b54708;
	}
	.stat.hot {
		background: var(--drv-blue);
		border-color: var(--drv-blue);
		color: #fff;
	}
	.stat.hot span {
		color: #cfe0f1;
	}
	.hero {
		display: grid;
		gap: 10px;
		margin-bottom: 8px;
		padding: 18px;
		border-radius: 18px;
		background: linear-gradient(135deg, #0a2540, #144c7f);
		color: #fff;
		text-decoration: none;
		box-shadow: 0 10px 24px rgb(10 37 64 / 0.25);
	}
	.hero-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-weight: 700;
		font-size: 18px;
		font-variant-numeric: tabular-nums;
	}
	.hero-live {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 4px 12px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.12);
		font-size: 14px;
	}
	.hero-live span {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: #32d583;
	}
	.hero-route {
		display: grid;
		gap: 6px;
		font-size: 19px;
		font-weight: 700;
	}
	.hero-route span:first-child::after {
		content: "↓";
		display: block;
		color: #dcc49a;
		font-size: 15px;
	}
	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		color: #cfe0f1;
		font-size: 14px;
	}
	.hero-unread {
		padding: 2px 10px;
		border-radius: 999px;
		background: #d92d20;
		color: #fff;
		font-weight: 600;
	}
	.hero-cta {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 50px;
		border-radius: 12px;
		background: #fff;
		color: var(--drv-navy);
		font-weight: 700;
		font-size: 17px;
	}
	.job {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr) auto;
		gap: 12px;
		align-items: start;
		margin-bottom: 10px;
	}
	.job.asks {
		border-color: #fdb022;
		box-shadow: 0 0 0 3px #fef0c7;
	}
	.job-time {
		display: grid;
		gap: 2px;
	}
	.job-time strong {
		font-size: 22px;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}
	.job-time span {
		font-size: 12px;
		font-weight: 600;
		color: #175cd3;
	}
	.job-body {
		display: grid;
		gap: 6px;
		min-width: 0;
	}
	.job-route {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 600;
		min-width: 0;
	}
	.dot {
		width: 10px;
		height: 10px;
		border-radius: 999px;
		border: 2px solid var(--drv-blue);
		flex: none;
	}
	.dot.to {
		background: var(--drv-blue);
	}
	.job-tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 8px;
		font-size: 13px;
	}
	.job-unread {
		padding: 3px 10px;
		border-radius: 999px;
		background: #0a2540;
		color: #fff;
		font-weight: 600;
	}
	.job-go {
		align-self: center;
		color: #98a2b3;
		font-size: 26px;
		line-height: 1;
	}
	.empty {
		display: grid;
		justify-items: center;
		gap: 6px;
		padding: 28px 18px;
		text-align: center;
		color: #98a2b3;
	}
	.empty strong {
		color: var(--drv-ink);
	}
	.empty p {
		margin: 0 0 8px;
	}
	.done {
		margin-top: 20px;
		background: #fff;
		border: 1px solid var(--drv-line);
		border-radius: 14px;
		padding: 4px 14px;
	}
	.done summary {
		cursor: pointer;
		padding: 12px 0;
		font-weight: 600;
		color: var(--drv-muted);
	}
	.done-row {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 10px;
		padding: 12px 0;
		border-top: 1px solid var(--drv-line);
		color: inherit;
		text-decoration: none;
		font-size: 14px;
	}
	.done-when {
		font-weight: 600;
		white-space: nowrap;
	}
	.done-route {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
