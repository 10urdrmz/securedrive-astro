---
/**
 * Drivers ops can assign, and their access to the driver app (/surucu): ops issues a
 * 6-digit PIN, shown once, and can send it to the driver by WhatsApp.
 */
import OpsLayout from "../../layouts/OpsLayout.astro";
import { can } from "../../server/auth/rbac";
import { ulid } from "../../server/ids";
import { audit, readForm, requireOps, text } from "../../server/ops";
import { approveApplication, listApplications, rejectApplication } from "../../server/driver-applications";
import { LOGIN_OUTCOME_LABELS, driversWithAccess, issuePin, phoneKey, recentLogins, revokeAccess } from "../../server/driver-app";

const ctx = await requireOps(Astro, "bookings.read");
if (ctx instanceof Response) return ctx;
const { db, user } = ctx;
const canWrite = can(user, "drivers.manage");

const classes = await db.selectFrom("sd_vehicle_classes").select(["key", "name"]).orderBy("sort").execute();

let notice = "";
let error = "";
const form = canWrite ? await readForm(Astro) : null;
let issued: { name: string; phone: string; pin: string } | null = null;
const intent = form ? text(form, "intent", 20) : "";
if (form && (intent === "app_approve" || intent === "app_reject")) {
	const id = text(form, "app_id", 40);
	try {
		if (intent === "app_approve") {
			const classKey = text(form, "class_key", 60);
			const approved = await approveApplication(db, id, user.id, {
				classKey: classes.some((c) => c.key === classKey) ? classKey : null,
				plate: text(form, "plate", 16).toUpperCase() || null,
				vehicle: text(form, "vehicle", 80) || null,
			});
			await audit(db, user, "driver.application_approve", "driver", approved.driverId, { application: id });
			issued = { name: approved.name, phone: approved.phone, pin: approved.pin };
			notice = `${approved.name} bağımsız sürücü olarak eklendi; iş havuzunu görür.`;
		} else {
			await rejectApplication(db, id, user.id, text(form, "review_note", 300) || null);
			await audit(db, user, "driver.application_reject", "driver_application", id);
			notice = "Başvuru reddedildi.";
		}
	} catch (e) {
		error = e instanceof Error ? e.message : "İşlem yapılamadı.";
	}
} else if (form && (intent === "pin" || intent === "revoke")) {
	const id = text(form, "id", 40);
	const driver = await db.selectFrom("sd_drivers").select(["id", "name", "phone"]).where("id", "=", id).executeTakeFirst();
	if (driver && intent === "pin") {
		issued = { name: driver.name, phone: driver.phone, pin: await issuePin(db, driver.id) };
		await audit(db, user, "driver.pin", "driver", driver.id);
	} else if (driver) {
		await revokeAccess(db, driver.id);
		await audit(db, user, "driver.revoke", "driver", driver.id);
		notice = `${driver.name} artık uygulamaya giremez.`;
	}
} else if (form) {
	const id = text(form, "id", 40);
	const values = {
		name: text(form, "name", 80),
		phone: text(form, "phone", 24),
		kind: ["staff", "partner", "independent"].includes(text(form, "kind", 20)) ? text(form, "kind", 20) : "staff",
		class_key: classes.some((c) => c.key === text(form, "class_key", 60)) ? text(form, "class_key", 60) : null,
		plate: text(form, "plate", 16).toUpperCase() || null,
		vehicle: text(form, "vehicle", 80) || null,
		languages: text(form, "languages", 80),
		status: form.get("active") === "on" ? "active" : "inactive",
		notes: text(form, "notes", 500) || null,
	};
	if (values.name.length < 2 || !/^\+?[0-9 ()-]{7,20}$/.test(values.phone)) {
		error = "Ad ve geçerli bir telefon gerekli.";
	} else if (phoneKey(values.phone).length < 10) {
		// The driver signs in with this number; the app compares its last ten digits.
		error = "Telefonu alan koduyla tam yazın (05xx xxx xx xx), sürücü uygulamaya bu numarayla girer.";
	} else if (id) {
		await db.updateTable("sd_drivers").set(values).where("id", "=", id).execute();
		await audit(db, user, "driver.update", "driver", id, values);
		notice = `${values.name} güncellendi.`;
	} else {
		const newId = ulid();
		await db.insertInto("sd_drivers").values({ id: newId, ...values }).execute();
		await audit(db, user, "driver.create", "driver", newId, values);
		notice = `${values.name} eklendi.`;
	}
}

const drivers = await db
	.selectFrom("sd_drivers as d")
	.leftJoin("sd_orgs as o", "o.id", "d.org_id")
	.selectAll("d")
	.select(["o.name as partner_name"])
	.orderBy("d.status")
	.orderBy("d.name")
	.execute();
const applications = await listApplications(db);
const withAccess = await driversWithAccess(db);
const logins = await recentLogins(db);
const lockedUntil = new Map(
	(await db.selectFrom("sd_driver_access").select(["driver_id", "locked_until"]).where("locked_until", ">", new Date().toISOString()).execute()).map(
		(r: { driver_id: string; locked_until: string }) => [r.driver_id, r.locked_until],
	),
);
const clock = (iso: string) => new Date(Date.parse(iso) + 3 * 3600_000).toISOString().slice(0, 16).replace("T", " ");
const appUrl = new URL("/surucu", Astro.url.origin).href;
const pinMessage = issued
	? `Merhaba ${issued.name.split(" ")[0]}, SecureDrive sürücü uygulaması: ${appUrl}\nGiriş: bu telefon numaranız ve PIN ${issued.pin}\nAçınca "Ana ekrana ekle" ile telefonunuza kurabilirsiniz.`
	: "";
const waDigits = (phone: string) => phone.replace(/\D/g, "").replace(/^0/, "90");
const KINDS: Record<string, string> = { staff: "Kendi filo", partner: "Partner", independent: "Bağımsız" };
const blank = { id: "", name: "", phone: "", kind: "staff", class_key: classes[0]?.key ?? "", plate: "", vehicle: "", languages: "", status: "active", notes: "" };
---

<OpsLayout title="Sürücüler" user={user}>
	{notice && <p class="notice">{notice}</p>}
	{error && <p class="notice error">{error}</p>}
	{
		issued && (
			<div class="notice">
				<strong>{issued.name}</strong> için yeni PIN: <strong style="font-size:20px;letter-spacing:0.15em">{issued.pin}</strong>
				<br />
				Bu PIN bir daha gösterilmez. Sürücü <a href={appUrl}>{appUrl}</a> adresinden telefon numarası ve bu PIN ile girer.
				<div class="actions">
					<a class="btn" href={`https://wa.me/${waDigits(issued.phone)}?text=${encodeURIComponent(pinMessage)}`} target="_blank" rel="noopener">
						PIN'i sürücüye WhatsApp ile gönder
					</a>
				</div>
			</div>
		)
	}
	{
		logins.length > 0 && (
			<details class="card logins" open={logins.some((l) => l.result !== "ok")}>
				<summary>Son sürücü giriş denemeleri</summary>
				<table>
					<tbody>
						{logins.map((l) => (
							<tr>
								<td class="muted">{clock(l.at)}</td>
								<td>{l.name ?? "—"}</td>
								<td class="muted">…{l.phone_tail}</td>
								<td>
									<span class:list={["badge", l.result === "ok" && "ok"]}>{LOGIN_OUTCOME_LABELS[l.result] ?? l.result}</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</details>
		)
	}
	{
		applications.length > 0 && (
			<section class="card" id="basvurular">
				<h2 style="margin-top:0">Bağımsız sürücü başvuruları ({applications.length})</h2>
				<p class="muted" style="margin-top:0">
					<a href="/surucu/basvuru">/surucu/basvuru</a> formundan gelir. Sürücüyü arayıp ruhsat, sigorta ve belgelerini kontrol edin; onaylayınca PIN oluşur ve
					sürücü uygulamadaki iş havuzundan kendi araç sınıfındaki işleri alabilir. Otomatik atamaya girmezler.
				</p>
				{applications.map((a) => (
					<form method="post" class="form-grid app">
						<input type="hidden" name="app_id" value={a.id} />
						<div style="grid-column:1/-1">
							<strong>{a.name}</strong> · <a href={`tel:${a.phone.replace(/[^0-9+]/g, "")}`}>{a.phone}</a>
							<span class="muted"> · {clock(a.created_at)}</span>
							<div class="muted">
								{[a.languages && `Diller: ${a.languages}`, a.licence && `Belge: ${a.licence}`, a.note].filter(Boolean).join(" · ")}
							</div>
						</div>
						<label>
							Araç sınıfı
							<select name="class_key" disabled={!canWrite}>
								{classes.map((c) => <option value={c.key} selected={a.class_key === c.key}>{c.name}</option>)}
							</select>
						</label>
						<label>
							Plaka
							<input type="text" name="plate" value={a.plate ?? ""} disabled={!canWrite} />
						</label>
						<label>
							Araç
							<input type="text" name="vehicle" value={a.vehicle ?? ""} disabled={!canWrite} />
						</label>
						<label>
							Ret notu (isteğe bağlı)
							<input type="text" name="review_note" disabled={!canWrite} />
						</label>
						{canWrite && (
							<div class="actions" style="grid-column:1/-1">
								<button class="btn" type="submit" name="intent" value="app_approve">Onayla ve PIN oluştur</button>
								<button class="btn secondary" type="submit" name="intent" value="app_reject" formnovalidate>Reddet</button>
							</div>
						)}
					</form>
				))}
			</section>
		)
	}
	<p class="muted">
		Atanabilir sürücüler. Bağımsız sürücüler otomatik atamaya girmez, işlerini iş havuzundan alır. Sürücü uygulamasına (<a href="/surucu">/surucu</a>) girmesi için sürücüye PIN verin; işlerini görür,
		kabul eder ve yolculuk adımlarını kendisi işaretler. Pasif sürücü atama listesinde görünmez ve uygulamaya giremez.
	</p>
	{
		[...(canWrite ? [blank] : []), ...drivers].map((d) => (
			<form class="card form-grid" method="post">
				<input type="hidden" name="id" value={d.id} />
				{!d.id && <strong style="grid-column:1/-1">Yeni sürücü</strong>}
				{"partner_name" in d && d.partner_name && (
					<div style="grid-column:1/-1">
						<span class="badge">{d.partner_name} sürücüsü</span>{" "}
						{d.approval !== "approved" && <a class="badge off" href="/ops/partnerler">{d.approval === "pending" ? "Onay bekliyor" : "Onaylanmadı"}</a>}
					</div>
				)}
				<label>
					Ad soyad
					<input type="text" name="name" value={d.name} required disabled={!canWrite} />
				</label>
				<label>
					Telefon
					<input type="text" name="phone" value={d.phone} required disabled={!canWrite} placeholder="+90 5xx xxx xx xx" />
				</label>
				<label>
					Tür
					<select name="kind" disabled={!canWrite}>
						{Object.entries(KINDS).map(([k, label]) => <option value={k} selected={d.kind === k}>{label}</option>)}
					</select>
				</label>
				<label>
					Araç sınıfı
					<select name="class_key" disabled={!canWrite}>
						{classes.map((c) => <option value={c.key} selected={d.class_key === c.key}>{c.name}</option>)}
					</select>
				</label>
				<label>
					Plaka
					<input type="text" name="plate" value={d.plate ?? ""} disabled={!canWrite} />
				</label>
				<label>
					Araç (marka, model, renk)
					<input type="text" name="vehicle" value={d.vehicle ?? ""} disabled={!canWrite} />
				</label>
				<label>
					Diller
					<input type="text" name="languages" value={d.languages} disabled={!canWrite} placeholder="TR, EN, AR" />
				</label>
				<label>
					Not
					<input type="text" name="notes" value={d.notes ?? ""} disabled={!canWrite} />
				</label>
				<label class="inline">
					<input type="checkbox" name="active" checked={d.status === "active"} disabled={!canWrite} /> Aktif
				</label>
				{canWrite && <div><button class="btn" type="submit">{d.id ? "Kaydet" : "Ekle"}</button></div>}
				{d.id && (
					<div class="access" style="grid-column:1/-1">
						<span class:list={["badge", withAccess.has(d.id) && "ok"]}>{withAccess.has(d.id) ? "Uygulama erişimi var" : "Uygulama erişimi yok"}</span>
						{lockedUntil.has(d.id) && <span class="badge">Kilitli, {clock(lockedUntil.get(d.id)!).slice(11)}'e kadar. PIN'i yenileyince açılır.</span>}
						{canWrite && (
							<button class="btn secondary" type="submit" name="intent" value="pin" formnovalidate>
								{withAccess.has(d.id) ? "PIN'i yenile" : "PIN oluştur"}
							</button>
						)}
						{canWrite && withAccess.has(d.id) && (
							<button class="btn secondary" type="submit" name="intent" value="revoke" formnovalidate>
								Erişimi kapat
							</button>
						)}
					</div>
				)}
			</form>
		))
	}
</OpsLayout>

<style>
	.logins summary {
		cursor: pointer;
		font-weight: 600;
	}
	.logins table {
		width: 100%;
		margin-top: 10px;
		border-collapse: collapse;
		font-size: 14px;
	}
	.logins td {
		padding: 6px 8px 6px 0;
		border-top: 1px solid var(--gray-200);
	}
	.app + .app {
		margin-top: 14px;
		padding-top: 14px;
		border-top: 1px solid var(--gray-200);
	}
	.access {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
		padding-top: 12px;
		border-top: 1px solid var(--gray-200);
	}
</style>
