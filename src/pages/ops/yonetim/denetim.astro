---
import OpsLayout from "../../../layouts/OpsLayout.astro";
import { requireOps } from "../../../server/ops";

const ctx = await requireOps(Astro, "audit.read");
if (ctx instanceof Response) return ctx;
const { db, user } = ctx;

const PAGE = 100;
const before = Astro.url.searchParams.get("before");
let query = db
	.selectFrom("sd_audit_log as a")
	.leftJoin("sd_users as u", "u.id", "a.actor_user_id")
	.select(["a.id", "a.at", "a.action", "a.entity", "a.entity_id", "a.data", "u.name as actor"])
	.orderBy("a.id", "desc")
	.limit(PAGE + 1);
if (before) query = query.where("a.id", "<", before);
const rows = await query.execute();
const more = rows.length > PAGE;
const shown = rows.slice(0, PAGE);
---

<OpsLayout title="Denetim kaydı" user={user}>
	<p class="muted">Tarife, kural, rol ve giriş değişikliklerinin kim tarafından ne zaman yapıldığı. Kayıtlar silinmez.</p>
	<div class="table-wrap">
		<table class="data">
			<thead><tr><th>Zaman</th><th>Kim</th><th>İşlem</th><th>Kayıt</th><th>Ayrıntı</th></tr></thead>
			<tbody>
				{
					shown.map((row) => (
						<tr>
							<td class="muted">{new Date(row.at).toLocaleString("tr-TR")}</td>
							<td>{row.actor ?? "Sistem"}</td>
							<td>{row.action}</td>
							<td class="muted">{row.entity}{row.entity_id ? ` · ${row.entity_id}` : ""}</td>
							<td class="muted" style="max-width:420px;overflow-wrap:anywhere;font-size:13px">{row.data !== "{}" ? row.data : ""}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
	{more && <div class="actions"><a class="btn secondary" href={`?before=${shown.at(-1)!.id}`}>Daha eski</a></div>}
</OpsLayout>
