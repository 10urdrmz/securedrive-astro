---
/** Booking list: by pickup day, status or a search on number, name or phone. */
import OpsLayout from "../../../layouts/OpsLayout.astro";
import { can } from "../../../server/auth/rbac";
import { BOOKING_STATUSES, PAYMENT_STATUS_LABELS, STATUS_LABELS, type BookingStatus } from "../../../server/bookings";
import { formatMoney, requireOps } from "../../../server/ops";
import { isoToIstanbul, istanbulToIso } from "../../../server/pricing";
import Icon from "../../../components/Icon.astro";

const ctx = await requireOps(Astro, "bookings.read");
if (ctx instanceof Response) return ctx;
const { db, user } = ctx;

const params = Astro.url.searchParams;
const todayLocal = isoToIstanbul(new Date().toISOString()).date;
const addDays = (date: string, days: number) => new Date(Date.parse(`${date}T00:00:00Z`) + days * 86400_000).toISOString().slice(0, 10);
const DATE = /^\d{4}-\d{2}-\d{2}$/;
const from = DATE.test(params.get("from") ?? "") ? params.get("from")! : todayLocal;
const to = DATE.test(params.get("to") ?? "") ? params.get("to")! : addDays(todayLocal, 7);
const status = (BOOKING_STATUSES as readonly string[]).includes(params.get("status") ?? "") ? (params.get("status") as BookingStatus) : "";
const q = (params.get("q") ?? "").trim().slice(0, 60);
const unassigned = params.get("unassigned") === "1";
const company = (params.get("firma") ?? "").slice(0, 40);
const agencyFilter = (params.get("acente") ?? "").slice(0, 40);

let query = db
	.selectFrom("sd_bookings as b")
	.innerJoin("sd_zones as f", "f.id", "b.from_zone_id")
	.innerJoin("sd_zones as t", "t.id", "b.to_zone_id")
	.innerJoin("sd_vehicle_classes as c", "c.key", "b.class_key")
	.leftJoin("sd_drivers as d", "d.id", "b.driver_id")
	.leftJoin("sd_orgs as o", (join) => join.onRef("o.id", "=", "b.org_id").on("o.kind", "=", "company"))
	.leftJoin("sd_orgs as a", "a.id", "b.agency_id")
	.select([
		"b.code",
		"b.status",
		"b.pickup_at",
		"b.pax",
		"b.flight_no",
		"b.contact_name",
		"b.contact_phone",
		"b.price_minor",
		"b.payment_status",
		"b.source",
		"f.name as from_name",
		"t.name as to_name",
		"c.name as class_name",
		"d.name as driver_name",
		"o.name as company_name",
		"a.name as agency_name",
	]);
if (company) {
	// A company's bookings, whatever the dates (from the company accounts page).
	query = query.where("b.org_id", "=", company);
} else if (agencyFilter) {
	query = query.where("b.agency_id", "=", agencyFilter);
} else if (q) {
	const like = `%${q}%`;
	query = query.where((eb) => eb.or([eb("b.code", "like", like), eb("b.contact_name", "like", like), eb("b.contact_phone", "like", like)]));
} else {
	query = query.where("b.pickup_at", ">=", istanbulToIso(from, "00:00")!).where("b.pickup_at", "<", istanbulToIso(addDays(to, 1), "00:00")!);
}
if (status) query = query.where("b.status", "=", status);
if (unassigned) query = query.where("b.driver_id", "is", null).where("b.status", "in", ["confirmed", "pending_payment"]);
const rows = await query.orderBy("b.pickup_at").limit(300).execute();

const shortDate = (date: string) => new Intl.DateTimeFormat("tr-TR", { day: "numeric", month: "short", weekday: "short", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
const range = from === to ? shortDate(from) : `${shortDate(from)} – ${shortDate(to)}`;
const summary = `${rows.length} rezervasyon · ${company || agencyFilter ? "tüm tarihler" : q ? `"${q}" araması` : range}`;
const tomorrow = addDays(todayLocal, 1);
const filtered = !!(q || status || company || agencyFilter);
const quick = [
	{ label: "Bugün", href: `?from=${todayLocal}&to=${todayLocal}`, on: !filtered && !unassigned && from === todayLocal && to === todayLocal },
	{ label: "Yarın", href: `?from=${tomorrow}&to=${tomorrow}`, on: !filtered && !unassigned && from === tomorrow && to === tomorrow },
	{ label: "7 gün", href: "?", on: !filtered && !unassigned && from === todayLocal && to === addDays(todayLocal, 7) },
	{ label: "Sürücü bekleyen", href: `?from=${todayLocal}&to=${addDays(todayLocal, 7)}&unassigned=1`, on: !filtered && unassigned },
];
const tone = (s: BookingStatus) =>
	s === "completed" ? "ok" : s === "cancelled" || s === "no_show" ? "off" : s === "quoted" || s === "pending_payment" ? "warn" : ["driver_en_route", "driver_arrived", "on_board"].includes(s) ? "info" : "";
---

<OpsLayout title="Rezervasyonlar" user={user} subtitle={summary}>
	{
		can(user, "bookings.write") && (
			<a slot="actions" class="btn" href="/ops/rezervasyonlar/yeni">
				<Icon name="plus" size={16} /> Telefonla rezervasyon
			</a>
		)
	}
	<nav class="chips" aria-label="Hızlı filtre">
		{quick.map((c) => (
			<a href={c.href} aria-current={c.on ? "true" : undefined}>
				{c.label}
			</a>
		))}
	</nav>
	<form class="card filters" method="get">
		<label>
			Alış tarihi
			<input type="date" name="from" value={from} />
		</label>
		<label>
			Bitiş
			<input type="date" name="to" value={to} />
		</label>
		<label>
			Durum
			<select name="status">
				<option value="">Hepsi</option>
				{BOOKING_STATUSES.map((s) => <option value={s} selected={s === status}>{STATUS_LABELS[s]}</option>)}
			</select>
		</label>
		<label class="grow">
			Ara
			<input type="search" name="q" value={q} placeholder="No, ad veya telefon" />
		</label>
		<label class="check">
			<input type="checkbox" name="unassigned" value="1" checked={unassigned} /> Sadece atanmamış
		</label>
		<button class="btn secondary" type="submit">Filtrele</button>
	</form>

	<div class="table-wrap">
		<table class="data stack">
			<thead>
				<tr>
					<th>No</th>
					<th>Alış</th>
					<th>Güzergâh</th>
					<th>Yolcu</th>
					<th>Sürücü</th>
					<th>Durum</th>
					<th class="num">Tutar</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((r) => {
						const at = isoToIstanbul(r.pickup_at);
						return (
							<tr>
								<td class="nowrap">
									<a class="code" href={`/ops/rezervasyonlar/${r.code}`}>
										{r.code}
									</a>
									{r.source === "ops" && <span class="tag">tel</span>}
								</td>
								<td class="nowrap" data-label="Alış">
									<strong>{at.time}</strong> <span class="muted">{shortDate(at.date)}</span>
									{r.flight_no && <div class="sub">{r.flight_no}</div>}
								</td>
								<td data-label="Güzergâh">
									<div>
										{r.from_name} → {r.to_name}
									</div>
									<div class="sub">
										{r.class_name} · {r.pax} kişi
									</div>
								</td>
								<td data-label="Yolcu">
									<div>
										{r.contact_name}
										{r.company_name && <span class="badge info">{r.company_name}</span>}
										{r.agency_name && <span class="badge info">{r.agency_name}</span>}
									</div>
									<div class="sub nowrap">{r.contact_phone}</div>
								</td>
								<td data-label="Sürücü">{r.driver_name ?? <span class="badge off">Atanmadı</span>}</td>
								<td data-label="Durum">
									<span class:list={["badge", tone(r.status as BookingStatus)]}>{STATUS_LABELS[r.status as BookingStatus] ?? r.status}</span>
								</td>
								<td class="num" data-label="Tutar">
									<strong>{formatMoney(r.price_minor)} ₺</strong>
									<div class:list={["sub", r.payment_status === "paid" && "paid"]}>{PAYMENT_STATUS_LABELS[r.payment_status] ?? r.payment_status}</div>
								</td>
							</tr>
						);
					})
				}
				{
					rows.length === 0 && (
						<tr class="empty">
							<td colspan="7">Bu filtreyle rezervasyon yok.</td>
						</tr>
					)
				}
			</tbody>
		</table>
	</div>
</OpsLayout>

<style>
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 12px;
	}
	.chips a {
		padding: 6px 12px;
		border: 1px solid var(--ops-line);
		border-radius: 999px;
		background: #fff;
		color: var(--ink-800);
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
	}
	.chips a:hover {
		border-color: var(--gray-500);
	}
	.chips a[aria-current] {
		background: var(--navy-900);
		border-color: var(--navy-900);
		color: #fff;
	}
	.filters {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 12px;
		padding: 16px;
	}
	.filters label {
		flex: 0 1 170px;
		min-width: 0;
	}
	.filters :is(input:not([type="checkbox"]), select) {
		width: 100%;
	}
	.filters label.grow {
		flex: 1 1 220px;
	}
	.filters label.check {
		flex: 0 0 auto;
		min-height: 38px;
	}
	.code {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		text-decoration: none;
	}
	.tag {
		margin-left: 6px;
		padding: 1px 6px;
		border-radius: 6px;
		background: var(--gray-100);
		color: var(--gray-600);
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
	}
	.sub {
		margin-top: 2px;
		color: var(--gray-500);
		font-size: 13px;
	}
	.sub.paid {
		color: #067647;
	}
	td .badge {
		margin-left: 4px;
	}
	td[data-label="Sürücü"] .badge,
	td[data-label="Durum"] .badge {
		margin-left: 0;
	}
	td[data-label="Güzergâh"] {
		min-width: 220px;
	}
	.empty td {
		padding: 32px 12px;
		text-align: center;
		color: var(--gray-600);
	}
	/* Phones: each booking becomes a card instead of a sideways-scrolling row. */
	@media (max-width: 720px) {
		.filters {
			gap: 10px;
			padding: 14px;
		}
		.filters label,
		.filters label.grow {
			flex: 1 1 calc(50% - 5px);
		}
		.filters label.check {
			flex: 1 1 auto;
		}
		.filters .btn {
			flex: 0 0 auto;
		}
		table.stack thead {
			display: none;
		}
		table.stack,
		table.stack tbody,
		table.stack tr,
		table.stack td {
			display: block;
		}
		table.stack tr:not(.empty) {
			display: grid;
			grid-template-columns: 1fr auto;
			gap: 6px 12px;
			padding: 14px 16px;
			border-bottom: 1px solid var(--ops-line);
		}
		table.stack tr:last-child {
			border-bottom: 0;
		}
		table.stack td {
			padding: 0;
			border: 0;
		}
		table.stack thead + tbody tr:hover > td {
			background: transparent;
		}
		table.stack td[data-label="Güzergâh"],
		table.stack td[data-label="Yolcu"] {
			grid-column: 1 / -1;
		}
		table.stack td.num {
			grid-column: 2;
			grid-row: 1 / span 2;
			text-align: right;
		}
		table.stack td[data-label="Sürücü"],
		table.stack td[data-label="Durum"] {
			display: inline-block;
		}
		table.stack td[data-label="Sürücü"]::before {
			content: "Sürücü: ";
			color: var(--gray-500);
			font-size: 13px;
		}
	}
</style>
