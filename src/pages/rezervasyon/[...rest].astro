---
/** Online booking in Turkish: /rezervasyon and /rezervasyon/<code>. Other languages: src/pages/[lang]/rezervasyon. */
import { runBookPage } from "../../lib/booking-page";
import BookView from "../../views/BookView.astro";
import ReceiptView from "../../views/ReceiptView.astro";
import NotFoundView from "../../views/NotFoundView.astro";

const result = await runBookPage(Astro, "tr", Astro.params.rest ?? "");
if (result instanceof Response) return result;
if (!result) Astro.response.status = 404;
---

{result ? (result.view === "detail" && result.receipt ? <ReceiptView {...result} /> : <BookView {...result} />) : <NotFoundView locale="tr" />}
