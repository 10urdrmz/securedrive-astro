---
/** What SecureDrive owes this partner: completed jobs and their payouts, by month. */
import OpsLayout from "../../layouts/OpsLayout.astro";
import { formatMoney } from "../../server/ops";
import { partnerEarnings, requirePartner } from "../../server/partners";
import { isoToIstanbul } from "../../server/pricing";

const ctx = await requirePartner(Astro);
if (ctx instanceof Response) return ctx;
const { db, user, org } = ctx;

const { rows, months } = await partnerEarnings(db, org.id);
const monthName = (month: string) => new Intl.DateTimeFormat("tr-TR", { month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(`${month}-01T00:00:00Z`));
const total = months.reduce((sum, m) => sum + m.total, 0);
---

<OpsLayout title="Hakediş" user={user} panel="partner">
	<p class="muted">Tamamlanan işleriniz ve her biri için SecureDrive'dan alacağınız tutar. Ödemeler ve faturalama SecureDrive finans ekibiyle yapılır.</p>
	<div class="card">
		<table class="data">
			<thead>
				<tr><th>Ay</th><th>İş</th><th>Tutar</th></tr>
			</thead>
			<tbody>
				{months.map((m) => <tr><td>{monthName(m.month)}</td><td>{m.count}</td><td><strong>{formatMoney(m.total)} ₺</strong></td></tr>)}
				{months.length === 0 && <tr><td colspan="3" class="muted">Henüz tamamlanan iş yok.</td></tr>}
				{months.length > 1 && <tr><th>Toplam</th><th>{rows.length}</th><th>{formatMoney(total)} ₺</th></tr>}
			</tbody>
		</table>
	</div>
	{
		rows.length > 0 && (
			<div class="card">
				<h2 style="margin-top:0">Tamamlanan işler</h2>
				<table class="data">
					<thead>
						<tr><th>Tarih</th><th>İş</th><th>Güzergâh</th><th>Sürücü</th><th>Tutar</th></tr>
					</thead>
					<tbody>
						{rows.map((r) => {
							const { date, time } = isoToIstanbul(r.pickup_at);
							return (
								<tr>
									<td>{date} {time}</td>
									<td>{r.code}</td>
									<td>{r.from_name} → {r.to_name}</td>
									<td>{r.driver_name ?? "—"}</td>
									<td>{formatMoney(r.payout_minor)} ₺</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>
		)
	}
</OpsLayout>
